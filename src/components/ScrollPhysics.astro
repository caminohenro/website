<!-- STEP17_MOBILE_SCROLL_PHYSICS_START -->
<script is:inline>
(function mobileScrollPhysics() {
  'use strict';

  const key = '__step17MobileScrollPhysics';

  if (typeof window[key] === 'function') window[key]();

  const lifetime = new AbortController();
  const mobile = window.matchMedia('(max-width: 680px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let cleanupCurrent = null;

  function initialize() {
    if (cleanupCurrent) cleanupCurrent();
    cleanupCurrent = null;

    if (!mobile.matches || window.innerWidth > 680) return;

    const stage = document.querySelector(
      'body > .scroll-stage[data-mobile-physics="true"]'
    );
    if (!stage) return;

    const startsClosed = stage.dataset.mobileStartClosed === 'true';

    const paper = stage.querySelector(':scope > main.washi-scroll');
    const roller = stage.querySelector(':scope > .scroll-roller-bottom');
    const topRoller = stage.querySelector(':scope > .scroll-roller-top');

    if (!paper || !roller || !topRoller) return;

    const controller = new AbortController();
    const signal = controller.signal;
    const html = document.documentElement;

    const styleSnapshots = new Map();
    const attributeSnapshots = new Map();

    function setStyle(element, property, value) {
      if (!styleSnapshots.has(element)) {
        styleSnapshots.set(element, new Map());
      }

      const properties = styleSnapshots.get(element);

      if (!properties.has(property)) {
        properties.set(property, {
          value: element.style.getPropertyValue(property),
          priority: element.style.getPropertyPriority(property),
        });
      }

      element.style.setProperty(property, value);
    }

    function setAttribute(element, name, value) {
      if (!attributeSnapshots.has(element)) {
        attributeSnapshots.set(element, new Map());
      }

      const attributes = attributeSnapshots.get(element);

      if (!attributes.has(name)) {
        attributes.set(name, element.getAttribute(name));
      }

      if (value === null) element.removeAttribute(name);
      else element.setAttribute(name, value);
    }

    const hint = document.createElement('div');
    hint.className = 'step17-unfurl-tooltip';
    hint.setAttribute('aria-hidden', 'true');

    const arrow = document.createElement('span');
    arrow.className = 'step17-unfurl-arrow';
    arrow.textContent = '\u2193';

    const label = document.createElement('span');
    label.textContent = 'Drag to unfurl';

    hint.append(arrow, label);
    stage.appendChild(hint);

    const FAILSAFE_MIN_DRAG_PX = 60;

    const openAllBtn = document.createElement('button');
    openAllBtn.type = 'button';
    openAllBtn.className = 'step17-open-all-btn';
    openAllBtn.textContent = 'Open all';
    stage.appendChild(openAllBtn);

    let openAllTimer = 0;
    let peekOffset = 0;
    let peekTimer = 0;
    let peekFrame = 0;

    let disposed = false;
    let height = 0;
    let revealed = 0;
    let paperTop = 0;
    let bottomHeight = 0;
    let stagePaddingBottom = 0;
    let dragging = false;
    let touchId = null;
    let lastClientY = 0;
    let lastDocumentY = 0;
    let lastInputTime = 0;
    let samples = [];
    let velocity = 0;
    let frameId = 0;
    let measurementId = 0;
    let hintTimer = 0;
    let previousFrameTime = 0;
    let gestureMoved = false;
    let fullyOpen = false;
    let initialHeaderHidden = startsClosed;
    let opening = null;
    let headerScrollAnchor = window.scrollY;

    // STEP17_FAST_RELEASE_AND_STABLE_BACKDROP_V1

    function clamp(value, minimum, maximum) {
      return Math.max(minimum, Math.min(maximum, value));
    }

    function viewport() {
      const visual = window.visualViewport;

      return {
        top: visual ? visual.offsetTop : 0,
        height: visual ? visual.height : window.innerHeight,
      };
    }

    // ========================================================================
    // MOBILE SNEAK PEEK / BOUNCE ANIMATION
    // ========================================================================

    function stopSneakPeek() {
      window.clearTimeout(peekTimer);
      window.cancelAnimationFrame(peekFrame);

      peekTimer = 0;
      peekFrame = 0;

      if (peekOffset !== 0) {
        peekOffset = 0;
        render();
      }
    }

    function scheduleSneakPeek(isFirstCycle) {
      const cfg = window.SCROLL_SNEAK_PEEK_CONFIG;

      if (!cfg || !cfg.enabled || reducedMotion.matches) return;
      if (peekTimer || peekFrame || disposed) return;

      if (
        revealed > 0.01 ||
        dragging ||
        opening ||
        mobilePositionFrame ||
        topCloseFrame
      ) return;

      const delay = isFirstCycle
        ? cfg.initialDelayMs
        : Math.max(200, cfg.cyclePeriodMs - cfg.bounceDurationMs);

      peekTimer = window.setTimeout(function () {
        peekTimer = 0;

        if (
          disposed ||
          revealed > 0.01 ||
          dragging ||
          opening ||
          mobilePositionFrame ||
          topCloseFrame
        ) return;

        const start = performance.now();
        const dur = cfg.bounceDurationMs;
        const amp = cfg.mobileDistancePx;

        function stepPeek(now) {
          if (
            disposed ||
            revealed > 0.01 ||
            dragging ||
            opening ||
            mobilePositionFrame ||
            topCloseFrame
          ) {
            stopSneakPeek();
            return;
          }

          const t = Math.min(1, (now - start) / dur);

          // Smooth yo-yo down and back up once: sin(pi * t).
          peekOffset = amp * Math.sin(Math.PI * t);

          render();

          if (t < 1) {
            peekFrame = window.requestAnimationFrame(stepPeek);
          } else {
            peekOffset = 0;
            peekFrame = 0;
            render();
            scheduleSneakPeek(false);
          }
        }

        peekFrame = window.requestAnimationFrame(stepPeek);
      }, delay);
    }

    // ========================================================================
    // HINTS AND OPEN-ALL CONTROL
    // ========================================================================

    function dismissHint() {
      window.clearTimeout(hintTimer);
      window.clearTimeout(openAllTimer);

      hintTimer = 0;
      openAllTimer = 0;

      hint.classList.remove('is-visible');
      openAllBtn.classList.remove('is-visible');
    }

    function updateHint() {
      const isMoving =
        dragging ||
        Boolean(opening) ||
        Math.abs(velocity) >= 0.012 ||
        Boolean(mobilePositionFrame) ||
        Boolean(topCloseFrame);

      if (isMoving || fullyOpen) {
        dismissHint();
        stopSneakPeek();
        return;
      }

      if (
        revealed <= 0.01 &&
        !mobileCentered &&
        (startsClosed || mobileHasInteracted)
      ) {
        centerClosedMobile();
        return;
      }

      // Failsafe "Open all" button when dragged down >= 60px and stopped.
      if (revealed >= FAILSAFE_MIN_DRAG_PX && !fullyOpen) {
        window.clearTimeout(hintTimer);
        hintTimer = 0;

        hint.classList.remove('is-visible');
        stopSneakPeek();

        if (
          !openAllTimer &&
          !openAllBtn.classList.contains('is-visible')
        ) {
          openAllTimer = window.setTimeout(function () {
            openAllTimer = 0;

            if (
              !disposed &&
              !dragging &&
              !opening &&
              Math.abs(velocity) < 0.012 &&
              revealed >= FAILSAFE_MIN_DRAG_PX &&
              !fullyOpen
            ) {
              openAllBtn.classList.add('is-visible');
            }
          }, 250);
        }

        return;
      }

      openAllBtn.classList.remove('is-visible');

      window.clearTimeout(openAllTimer);
      openAllTimer = 0;

      if (revealed > 0) {
        dismissHint();
        stopSneakPeek();
        return;
      }

      scheduleSneakPeek(true);

      if (hintTimer || hint.classList.contains('is-visible')) return;

      hintTimer = window.setTimeout(function () {
        hintTimer = 0;

        if (!disposed && revealed === 0 && !dragging) {
          hint.classList.add('is-visible');
        }
      }, 1000);
    }

    // ========================================================================
    // HEADER
    // ========================================================================

    function releaseInitialHeader() {
      if (!initialHeaderHidden) return;

      initialHeaderHidden = false;
      setAttribute(html, 'data-step17-header-hidden', null);
    }

    // ========================================================================
    // RENDERING
    // ========================================================================

    function render() {
      revealed = clamp(revealed, 0, height);

      // The sneak peek is a visual-only offset.
      // It does not modify the actual revealed paper height.
      const visualRevealed = clamp(revealed + peekOffset, 0, height);

      const hidden = Math.max(0, height - visualRevealed);

      fullyOpen = (height - revealed) < 0.01;

      setAttribute(
        stage,
        'data-step17-open',
        fullyOpen ? 'true' : 'false'
      );

      if (fullyOpen) {
        revealed = height;

        setStyle(paper, 'clip-path', 'none');
        setStyle(paper, '-webkit-clip-path', 'none');
      } else {
        const clip =
          'inset(0 -90px ' + hidden.toFixed(3) + 'px -90px)';

        setStyle(paper, 'clip-path', clip);
        setStyle(paper, '-webkit-clip-path', clip);
      }

      setStyle(
        roller,
        'transform',
        'translateY(' + (-hidden).toFixed(3) + 'px)'
      );

      const visibleStageHeight =
        paperTop + visualRevealed + bottomHeight + stagePaddingBottom;

      setStyle(
        stage,
        '--step17-stage-height',
        visibleStageHeight.toFixed(3) + 'px'
      );

      const controlTop =
        (
          paperTop +
          visualRevealed +
          bottomHeight +
          15
        ).toFixed(3) + 'px';

      hint.style.top = controlTop;
      openAllBtn.style.top = controlTop;

      setAttribute(
        roller,
        'aria-label',
        fullyOpen
          ? 'Scroll roller. Drag up to furl the page.'
          : 'Scroll roller. Drag down to unfurl or up to furl.'
      );

      setAttribute(
        topRoller,
        'aria-label',
        revealed <= 0.01
          ? 'Open the scroll'
          : 'Close the scroll'
      );

      setAttribute(
        topRoller,
        'aria-expanded',
        revealed <= 0.01 ? 'false' : 'true'
      );

      updateHint();
    }

    // ========================================================================
    // MEASUREMENT
    // ========================================================================

    function measure(first) {
      if (disposed) return;

      const previouslyOpen = fullyOpen;
      const previousHeight = height;

      height = paper.getBoundingClientRect().height;

      // A height change must not cancel an opening animation that is designed
      // to follow the paper's changing height.
      //
      // Only cancel a non-automatic animation that does not follow height.
      if (
        opening &&
        !opening.automatic &&
        !opening.followHeight &&
        Math.abs(previousHeight - height) > 0.5
      ) {
        opening = null;
        velocity = 0;
        stopFrame();
      }

      paperTop = paper.offsetTop;
      bottomHeight = roller.offsetHeight;

      stagePaddingBottom =
        parseFloat(window.getComputedStyle(stage).paddingBottom) || 112;

      if (first) {
        // Exactly closed: the entire paper is initially clipped away.
        revealed = 0;
      } else if (previouslyOpen && !dragging && !opening) {
        // Loaded replies and other dynamic content remain fully readable.
        revealed = height;
      } else {
        // Preserve the exposed length while the Forum changes underneath.
        revealed = clamp(revealed, 0, height);
      }

      if (dragging && Math.abs(previousHeight - height) > 0.5) {
        lastDocumentY = lastClientY + window.scrollY;

        samples = [{
          y: lastClientY,
          time: performance.now(),
        }];
      }

      render();
    }

    function scheduleMeasurement() {
      if (disposed || measurementId) return;

      measurementId = window.requestAnimationFrame(function () {
        measurementId = 0;
        measure(false);
      });
    }

    // ========================================================================
    // ANIMATION FRAME CONTROL
    // ========================================================================

    function stopFrame() {
      window.cancelAnimationFrame(frameId);
      frameId = 0;
    }

    function findTouch(list) {
      for (let index = 0; index < list.length; index += 1) {
        if (list[index].identifier === touchId) return list[index];
      }

      return null;
    }

    // ========================================================================
    // VELOCITY
    // ========================================================================

    function recordVelocity(clientY, now) {
      samples.push({
        y: clientY,
        time: now,
      });

      while (
        samples.length > 2 &&
        samples[0].time < now - 90
      ) {
        samples.shift();
      }

      const first = samples[0];
      const elapsed = now - first.time;

      // CSS pixels per millisecond. Positive means dragging downward.
      velocity = elapsed > 0
        ? (clientY - first.y) / elapsed
        : 0;
    }

    // ========================================================================
    // EDGE AUTO-SCROLL DURING DRAG
    // ========================================================================

    function scrollDuringDrag(elapsed) {
      if (!dragging) return;

      const view = viewport();
      const edgeZone = Math.min(90, view.height * 0.15);

      const upperEdge = view.top + edgeZone;
      const lowerEdge = view.top + view.height - edgeZone;

      let speed = 0;

      if (lastClientY > lowerEdge && revealed < height) {
        speed =
          clamp((lastClientY - lowerEdge) / edgeZone, 0, 1) * 0.65;
      } else if (lastClientY < upperEdge && revealed > 0) {
        speed =
          -clamp((upperEdge - lastClientY) / edgeZone, 0, 1) * 0.65;
      }

      if (speed === 0) return;

      const previousScroll = window.scrollY;

      window.scrollTo({
        top: previousScroll + speed * elapsed,
        behavior: 'instant',
      });

      const actualScroll = window.scrollY - previousScroll;

      if (actualScroll !== 0) {
        // Auto-scrolling moves the document under a stationary finger.
        // Add the actual scroll distance to keep the roller under it.
        revealed = clamp(revealed + actualScroll, 0, height);
        lastDocumentY += actualScroll;

        render();
      }
    }

    // ========================================================================
    // RESTORED MOBILE-SPECIFIC OPENING SETTINGS
    // ========================================================================

    function mobileOpeningSettings() {
      const styles = window.getComputedStyle(paper);

      function number(name, fallback) {
        const value = Number.parseFloat(
          styles.getPropertyValue(name)
        );

        return Number.isFinite(value) && value > 0
          ? value
          : fallback;
      }

      return {
        // Paper opening speed in pixels per millisecond.
        speed: number('--mobile-unfurl-speed', 900) / 1000,

        // Minimum finger-release speed in pixels per millisecond.
        threshold: number('--mobile-release-threshold', 350) / 1000,

        // Maximum initial release speed in pixels per millisecond.
        releaseCap: number('--mobile-release-speed-cap', 900) / 1000,

        // Minimum automatic opening duration in milliseconds.
        minimum: number('--mobile-unfurl-min-duration', 1200),
      };
    }

    function mobileOpeningDuration(distance, settings) {
      return Math.max(
        settings.minimum,
        distance / settings.speed
      );
    }

    // ========================================================================
    // BEZIER CURVES
    // ========================================================================

    function bezierCoordinate(parameter, first, second) {
      const inverse = 1 - parameter;

      return (
        3 * inverse * inverse * parameter * first +
        3 * inverse * parameter * parameter * second +
        parameter * parameter * parameter
      );
    }

    function originalOpeningProgress(timeProgress, points) {
      if (timeProgress <= 0) return 0;
      if (timeProgress >= 1) return 1;

      // Invert the curve's x coordinate before evaluating its y coordinate.
      // Evaluating y directly at timeProgress would change the CSS easing.
      let low = 0;
      let high = 1;

      for (let index = 0; index < 30; index += 1) {
        const middle = (low + high) / 2;

        const x = bezierCoordinate(
          middle,
          points[0],
          points[2]
        );

        if (x < timeProgress) low = middle;
        else high = middle;
      }

      return bezierCoordinate(
        (low + high) / 2,
        points[1],
        points[3]
      );
    }

    // ========================================================================
    // RESTORED VELOCITY-SENSITIVE FLICK OPENING
    // ========================================================================

    function beginOriginalOpening(releaseSpeed) {
      const remaining = Math.max(0, height - revealed);
      const settings = mobileOpeningSettings();

      if (
        reducedMotion.matches ||
        remaining <= 0 ||
        releaseSpeed < settings.threshold
      ) {
        return false;
      }

      const duration = mobileOpeningDuration(
        remaining,
        settings
      );

      const initialSpeed = Math.min(
        releaseSpeed,
        settings.releaseCap
      );

      // Set the curve's initial slope from the release speed.
      // Restrict its control point to keep progress monotonic.
      const firstY = clamp(
        initialSpeed * duration / remaining * 0.33,
        0,
        1
      );

      opening = {
        followHeight: true,
        startedAt: performance.now(),
        start: revealed,
        remaining,
        duration,
        points: [0.33, firstY, 0.67, 1],
      };

      velocity = 0;

      beginFrame();

      return true;
    }

    // ========================================================================
    // MAIN ANIMATION LOOP
    // ========================================================================

    function tick(now) {
      if (disposed) return;

      frameId = 0;

      const elapsed = clamp(
        now - previousFrameTime,
        0,
        32
      );

      previousFrameTime = now;

      if (opening) {
        const progress = clamp(
          (now - opening.startedAt) / opening.duration,
          0,
          1
        );

        // Automatic and flick-release openings follow changes in the
        // paper's natural height while their animation is in progress.
        const openingDistance = opening.followHeight
          ? Math.max(0, height - opening.start)
          : opening.remaining;

        revealed = clamp(
          opening.start +
            openingDistance *
            originalOpeningProgress(progress, opening.points),
          0,
          height
        );

        if (progress >= 1) {
          revealed = height;
          opening = null;
          velocity = 0;

          render();

          return;
        }

        render();

        frameId = window.requestAnimationFrame(tick);

        return;
      }

      if (dragging) {
        scrollDuringDrag(elapsed);

        frameId = window.requestAnimationFrame(tick);

        return;
      }

      if (Math.abs(velocity) < 0.012) {
        velocity = 0;
        updateHint();
        return;
      }

      // Pure inertial motion with exponential friction:
      //
      // v(t + dt) = v(t) * exp(-friction * dt)
      // dx = v(t) * (1 - exp(-friction * dt)) / friction
      //
      // There is no spring and no endpoint chosen from swipe direction.
      // Small movements stop nearby; stronger flicks coast farther.
      const friction = 0.0045;

      const decay = Math.exp(-friction * elapsed);

      const displacement =
        velocity * (1 - decay) / friction;

      const proposed = revealed + displacement;

      revealed = clamp(proposed, 0, height);
      velocity *= decay;

      if (proposed <= 0 || proposed >= height) {
        velocity = 0;
      }

      render();

      if (Math.abs(velocity) >= 0.012) {
        frameId = window.requestAnimationFrame(tick);
      } else {
        velocity = 0;
        updateHint();
      }
    }

    function beginFrame() {
      stopFrame();

      previousFrameTime = performance.now();

      frameId = window.requestAnimationFrame(tick);
    }

    // ========================================================================
    // TOUCH INTERACTION
    // ========================================================================

    function onTouchStart(event) {
      if (event.touches.length !== 1) return;

      stopFrame();
      stopSneakPeek();

      opening = null;

      const touch = event.touches[0];
      const now = performance.now();

      dragging = true;

      returnMobileToTop();
      dismissHint();

      touchId = touch.identifier;
      lastClientY = touch.clientY;
      lastDocumentY = touch.clientY + window.scrollY;
      lastInputTime = now;
      gestureMoved = false;
      velocity = 0;

      samples = [{
        y: touch.clientY,
        time: now,
      }];

      beginFrame();
    }

    function onTouchMove(event) {
      if (!dragging) return;

      if (event.touches.length !== 1) {
        onTouchCancel();
        return;
      }

      const touch = findTouch(event.touches);

      if (!touch) return;

      if (!event.cancelable) {
        onTouchCancel();
        return;
      }

      event.preventDefault();

      const now = performance.now();

      const documentY = touch.clientY + window.scrollY;
      const displacement = documentY - lastDocumentY;

      if (Math.abs(displacement) > 0) {
        gestureMoved = true;
        dismissHint();
      }

      // A one-pixel finger movement exposes or hides one pixel of paper.
      // The same formula works at 0%, 100%, and every point in between.
      revealed = clamp(
        revealed + displacement,
        0,
        height
      );

      lastDocumentY = documentY;
      lastClientY = touch.clientY;
      lastInputTime = now;

      recordVelocity(touch.clientY, now);

      render();
    }

    function onTouchEnd(event) {
      if (!dragging) return;

      const touch = findTouch(event.changedTouches);

      if (!touch) return;

      const now = performance.now();

      dragging = false;

      updateHint();

      touchId = null;

      stopFrame();

      if (!gestureMoved || now - lastInputTime > 100) {
        velocity = 0;
      }

      // Reduced motion preserves direct manipulation but omits coasting.
      if (reducedMotion.matches) velocity = 0;

      if (velocity > 0 && beginOriginalOpening(velocity)) return;

      if (Math.abs(velocity) >= 0.012) {
        beginFrame();
      }
    }

    function onTouchCancel() {
      opening = null;
      dragging = false;
      touchId = null;
      velocity = 0;

      stopFrame();

      updateHint();
    }

    // ========================================================================
    // KEYBOARD ACCESSIBILITY
    // ========================================================================

    function onKeyDown(event) {
      const increment = Math.max(
        40,
        viewport().height * 0.15
      );

      let next = revealed;

      if (event.key === 'ArrowDown') next += increment;
      else if (event.key === 'ArrowUp') next -= increment;
      else if (event.key === 'PageDown') next += viewport().height * 0.8;
      else if (event.key === 'PageUp') next -= viewport().height * 0.8;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = height;
      else if (event.key === 'Enter' || event.key === ' ') {
        next = fullyOpen ? 0 : height;
      } else {
        return;
      }

      event.preventDefault();

      onTouchCancel();
      dismissHint();

      revealed = clamp(next, 0, height);

      render();
    }

    function onFocusIn(event) {
      if (!paper.contains(event.target) || fullyOpen) return;

      // Keyboard navigation must not focus invisible clipped controls.
      onTouchCancel();
      dismissHint();

      revealed = height;

      render();
    }

    function onVisibilityChange() {
      if (document.hidden) onTouchCancel();
    }

    // ========================================================================
    // NATIVE SCROLL / HEADER MANAGEMENT
    // ========================================================================

    function onNativeScroll() {
      const currentY = window.scrollY;

      // Roller manipulation, its edge auto-scroll, and the completion
      // animation must not expose the header.
      if (dragging) {
        headerScrollAnchor = currentY;
        return;
      }

      if (currentY >= headerScrollAnchor) {
        headerScrollAnchor = currentY;
        return;
      }

      // Accumulate a small upward movement instead of depending on an
      // individual scroll event being larger than a pixel.
      if (headerScrollAnchor - currentY >= 3) {
        releaseInitialHeader();

        // Hand subsequent behavior back to the existing header logic.
        const header = document.querySelector('header.site-header');

        if (header) {
          header.classList.remove('is-hidden');
        }

        headerScrollAnchor = currentY;
      }
    }

    // ========================================================================
    // INITIALIZE CONTROLS
    // ========================================================================

    setAttribute(stage, 'data-step17-physics', 'true');

    if (startsClosed) {
      setAttribute(html, 'data-step17-header-hidden', 'true');
    }

    setAttribute(roller, 'role', 'button');
    setAttribute(roller, 'tabindex', '0');

    roller.addEventListener('touchstart', onTouchStart, {
      passive: true,
      signal,
    });

    roller.addEventListener('touchmove', onTouchMove, {
      passive: false,
      signal,
    });

    roller.addEventListener('touchend', onTouchEnd, {
      passive: true,
      signal,
    });

    roller.addEventListener('touchcancel', onTouchCancel, {
      passive: true,
      signal,
    });

    // SCROLL_CLOSE_NEWSLETTER_V1

    // REPEAT_SCROLL_ENTRANCE_V1

    let mobilePositionFrame = 0;
    let mobileOffset = 0;
    let mobileCentered = false;
    let mobileHasInteracted = false;

    function moveMobilePosition(target, finished) {
      window.cancelAnimationFrame(mobilePositionFrame);

      dismissHint();

      const from = mobileOffset;
      const startedAt = performance.now();
      const duration = reducedMotion.matches ? 0 : 1000;

      function step(now) {
        if (disposed) return;

        const progress = duration
          ? Math.min(1, (now - startedAt) / duration)
          : 1;

        const eased = 1 - Math.pow(1 - progress, 3);

        const previousOffset = mobileOffset;

        mobileOffset = from + (target - from) * eased;

        setStyle(
          stage,
          'translate',
          '0px ' + mobileOffset + 'px'
        );

        // Keep the roller under the finger while the stage moves upward.
        if (dragging) {
          revealed = clamp(
            revealed + previousOffset - mobileOffset,
            0,
            height
          );

          render();
        }

        if (progress < 1) {
          mobilePositionFrame =
            window.requestAnimationFrame(step);
        } else {
          mobilePositionFrame = 0;

          if (finished) finished();
        }
      }

      mobilePositionFrame =
        window.requestAnimationFrame(step);
    }

    function centerClosedMobile() {
      if (
        mobileCentered ||
        dragging ||
        opening ||
        revealed > 0.01
      ) return;

      mobileCentered = true;

      window.scrollTo({
        top: 0,
        behavior: 'instant',
      });

      const rollerCenter =
        (
          topRoller.getBoundingClientRect().top +
          roller.getBoundingClientRect().bottom
        ) / 2 + window.scrollY - mobileOffset;

      const view = viewport();

      const target = Math.max(
        0,
        view.top + view.height / 2 - rollerCenter
      );

      moveMobilePosition(target, updateHint);
    }

    function returnMobileToTop() {
      mobileHasInteracted = true;

      if (!mobileCentered && mobileOffset === 0) return;

      mobileCentered = false;

      moveMobilePosition(0, updateHint);
    }

    // ========================================================================
    // TOP ROLLER CLOSE ANIMATION
    // ========================================================================

    let topCloseFrame = 0;

    function cancelTopClose() {
      window.cancelAnimationFrame(topCloseFrame);
      topCloseFrame = 0;
    }

    // ========================================================================
    // RESTORED SMOOTH OPENING FOR TOP ROLLER AND OPEN-ALL BUTTON
    // ========================================================================

    function openSmoothlyFromCurrent() {
      if (disposed || fullyOpen) return;

      stopSneakPeek();
      dismissHint();

      onTouchCancel();
      cancelTopClose();

      returnMobileToTop();

      if (reducedMotion.matches) {
        revealed = height;
        render();
        return;
      }

      const remaining = Math.max(0, height - revealed);

      if (remaining <= 0.01) return;

      const settings = mobileOpeningSettings();

      opening = {
        automatic: true,
        followHeight: true,
        startedAt: performance.now(),
        start: revealed,
        remaining,
        duration: mobileOpeningDuration(remaining, settings),

        // Restore the original gradual mobile ease-in-out.
        points: [0.42, 0, 0.58, 1],
      };

      velocity = 0;

      beginFrame();
    }

    openAllBtn.addEventListener('click', function (event) {
      event.preventDefault();
      openSmoothlyFromCurrent();
    }, { signal });

    function closeFromTop(event) {
      if (
        event.type === 'keydown' &&
        event.key !== 'Enter' &&
        event.key !== ' '
      ) return;

      if (revealed <= 0.01 && !opening) {
        event.preventDefault();
        openSmoothlyFromCurrent();
        return;
      }

      event.preventDefault();

      stopSneakPeek();
      dismissHint();

      onTouchCancel();
      cancelTopClose();

      window.beginNewsletterCloseHold?.();

      const start = revealed;
      const startedAt = performance.now();
      const duration = reducedMotion.matches ? 0 : 900;

      function closeStep(now) {
        if (disposed) return;

        const progress = duration
          ? Math.min(1, (now - startedAt) / duration)
          : 1;

        const eased = progress * progress * (3 - 2 * progress);

        const previous = revealed;

        revealed = start * (1 - eased);

        const paperDocumentTop =
          stage.getBoundingClientRect().top +
          window.scrollY +
          paperTop;

        const removed = Math.max(
          0,
          previous - revealed
        );

        const targetY = Math.max(
          0,
          window.scrollY -
            Math.min(
              removed,
              Math.max(0, window.scrollY - paperDocumentTop)
            )
        );

        const previousScrollY = window.scrollY;

        render();

        window.scrollTo({
          top: targetY,
          behavior: 'instant',
        });

        window.stepNewsletterCloseHold?.(
          removed,
          previousScrollY - window.scrollY
        );

        if (progress < 1) {
          topCloseFrame =
            window.requestAnimationFrame(closeStep);
        } else {
          topCloseFrame = 0;

          window.endNewsletterCloseHold?.();

          updateHint();
        }
      }

      topCloseFrame =
        window.requestAnimationFrame(closeStep);
    }

    setAttribute(topRoller, 'role', 'button');
    setAttribute(topRoller, 'tabindex', '0');
    setAttribute(topRoller, 'aria-label', 'Close the scroll');

    topRoller.addEventListener('click', closeFromTop, { signal });
    topRoller.addEventListener('keydown', closeFromTop, { signal });

    // Dragging or using the bottom roller takes over from closing.
    roller.addEventListener('touchstart', cancelTopClose, {
      passive: true,
      signal,
    });

    roller.addEventListener('keydown', cancelTopClose, { signal });

    roller.addEventListener('keydown', onKeyDown, { signal });

    paper.addEventListener('focusin', onFocusIn, { signal });

    // ========================================================================
    // EVENT LISTENERS
    // ========================================================================

    window.addEventListener('resize', scheduleMeasurement, {
      passive: true,
      signal,
    });

    window.addEventListener('scroll', onNativeScroll, {
      passive: true,
      signal,
    });

    document.addEventListener('visibilitychange', onVisibilityChange, {
      signal,
    });

    if (window.visualViewport) {
      window.visualViewport.addEventListener(
        'resize',
        scheduleMeasurement,
        {
          passive: true,
          signal,
        }
      );
    }

    // ========================================================================
    // RESIZE OBSERVER
    // ========================================================================

    // SCROLL_ENTRANCE_FIX_V1:
    // Synchronize clipping and roller position before paint.
    const observer = typeof ResizeObserver === 'function'
      ? new ResizeObserver(function () {
          if (disposed) return;

          window.cancelAnimationFrame(measurementId);
          measurementId = 0;

          measure(false);
        })
      : null;

    if (observer) observer.observe(paper);

    paper.addEventListener('load', scheduleMeasurement, {
      capture: true,
      signal,
    });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () {
        if (!disposed) scheduleMeasurement();
      });
    }

    // ========================================================================
    // ALL_PAGES_MOBILE_DRAG_V1
    // RESTORED AUTOMATIC MOBILE UNFURL
    // ========================================================================

    function beginAutomaticOpening() {
      if (startsClosed) return;

      dismissHint();

      if (reducedMotion.matches) {
        revealed = height;
        render();
        return;
      }

      const settings = mobileOpeningSettings();

      const styles = window.getComputedStyle(paper);
      const rootStyles = window.getComputedStyle(html);

      const delayText =
        styles.getPropertyValue('--unfurl-delay') ||
        rootStyles.getPropertyValue('--unfurl-delay') ||
        '0.9s';

      // Resolve CSS calculations, variables, time and viewport units.
      const probe = document.createElement('div');

      probe.style.cssText =
        'position:fixed;visibility:hidden;pointer-events:none;' +
        'width:0;padding:0;border:0;margin:0;box-sizing:border-box;';

      probe.style.transitionDelay = delayText.trim();
      probe.style.height = '0px';

      paper.appendChild(probe);

      const delayValue =
        window.getComputedStyle(probe).transitionDelay;

      const delay =
        parseFloat(delayValue) *
        (delayValue.endsWith('ms') ? 1 : 1000);

      probe.remove();

      // Restore the original mobile entrance:
      // gradual acceleration, followed by gradual deceleration.
      opening = {
        automatic: true,
        followHeight: true,

        startedAt: performance.now() + (
          Number.isFinite(delay)
            ? Math.max(0, delay)
            : 900
        ),

        start: 0,
        remaining: height,

        duration: mobileOpeningDuration(height, settings),

        points: [0.42, 0, 0.58, 1],
      };

      velocity = 0;

      beginFrame();
    }

    // ========================================================================
    // INITIAL MEASUREMENT AND CONTENT READINESS
    // ========================================================================

    measure(true);

    window.scrollContentReady(paper).then(() => {
      if (disposed || !paper.isConnected) return;

      measure(false);

      stage.removeAttribute('data-scroll-initial-wait');

      beginAutomaticOpening();
    });

    // ========================================================================
    // CLEANUP
    // ========================================================================

    cleanupCurrent = function () {
      disposed = true;

      stopSneakPeek();

      openAllBtn.remove();

      window.cancelAnimationFrame(mobilePositionFrame);

      cancelTopClose();

      controller.abort();

      stopFrame();

      window.cancelAnimationFrame(measurementId);

      window.clearTimeout(hintTimer);
      window.clearTimeout(openAllTimer);

      if (observer) observer.disconnect();

      hint.remove();

      attributeSnapshots.forEach(function (attributes, element) {
        attributes.forEach(function (value, name) {
          if (value === null) {
            element.removeAttribute(name);
          } else {
            element.setAttribute(name, value);
          }
        });
      });

      styleSnapshots.forEach(function (properties, element) {
        properties.forEach(function (saved, property) {
          if (saved.value) {
            element.style.setProperty(
              property,
              saved.value,
              saved.priority
            );
          } else {
            element.style.removeProperty(property);
          }
        });
      });
    };
  }

  function destroy() {
    lifetime.abort();

    if (cleanupCurrent) cleanupCurrent();

    cleanupCurrent = null;
  }

  window[key] = destroy;

  mobile.addEventListener('change', initialize, {
    signal: lifetime.signal,
  });

  document.addEventListener('astro:before-swap', function () {
    if (cleanupCurrent) cleanupCurrent();

    cleanupCurrent = null;
  }, { signal: lifetime.signal });

  document.addEventListener('astro:page-load', initialize, {
    signal: lifetime.signal,
  });

  // The inline script follows the stage markup: close it before first paint.
  initialize();
})();
</script>
