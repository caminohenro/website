<!-- UNIFIED_SCROLL_PHYSICS_V2_START -->
<script is:inline>
(function unifiedScrollPhysics() {
  'use strict';

  const key = '__unifiedScrollPhysicsV2';
  if (typeof window[key] === 'function') window[key]();

  // ==========================================================================
  // SNEAK PEEK ("YO-YO" BOUNCE) CONFIGURATION
  // ==========================================================================
  window.SCROLL_SNEAK_PEEK_CONFIG = {
    enabled: true,
    initialDelayMs: 2200,
    cyclePeriodMs: 4400,
    bounceDurationMs: 1100,
    desktopDistancePx: 38,
    mobileDistancePx: 34,
  };

  // ==========================================================================
  // CONTENT READINESS HELPER (Waits for DOM, [data-scroll-loading], and fonts)
  // ==========================================================================
  window.scrollContentReady = async function (paper) {
    if (document.readyState === 'loading') {
      await new Promise((resolve) =>
        document.addEventListener('DOMContentLoaded', resolve, { once: true })
      );
    }
    if (!paper || !paper.isConnected) return;

    await new Promise((resolve) => {
      const pending = () => paper.querySelector('[data-scroll-loading="true"]');
      if (!pending()) {
        resolve();
        return;
      }
      const observer = new MutationObserver(() => {
        if (!pending() || !paper.isConnected) {
          observer.disconnect();
          document.removeEventListener('astro:before-swap', cancel);
          resolve();
        }
      });
      function cancel() {
        observer.disconnect();
        document.removeEventListener('astro:before-swap', cancel);
        resolve();
      }
      observer.observe(paper, { subtree: true, attributes: true, childList: true });
      document.addEventListener('astro:before-swap', cancel, { once: true });
    });

    if (!paper.isConnected) return;
    void paper.offsetHeight;
    if (document.fonts && document.fonts.ready) {
      await document.fonts.ready;
    }
  };

  const lifetime = new AbortController();
  const mobileQuery = window.matchMedia('(max-width: 680px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let cleanupCurrent = null;

  function isMobile() {
    return mobileQuery.matches || window.innerWidth <= 680;
  }

  function clamp(val, min, max) {
    return Math.max(min, Math.min(max, val));
  }

  function viewport() {
    const visual = window.visualViewport;
    return {
      top: visual ? visual.offsetTop : 0,
      height: visual ? visual.height : window.innerHeight,
    };
  }

  // Cubic-Bezier evaluator for smooth, non-linear curves
  function bezierCoord(t, p1, p2) {
    const inv = 1 - t;
    return 3 * inv * inv * t * p1 + 3 * inv * t * t * p2 + t * t * t;
  }

  function evalBezier(timeProgress, points) {
    if (timeProgress <= 0) return 0;
    if (timeProgress >= 1) return 1;
    let low = 0;
    let high = 1;
    for (let i = 0; i < 24; i += 1) {
      const mid = (low + high) / 2;
      const x = bezierCoord(mid, points[0], points[2]);
      if (x < timeProgress) low = mid;
      else high = mid;
    }
    return bezierCoord((low + high) / 2, points[1], points[3]);
  }

  function initialize() {
    if (cleanupCurrent) cleanupCurrent();
    cleanupCurrent = null;

    const stage = document.querySelector('body > .scroll-stage');
    if (!stage) return;

    const paper = stage.querySelector(':scope > main.washi-scroll');
    const bottomRoller = stage.querySelector(':scope > .scroll-roller-bottom');
    const topRoller = stage.querySelector(':scope > .scroll-roller-top');
    if (!paper || !bottomRoller || !topRoller) return;

    const startsClosed =
      stage.dataset.mobileStartClosed === 'true' ||
      stage.dataset.desktopClickUnfurl === 'true';

    // Detect if there is a Pre-Scroll section above the scroll on this page
    const hasPreScroll = Boolean(
      document.querySelector('.pre-scroll-inquiry-container, [slot="pre-scroll"]')
    );

    const controller = new AbortController();
    const signal = controller.signal;
    const html = document.documentElement;

    // ========================================================================
    // UI HINTS & EXPANDED HITBOX CREATION
    // ========================================================================

    // 1. Mobile "Drag to unfurl" tooltip
    const mobileHint = document.createElement('div');
    mobileHint.className = 'step17-unfurl-tooltip';
    mobileHint.setAttribute('aria-hidden', 'true');
    const arrow = document.createElement('span');
    arrow.className = 'step17-unfurl-arrow';
    arrow.textContent = '\u2193';
    const mobileLabel = document.createElement('span');
    mobileLabel.textContent = 'Drag to unfurl';
    mobileHint.append(arrow, mobileLabel);
    stage.appendChild(mobileHint);

    // 2. Mobile "Open all" pill button (when partially dragged >= 60px)
    const FAILSAFE_MIN_DRAG_PX = 60;
    const openAllBtn = document.createElement('button');
    openAllBtn.type = 'button';
    openAllBtn.className = 'step17-open-all-btn';
    openAllBtn.textContent = 'Open all';
    stage.appendChild(openAllBtn);

    // 3. Desktop "Click to unfurl" tooltip
    const desktopHint = document.createElement('div');
    desktopHint.className = 'home-click-hint';
    desktopHint.setAttribute('aria-hidden', 'true');
    desktopHint.innerHTML =
      '<svg viewBox="0 0 36 40" width="26" height="29" aria-hidden="true">' +
        '<g class="home-click-pointer">' +
          '<path d="M12 11V31L17 26L21 35L25 33L21 24H29Z"/>' +
        '</g>' +
        '<g class="home-click-rays">' +
          '<path d="M12 2V5M4 5L6.5 7.5M2 13H5M20 5L17.5 7.5M4 21L6.5 18.5"/>' +
        '</g>' +
      '</svg>' +
      '<span>Click to unfurl</span>';
    stage.appendChild(desktopHint);

    // 4. Unified Interactive Overlay Hitbox:
    //    - When closed/peeking: covers peeking parchment + bottom roller + arrow/hint
    //    - When open on mobile: provides an expanded 84px thumb drag zone on bottom roller
    //    - When open on desktop: covers bottom roller for click-to-close
    const hitbox = document.createElement('div');
    hitbox.className = 'step17-drag-hitbox';
    hitbox.setAttribute('role', 'button');
    hitbox.setAttribute('tabindex', '0');
    stage.appendChild(hitbox);

    // ========================================================================
    // STATE VARIABLES
    // ========================================================================
    let disposed = false;
    let height = 0;
    let revealed = 0;
    let paperTop = 0;
    let bottomHeight = 0;
    let stagePaddingBottom = 130;
    let fullyOpen = false;

    // Stage vertical offset (used ONLY for centering when closed on pages WITHOUT pre-scroll)
    let stageOffset = 0;

    // Sneak peek state
    let peekOffset = 0;
    let peekTimer = 0;
    let peekFrame = 0;

    // Hint timers
    let hintTimer = 0;
    let openAllTimer = 0;

    // Active programmatic animation state (open or close)
    let activeAnim = null; // { type: 'open' | 'close', startedAt, duration, startRevealed, targetRevealed, startOffset, targetOffset, startScrollY, targetScrollY, points, followHeight }

    // Mobile drag & inertia state
    let dragging = false;
    let touchId = null;
    let lastClientY = 0;
    let lastDocumentY = 0;
    let lastInputTime = 0;
    let samples = [];
    let velocity = 0;
    let gestureMoved = false;
    let grabbedDuringPeek = false;

    // RAF handles
    let frameId = 0;
    let measurementId = 0;
    let previousFrameTime = 0;

    // Mobile initial header hide state
    let initialHeaderHidden = startsClosed && isMobile();
    let headerScrollAnchor = window.scrollY;

    // ========================================================================
    // SNEAK PEEK ("YO-YO" BOUNCE)
    // ========================================================================
    function stopSneakPeek(resetRevealedIfIdle) {
      window.clearTimeout(peekTimer);
      window.cancelAnimationFrame(peekFrame);
      peekTimer = 0;
      peekFrame = 0;
      if (peekOffset !== 0) {
        peekOffset = 0;
        if (resetRevealedIfIdle && !dragging && !activeAnim && revealed < 1) {
          revealed = 0;
        }
        render();
      }
    }

    function scheduleSneakPeek(isFirstCycle) {
      const cfg = window.SCROLL_SNEAK_PEEK_CONFIG;
      if (!cfg || !cfg.enabled || reducedMotion.matches) return;
      if (peekTimer || peekFrame || disposed || document.hidden) return;
      if (revealed > 0.5 || dragging || activeAnim || Math.abs(velocity) >= 0.012) return;

      const wait = isFirstCycle
        ? cfg.initialDelayMs
        : Math.max(200, cfg.cyclePeriodMs - cfg.bounceDurationMs);

      peekTimer = window.setTimeout(function () {
        peekTimer = 0;
        if (
          disposed ||
          document.hidden ||
          revealed > 0.5 ||
          dragging ||
          activeAnim ||
          Math.abs(velocity) >= 0.012
        ) return;

        const start = performance.now();
        const dur = cfg.bounceDurationMs;
        const amp = isMobile() ? cfg.mobileDistancePx : cfg.desktopDistancePx;

        function stepPeek(now) {
          if (
            disposed ||
            document.hidden ||
            revealed > 0.5 ||
            dragging ||
            activeAnim ||
            Math.abs(velocity) >= 0.012
          ) {
            stopSneakPeek(false);
            return;
          }
          const t = Math.min(1, (now - start) / dur);
          peekOffset = amp * Math.sin(Math.PI * t);
          render();

          if (t < 1) {
            peekFrame = window.requestAnimationFrame(stepPeek);
          } else {
            peekOffset = 0;
            peekFrame = 0;
            render();
            scheduleSneakPeek(false);
          }
        }

        peekFrame = window.requestAnimationFrame(stepPeek);
      }, wait);
    }

    // ========================================================================
    // HINTS & OPEN-ALL PILL
    // ========================================================================
    function dismissHints() {
      window.clearTimeout(hintTimer);
      window.clearTimeout(openAllTimer);
      hintTimer = 0;
      openAllTimer = 0;
      mobileHint.classList.remove('is-visible');
      desktopHint.classList.remove('is-visible');
      openAllBtn.classList.remove('is-visible');
    }

    function updateHints() {
      if (disposed || document.hidden) return;

      const isMoving =
        dragging ||
        Boolean(activeAnim) ||
        Math.abs(velocity) >= 0.012;

      if (isMoving || fullyOpen) {
        dismissHints();
        stopSneakPeek(false);
        return;
      }

      // Mobile partially-dragged failsafe "Open all" button
      if (isMobile() && revealed >= FAILSAFE_MIN_DRAG_PX && !fullyOpen) {
        window.clearTimeout(hintTimer);
        hintTimer = 0;
        mobileHint.classList.remove('is-visible');
        desktopHint.classList.remove('is-visible');
        stopSneakPeek(false);

        if (!openAllTimer && !openAllBtn.classList.contains('is-visible')) {
          openAllTimer = window.setTimeout(function () {
            openAllTimer = 0;
            if (
              !disposed &&
              !dragging &&
              !activeAnim &&
              Math.abs(velocity) < 0.012 &&
              revealed >= FAILSAFE_MIN_DRAG_PX &&
              !fullyOpen
            ) {
              openAllBtn.classList.add('is-visible');
            }
          }, 220);
        }
        return;
      }

      openAllBtn.classList.remove('is-visible');
      window.clearTimeout(openAllTimer);
      openAllTimer = 0;

      if (revealed > 0.5) {
        dismissHints();
        stopSneakPeek(false);
        return;
      }

      // Scroll is closed (revealed <= 0.5): start sneak peek and show cue
      scheduleSneakPeek(true);

      const activeHint = isMobile() ? mobileHint : desktopHint;
      const inactiveHint = isMobile() ? desktopHint : mobileHint;
      inactiveHint.classList.remove('is-visible');

      if (hintTimer || activeHint.classList.contains('is-visible')) return;

      hintTimer = window.setTimeout(function () {
        hintTimer = 0;
        if (!disposed && revealed <= 0.5 && !dragging && !activeAnim) {
          activeHint.classList.add('is-visible');
        }
      }, 650);
    }

    // ========================================================================
    // RENDERING (Unified across Desktop & Mobile)
    // ========================================================================
    function render() {
      revealed = clamp(revealed, 0, height);

      // Visual revealed height includes the sneak-peek bounce offset,
      // while the DOM layout height of .scroll-stage uses ONLY `revealed`
      // so the peeking animation never alters page height or moves other elements.
      const visualRevealed = clamp(revealed + peekOffset, 0, height);
      const hidden = Math.max(0, height - visualRevealed);

      fullyOpen = height > 0 && height - revealed < 0.5;
      const isClosed = revealed <= 0.5 && !activeAnim;

      stage.setAttribute('data-step17-open', fullyOpen ? 'true' : 'false');
      stage.setAttribute('data-scroll-closed', isClosed ? 'true' : 'false');
      paper.inert = isClosed;

      if (fullyOpen) {
        revealed = height;
        paper.style.setProperty('clip-path', 'none');
        paper.style.setProperty('-webkit-clip-path', 'none');
        bottomRoller.style.setProperty('transform', 'translateY(0px)');
      } else {
        const clip = 'inset(0 -90px ' + hidden.toFixed(2) + 'px -90px)';
        paper.style.setProperty('clip-path', clip);
        paper.style.setProperty('-webkit-clip-path', clip);
        bottomRoller.style.setProperty(
          'transform',
          'translateY(' + (-hidden).toFixed(2) + 'px)'
        );
      }

      // Stage height depends strictly on `revealed` (NOT `visualRevealed`)
      const layoutStageHeight =
        paperTop + revealed + bottomHeight + stagePaddingBottom;
      stage.style.setProperty(
        '--step17-stage-height',
        layoutStageHeight.toFixed(2) + 'px'
      );

      // Apply optional centering translation (0px on any page with Pre-Scroll)
      if (Math.abs(stageOffset) > 0.1) {
        stage.style.translate = '0px ' + stageOffset.toFixed(2) + 'px';
      } else {
        stage.style.removeProperty('translate');
      }

      // Position tooltips relative to the visual bottom roller
      const rollerBottomY = paperTop + visualRevealed + bottomHeight;
      const controlTop = (rollerBottomY + 14).toFixed(2) + 'px';
      mobileHint.style.top = controlTop;
      desktopHint.style.top = controlTop;
      openAllBtn.style.top = controlTop;

      // Position unified interactive hitbox:
      // - When closed/peeking: spans from top of peeking paper down through bottom roller + arrow/cue
      // - When open on mobile: 84px tall drag zone centered around the bottom roller
      // - When open on desktop: covers the bottom roller
      if (revealed <= 0.5) {
        const hitboxTop = paperTop;
        const hitboxHeight = visualRevealed + bottomHeight + 76;
        hitbox.style.top = hitboxTop.toFixed(2) + 'px';
        hitbox.style.height = hitboxHeight.toFixed(2) + 'px';
      } else if (isMobile()) {
        const hitboxTop = Math.max(paperTop, rollerBottomY - bottomHeight - 20);
        const hitboxHeight = bottomHeight + 64;
        hitbox.style.top = hitboxTop.toFixed(2) + 'px';
        hitbox.style.height = hitboxHeight.toFixed(2) + 'px';
      } else {
        const hitboxTop = rollerBottomY - bottomHeight;
        hitbox.style.top = hitboxTop.toFixed(2) + 'px';
        hitbox.style.height = bottomHeight.toFixed(2) + 'px';
      }

      const actionLabel = isClosed ? 'Open the scroll' : 'Close the scroll';
      topRoller.setAttribute('aria-label', actionLabel);
      topRoller.setAttribute('aria-expanded', isClosed ? 'false' : 'true');
      bottomRoller.setAttribute('aria-label', actionLabel);
      bottomRoller.setAttribute('aria-expanded', isClosed ? 'false' : 'true');
      hitbox.setAttribute(
        'aria-label',
        isMobile()
          ? 'Scroll handle. Drag down to unfurl or up to furl.'
          : actionLabel
      );

      updateHints();
    }

    // ========================================================================
    // MEASUREMENT
    // ========================================================================
    function computeCenteredOffset() {
      if (hasPreScroll) return 0;
      const view = viewport();
      const stageDocTop =
        stage.getBoundingClientRect().top + window.scrollY - stageOffset;
      const rollersMidDocY = stageDocTop + paperTop + bottomHeight / 2;
      const targetDocY = view.height * 0.46;
      return clamp(targetDocY - rollersMidDocY, 0, view.height * 0.42);
    }

    function measure(first) {
      if (disposed) return;

      const previouslyOpen = fullyOpen;
      const previousHeight = height;

      height = paper.offsetHeight || paper.getBoundingClientRect().height;
      paperTop = paper.offsetTop;
      bottomHeight = bottomRoller.offsetHeight || 22;
      stagePaddingBottom =
        parseFloat(window.getComputedStyle(stage).paddingBottom) || 130;

      if (first) {
        revealed = 0;
        stageOffset = startsClosed && !hasPreScroll ? computeCenteredOffset() : 0;
      } else if (previouslyOpen && !dragging && !activeAnim) {
        // When already open, immediately adopt any dynamic height changes (e.g. Forum replies)
        // while browser native scroll anchoring keeps the reader's viewport locked.
        revealed = height;
      } else {
        revealed = clamp(revealed, 0, height);
      }

      if (dragging && Math.abs(previousHeight - height) > 0.5) {
        lastDocumentY = lastClientY + window.scrollY;
        samples = [{ y: lastClientY, time: performance.now() }];
      }

      render();
    }

    function scheduleMeasurement() {
      if (disposed || measurementId) return;
      measurementId = window.requestAnimationFrame(function () {
        measurementId = 0;
        measure(false);
      });
    }

    // ========================================================================
    // UNIFIED SMOOTH OPEN & CLOSE ANIMATIONS
    // ========================================================================
    function openingSettings() {
      const styles = window.getComputedStyle(paper);
      function num(name, fallback) {
        const v = Number.parseFloat(styles.getPropertyValue(name));
        return Number.isFinite(v) && v > 0 ? v : fallback;
      }
      return {
        speed: num('--mobile-unfurl-speed', 950) / 1000,
        threshold: num('--mobile-release-threshold', 320) / 1000,
        releaseCap: num('--mobile-release-speed-cap', 950) / 1000,
        minimum: num('--mobile-unfurl-min-duration', 1350),
      };
    }

    function computeOpenDuration(distance, settings) {
      return clamp(
        Math.max(settings.minimum, distance / settings.speed),
        1250,
        2400
      );
    }

    function stopFrame() {
      window.cancelAnimationFrame(frameId);
      frameId = 0;
    }

    function setAnimatingAttr(isAnimating) {
      if (isAnimating) {
        html.setAttribute('data-scroll-animating', 'true');
      } else {
        html.removeAttribute('data-scroll-animating');
      }
    }

    function openSmoothly(delayMs) {
      if (disposed) return;

      // Capture current visual height (including any mid-peek offset) so opening
      // starts seamlessly from the exact visible position without snapping back to 0.
      const startFrom = clamp(revealed + peekOffset, 0, height);
      stopSneakPeek(false);
      revealed = startFrom;
      dismissHints();

      dragging = false;
      touchId = null;
      velocity = 0;

      if (reducedMotion.matches) {
        activeAnim = null;
        revealed = height;
        stageOffset = 0;
        setAnimatingAttr(false);
        render();
        return;
      }

      const remaining = Math.max(0, height - revealed);
      const settings = openingSettings();
      const duration = computeOpenDuration(remaining, settings);

      // Simultaneous decentering (0ms delay!) if stageOffset > 0
      activeAnim = {
        type: 'open',
        followHeight: true,
        startedAt: performance.now() + (delayMs || 0),
        duration,
        startRevealed: revealed,
        targetRevealed: height,
        startOffset: stageOffset,
        targetOffset: 0,
        startScrollY: window.scrollY,
        targetScrollY: window.scrollY,
        // Smooth ease-out curve that gently decelerates before coming to a stop
        points: [0.25, 1, 0.5, 1],
      };

      setAnimatingAttr(true);
      beginFrame();
    }

    function closeSmoothly() {
      if (disposed) return;

      const startFrom = clamp(revealed + peekOffset, 0, height);
      stopSneakPeek(false);
      revealed = startFrom;
      dismissHints();

      dragging = false;
      touchId = null;
      velocity = 0;

      // Calculate smart viewport target:
      // - If user is above the scroll (e.g. reading Pre-Scroll text), viewport stays put.
      // - If user is scrolled down inside the scroll (or at the bottom roller), viewport
      //   rides smoothly up with the shrinking scroll and stops right at the top roller.
      const headerEl = document.querySelector('header.site-header');
      const headerH = headerEl ? headerEl.offsetHeight : 74;
      const stageDocTop =
        stage.getBoundingClientRect().top + window.scrollY - stageOffset;
      const maxClosedScrollY = Math.max(0, stageDocTop - headerH - 20);
      const startScrollY = window.scrollY;
      const targetScrollY = Math.min(startScrollY, maxClosedScrollY);

      const targetOffset = hasPreScroll ? 0 : computeCenteredOffset();

      if (reducedMotion.matches) {
        activeAnim = null;
        revealed = 0;
        stageOffset = targetOffset;
        setAnimatingAttr(false);
        render();
        if (targetScrollY < startScrollY) {
          window.scrollTo({ top: targetScrollY, behavior: 'instant' });
        }
        return;
      }

      activeAnim = {
        type: 'close',
        followHeight: false,
        startedAt: performance.now(),
        duration: 950,
        startRevealed: revealed,
        targetRevealed: 0,
        startOffset: stageOffset,
        targetOffset,
        startScrollY,
        targetScrollY,
        // Smooth acceleration and gentle deceleration at the stop
        points: [0.33, 0, 0.2, 1],
      };

      setAnimatingAttr(true);
      beginFrame();
    }

    function toggleOpenClose() {
      const isCurrentlyClosed =
        (revealed <= 0.5 && (!activeAnim || activeAnim.type === 'close')) ||
        (activeAnim && activeAnim.type === 'close');
      if (isCurrentlyClosed) {
        openSmoothly(0);
      } else {
        closeSmoothly();
      }
    }

    // ========================================================================
    // VELOCITY-SENSITIVE FLICK COMPLETION (Mobile Drag Release)
    // ========================================================================
    function beginFlickOpen(releaseSpeed) {
      const remaining = Math.max(0, height - revealed);
      const settings = openingSettings();

      if (
        reducedMotion.matches ||
        remaining <= 0.5 ||
        releaseSpeed < settings.threshold
      ) {
        return false;
      }

      const duration = computeOpenDuration(remaining, settings);
      const initialSpeed = Math.min(releaseSpeed, settings.releaseCap);
      const firstY = clamp(((initialSpeed * duration) / remaining) * 0.33, 0, 1);

      activeAnim = {
        type: 'open',
        followHeight: true,
        startedAt: performance.now(),
        duration,
        startRevealed: revealed,
        targetRevealed: height,
        startOffset: stageOffset,
        targetOffset: 0,
        startScrollY: window.scrollY,
        targetScrollY: window.scrollY,
        points: [0.33, firstY, 0.67, 1],
      };

      velocity = 0;
      setAnimatingAttr(true);
      beginFrame();
      return true;
    }

    // ========================================================================
    // MAIN ANIMATION LOOP (RAF)
    // ========================================================================
    function tick(now) {
      if (disposed) return;
      frameId = 0;

      const elapsed = clamp(now - previousFrameTime, 0, 32);
      previousFrameTime = now;

      if (activeAnim) {
        if (now < activeAnim.startedAt) {
          frameId = window.requestAnimationFrame(tick);
          return;
        }

        const rawProgress = clamp(
          (now - activeAnim.startedAt) / activeAnim.duration,
          0,
          1
        );
        const eased = evalBezier(rawProgress, activeAnim.points);

        const targetRev = activeAnim.followHeight
          ? height
          : activeAnim.targetRevealed;

        revealed = clamp(
          activeAnim.startRevealed +
            (targetRev - activeAnim.startRevealed) * eased,
          0,
          height
        );

        stageOffset =
          activeAnim.startOffset +
          (activeAnim.targetOffset - activeAnim.startOffset) * eased;

        // If closing while scrolled deep down the page, smoothly ride upward with the scroll
        if (
          activeAnim.type === 'close' &&
          activeAnim.targetScrollY < activeAnim.startScrollY
        ) {
          const nextScrollY =
            activeAnim.startScrollY +
            (activeAnim.targetScrollY - activeAnim.startScrollY) * eased;
          window.scrollTo({ top: nextScrollY, behavior: 'instant' });
        }

        render();

        if (rawProgress >= 1) {
          revealed = activeAnim.type === 'open' ? height : 0;
          stageOffset = activeAnim.targetOffset;
          const finalScrollMove =
            activeAnim.type === 'close' &&
            activeAnim.targetScrollY < activeAnim.startScrollY;
          const finalScrollY = activeAnim.targetScrollY;
          activeAnim = null;
          velocity = 0;
          setAnimatingAttr(false);
          render();
          if (finalScrollMove) {
            window.scrollTo({ top: finalScrollY, behavior: 'instant' });
          }
          return;
        }

        frameId = window.requestAnimationFrame(tick);
        return;
      }

      if (dragging) {
        scrollDuringDrag(elapsed);
        frameId = window.requestAnimationFrame(tick);
        return;
      }

      if (Math.abs(velocity) < 0.012) {
        velocity = 0;
        setAnimatingAttr(false);
        updateHints();
        return;
      }

      // Exponential friction coasting on mobile drag release
      const friction = 0.0045;
      const decay = Math.exp(-friction * elapsed);
      const displacement = (velocity * (1 - decay)) / friction;
      const proposed = revealed + displacement;

      revealed = clamp(proposed, 0, height);
      velocity *= decay;

      // When dragging down when centered on a non-pre-scroll page, smoothly zero out stageOffset
      if (stageOffset > 0 && revealed > 0) {
        stageOffset = Math.max(0, stageOffset - Math.abs(displacement) * 0.5);
      }

      if (proposed <= 0 || proposed >= height) {
        velocity = 0;
      }

      render();

      if (Math.abs(velocity) >= 0.012) {
        frameId = window.requestAnimationFrame(tick);
      } else {
        velocity = 0;
        setAnimatingAttr(false);
        updateHints();
      }
    }

    function beginFrame() {
      stopFrame();
      previousFrameTime = performance.now();
      frameId = window.requestAnimationFrame(tick);
    }

    // ========================================================================
    // MOBILE TOUCH DRAG INTERACTION
    // ========================================================================
    function findTouch(list) {
      for (let i = 0; i < list.length; i += 1) {
        if (list[i].identifier === touchId) return list[i];
      }
      return null;
    }

    function recordVelocity(clientY, now) {
      samples.push({ y: clientY, time: now });
      while (samples.length > 2 && samples[0].time < now - 90) {
        samples.shift();
      }
      const first = samples[0];
      const dt = now - first.time;
      velocity = dt > 0 ? (clientY - first.y) / dt : 0;
    }

    function scrollDuringDrag(elapsed) {
      if (!dragging) return;
      const view = viewport();
      const edgeZone = Math.min(90, view.height * 0.15);
      const upperEdge = view.top + edgeZone;
      const lowerEdge = view.top + view.height - edgeZone;

      let speed = 0;
      if (lastClientY > lowerEdge && revealed < height) {
        speed = clamp((lastClientY - lowerEdge) / edgeZone, 0, 1) * 0.65;
      } else if (lastClientY < upperEdge && revealed > 0) {
        speed = -clamp((upperEdge - lastClientY) / edgeZone, 0, 1) * 0.65;
      }
      if (speed === 0) return;

      const prevScroll = window.scrollY;
      window.scrollTo({
        top: prevScroll + speed * elapsed,
        behavior: 'instant',
      });
      const actualScroll = window.scrollY - prevScroll;
      if (actualScroll !== 0) {
        revealed = clamp(revealed + actualScroll, 0, height);
        lastDocumentY += actualScroll;
        render();
      }
    }

    function onTouchStart(event) {
      if (!isMobile() || event.touches.length !== 1) return;

      stopFrame();
      grabbedDuringPeek = peekOffset > 0.5 && revealed <= 0.5;
      if (grabbedDuringPeek) {
        revealed = clamp(revealed + peekOffset, 0, height);
      }
      stopSneakPeek(false);
      activeAnim = null;

      const touch = event.touches[0];
      const now = performance.now();

      dragging = true;
      setAnimatingAttr(true);
      dismissHints();

      touchId = touch.identifier;
      lastClientY = touch.clientY;
      lastDocumentY = touch.clientY + window.scrollY;
      lastInputTime = now;
      gestureMoved = false;
      velocity = 0;
      samples = [{ y: touch.clientY, time: now }];

      beginFrame();
    }

    function onTouchMove(event) {
      if (!dragging) return;
      if (event.touches.length !== 1) {
        onTouchCancel();
        return;
      }
      const touch = findTouch(event.touches);
      if (!touch) return;
      if (event.cancelable) event.preventDefault();

      const now = performance.now();
      const documentY = touch.clientY + window.scrollY;
      const displacement = documentY - lastDocumentY;

      if (Math.abs(displacement) > 0.5) {
        gestureMoved = true;
        dismissHints();
      }

      // If centered on a non-pre-scroll page, smoothly pull stageOffset back to 0 as user drags
      if (stageOffset > 0 && displacement > 0) {
        const offsetUsed = Math.min(stageOffset, displacement * 0.5);
        stageOffset -= offsetUsed;
      }

      revealed = clamp(revealed + displacement, 0, height);
      lastDocumentY = documentY;
      lastClientY = touch.clientY;
      lastInputTime = now;

      recordVelocity(touch.clientY, now);
      render();
    }

    function onTouchEnd(event) {
      if (!dragging) return;
      const touch = findTouch(event.changedTouches);
      if (!touch) return;

      const now = performance.now();
      dragging = false;
      touchId = null;
      stopFrame();

      if (!gestureMoved) {
        velocity = 0;
        if (grabbedDuringPeek) {
          revealed = 0;
        }
        grabbedDuringPeek = false;
        setAnimatingAttr(false);
        render();
        return;
      }

      grabbedDuringPeek = false;

      if (now - lastInputTime > 100 || reducedMotion.matches) {
        velocity = 0;
      }

      if (velocity > 0 && beginFlickOpen(velocity)) return;

      if (Math.abs(velocity) >= 0.012) {
        beginFrame();
      } else {
        setAnimatingAttr(false);
        updateHints();
      }
    }

    function onTouchCancel() {
      activeAnim = null;
      dragging = false;
      touchId = null;
      velocity = 0;
      if (grabbedDuringPeek && !gestureMoved) {
        revealed = 0;
      }
      grabbedDuringPeek = false;
      stopFrame();
      setAnimatingAttr(false);
      render();
    }

    // ========================================================================
    // ROLLER & HITBOX CLICK / KEYBOARD HANDLERS
    // ========================================================================

    // Top Roller: toggles open/close on BOTH Desktop and Mobile
    function onTopRollerTrigger(event) {
      if (
        event.type === 'keydown' &&
        event.key !== 'Enter' &&
        event.key !== ' '
      ) return;
      event.preventDefault();
      event.stopPropagation();
      toggleOpenClose();
    }

    // Bottom Roller & Hitbox:
    // - Desktop: click toggles open/close (including clicking peeking parchment)
    // - Mobile: bottom roller is drag-only (unless activated via keyboard accessibility)
    function onBottomOrHitboxClick(event) {
      if (isMobile()) return;
      event.preventDefault();
      event.stopPropagation();
      toggleOpenClose();
    }

    function onBottomOrHitboxKeyDown(event) {
      if (!isMobile()) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          event.stopPropagation();
          toggleOpenClose();
        }
        return;
      }

      // Mobile keyboard accessibility
      const inc = Math.max(40, viewport().height * 0.15);
      let next = revealed;
      if (event.key === 'ArrowDown') next += inc;
      else if (event.key === 'ArrowUp') next -= inc;
      else if (event.key === 'PageDown') next += viewport().height * 0.8;
      else if (event.key === 'PageUp') next -= viewport().height * 0.8;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = height;
      else if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleOpenClose();
        return;
      } else {
        return;
      }

      event.preventDefault();
      onTouchCancel();
      dismissHints();
      revealed = clamp(next, 0, height);
      render();
    }

    topRoller.setAttribute('role', 'button');
    topRoller.setAttribute('tabindex', '0');
    bottomRoller.setAttribute('role', 'button');
    bottomRoller.setAttribute('tabindex', '0');

    topRoller.addEventListener('click', onTopRollerTrigger, { signal });
    topRoller.addEventListener('keydown', onTopRollerTrigger, { signal });

    bottomRoller.addEventListener('click', onBottomOrHitboxClick, { signal });
    bottomRoller.addEventListener('keydown', onBottomOrHitboxKeyDown, { signal });

    hitbox.addEventListener('click', onBottomOrHitboxClick, { signal });
    hitbox.addEventListener('keydown', onBottomOrHitboxKeyDown, { signal });

    // Attach mobile drag listeners to both the expanded hitbox, bottom roller, and mobile hint
    for (const dragEl of [hitbox, bottomRoller, mobileHint]) {
      dragEl.addEventListener('touchstart', onTouchStart, { passive: true, signal });
      dragEl.addEventListener('touchmove', onTouchMove, { passive: false, signal });
      dragEl.addEventListener('touchend', onTouchEnd, { passive: true, signal });
      dragEl.addEventListener('touchcancel', onTouchCancel, { passive: true, signal });
    }

    openAllBtn.addEventListener('click', function (event) {
      event.preventDefault();
      event.stopPropagation();
      openSmoothly(0);
    }, { signal });

    // ========================================================================
    // HEADER & FOCUS MANAGEMENT
    // ========================================================================
    function releaseInitialHeader() {
      if (!initialHeaderHidden) return;
      initialHeaderHidden = false;
      html.removeAttribute('data-step17-header-hidden');
    }

    function onNativeScroll() {
      const currentY = window.scrollY;
      if (dragging) {
        headerScrollAnchor = currentY;
        return;
      }
      if (currentY >= headerScrollAnchor) {
        headerScrollAnchor = currentY;
        return;
      }
      if (headerScrollAnchor - currentY >= 3) {
        releaseInitialHeader();
        const header = document.querySelector('header.site-header');
        if (header) header.classList.remove('is-hidden');
        headerScrollAnchor = currentY;
      }
    }

    function onFocusIn(event) {
      if (!paper.contains(event.target) || fullyOpen) return;
      openSmoothly(0);
    }

    function onVisibilityChange() {
      if (document.hidden) {
        stopSneakPeek(true);
        onTouchCancel();
      } else {
        updateHints();
      }
    }

    // ========================================================================
    // INITIALIZATION & OBSERVERS
    // ========================================================================
    stage.setAttribute('data-step17-physics', 'true');
    stage.setAttribute('data-scroll-physics-init', 'true');

    if (initialHeaderHidden) {
      html.setAttribute('data-step17-header-hidden', 'true');
    }

    paper.addEventListener('focusin', onFocusIn, { signal });
    window.addEventListener('resize', scheduleMeasurement, { passive: true, signal });
    window.addEventListener('scroll', onNativeScroll, { passive: true, signal });
    document.addEventListener('visibilitychange', onVisibilityChange, { signal });
    window.addEventListener('focus', updateHints, { passive: true, signal });
    window.addEventListener('pageshow', updateHints, { passive: true, signal });

    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', scheduleMeasurement, {
        passive: true,
        signal,
      });
    }

    const observer =
      typeof ResizeObserver === 'function'
        ? new ResizeObserver(function () {
            if (disposed) return;
            window.cancelAnimationFrame(measurementId);
            measurementId = 0;
            measure(false);
          })
        : null;

    if (observer) observer.observe(paper);

    paper.addEventListener('load', scheduleMeasurement, { capture: true, signal });

    // Perform initial synchronous measurement before first paint
    measure(true);

    // Wait for fonts & any dynamic initial content, then auto-unfurl if not a startClosed page
    window.scrollContentReady(paper).then(function () {
      if (disposed || !paper.isConnected) return;
      measure(false);
      stage.removeAttribute('data-scroll-initial-wait');

      if (!startsClosed) {
        openSmoothly(450);
      } else {
        updateHints();
      }
    });

    // ========================================================================
    // CLEANUP
    // ========================================================================
    cleanupCurrent = function () {
      disposed = true;
      stopSneakPeek(false);
      stopFrame();
      setAnimatingAttr(false);
      controller.abort();
      window.cancelAnimationFrame(measurementId);
      window.clearTimeout(hintTimer);
      window.clearTimeout(openAllTimer);
      if (observer) observer.disconnect();
      mobileHint.remove();
      desktopHint.remove();
      openAllBtn.remove();
      hitbox.remove();
      html.removeAttribute('data-step17-header-hidden');
      paper.inert = false;
    };
  }

  function destroy() {
    lifetime.abort();
    if (cleanupCurrent) cleanupCurrent();
    cleanupCurrent = null;
  }

  window[key] = destroy;

  mobileQuery.addEventListener('change', function () {
    // Re-evaluate hints and hitbox sizing on breakpoint cross without losing open/close state
    if (cleanupCurrent) initialize();
  }, { signal: lifetime.signal });

  document.addEventListener('astro:before-swap', function () {
    if (cleanupCurrent) cleanupCurrent();
    cleanupCurrent = null;
  }, { signal: lifetime.signal });

  document.addEventListener('astro:page-load', initialize, {
    signal: lifetime.signal,
  });

  initialize();
})();
</script>
