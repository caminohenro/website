---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../data/siteConfig.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.siteTitleJp + ' | ' + siteConfig.siteTitleEn,
  description = siteConfig.tagline,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={siteConfig.crestImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+JP:wght@400;600&family=Shippori+Mincho:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="selection:bg-[#6E2B25] selection:text-[#E6DFCF]">
    <!-- LAYER 1: Fixed Road & Apple Background -->
    <div
      class="fixed-backdrop"
      style="background-image: url('/assets/apple-bg.jpeg'), url('/assets/apple-bg.svg');"
    ></div>
    <div class="backdrop-dimmer" id="dimmer"></div>

    <!-- PERSISTENT WEBSITE HEADER (Outside the Scroll) -->
    <Header />

    <!-- LAYER 2: THE INDIVIDUAL PAGE SCROLL WITH WOODEN ROLLERS -->
    <div class="scroll-stage">
      <div class="scroll-roller-top"></div>
      <main class="washi-scroll">
        <slot />
        <Footer />
      </main>
      <div class="scroll-roller-bottom"></div>
    </div>

    <!-- THE SURPRISE REVEAL AT THE BOTTOM OF EVERY PAGE -->
    <div class="apple-reveal-stage" aria-hidden="true">
      <div class="apple-whisper">
        お接待 • <em>Osettai</em> — The simplest gift of the road is enough.
      </div>
    </div>

    <script is:inline>
      // Gently brighten the road & apple as the user scrolls past the bottom roller
      window.addEventListener('scroll', function () {
        const dimmer = document.getElementById('dimmer');
        if (!dimmer) return;
        const scrollBottom = window.scrollY + window.innerHeight;
        const docHeight = document.documentElement.scrollHeight;
        const revealProgress = Math.max(0, Math.min(1, (scrollBottom - (docHeight - window.innerHeight * 0.85)) / (window.innerHeight * 0.6)));
        const centerAlpha = (0.58 - revealProgress * 0.48).toFixed(2);
        const edgeAlpha = (0.84 - revealProgress * 0.35).toFixed(2);
        dimmer.style.setProperty('--center-dim', centerAlpha);
        dimmer.style.setProperty('--edge-dim', edgeAlpha);
      });
    </script>
  <!-- STEP17_MOBILE_SCROLL_PHYSICS_START -->
    <script is:inline>
(function mobileScrollPhysics() {
  'use strict';

  const globalKey = '__step17MobileScrollPhysics';

  if (typeof window[globalKey] === 'function') {
    window[globalKey]();
  }

  const mobile = window.matchMedia('(max-width: 680px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const lifecycle = new AbortController();

  let disposeCurrent = null;
  let tooltipDismissed = false;

  function initialize() {
    if (disposeCurrent) {
      disposeCurrent();
      disposeCurrent = null;
    }

    if (!mobile.matches || window.innerWidth > 680) return;

    // Direct-child selectors deliberately exclude the Forum composer scroll.
    const stage = document.querySelector('body > .scroll-stage');
    if (!stage) return;

    const paper = stage.querySelector(':scope > main.washi-scroll');
    const roller = stage.querySelector(':scope > .scroll-roller-bottom');
    if (!paper || !roller) return;

    const controller = new AbortController();
    const signal = controller.signal;
    const savedStyles = new Map();
    const savedAttributes = new Map();

    function rememberStyle(element, property) {
      if (!savedStyles.has(element)) savedStyles.set(element, new Map());
      const properties = savedStyles.get(element);

      if (!properties.has(property)) {
        properties.set(property, {
          value: element.style.getPropertyValue(property),
          priority: element.style.getPropertyPriority(property),
        });
      }
    }

    function setStyle(element, property, value) {
      rememberStyle(element, property);
      element.style.setProperty(property, value);
    }

    function rememberAttribute(element, name) {
      if (!savedAttributes.has(element)) {
        savedAttributes.set(element, new Map());
      }

      const attributes = savedAttributes.get(element);
      if (!attributes.has(name)) {
        attributes.set(name, element.getAttribute(name));
      }
    }

    function setAttribute(element, name, value) {
      rememberAttribute(element, name);
      element.setAttribute(name, value);
    }

    function restoreAttributes() {
      savedAttributes.forEach(function (attributes, element) {
        attributes.forEach(function (value, name) {
          if (value === null) element.removeAttribute(name);
          else element.setAttribute(name, value);
        });
      });
    }

    let disposed = false;
    let height = 0;
    let maximumHidden = 0;
    let hidden = 0;
    let full = false;
    let dragging = false;
    let identifier = null;
    let startY = 0;
    let startHidden = 0;
    let lastY = 0;
    let lastTime = 0;
    let velocity = 0;
    let moved = false;
    let momentumFrame = 0;
    let measurementFrame = 0;
    let tooltipTimer = 0;
    let samples = [];

    const tooltip = document.createElement('div');
    tooltip.className = 'step17-unfurl-tooltip';
    tooltip.setAttribute('aria-hidden', 'true');

    const arrow = document.createElement('span');
    arrow.className = 'step17-unfurl-arrow';
    arrow.textContent = '\u2193';

    const caption = document.createElement('span');
    caption.textContent = 'Drag to unfurl';

    tooltip.append(arrow, caption);
    stage.appendChild(tooltip);

    function clamp(value, minimum, maximum) {
      return Math.min(maximum, Math.max(minimum, value));
    }

    function dismissTooltip() {
      tooltipDismissed = true;
      window.clearTimeout(tooltipTimer);
      tooltip.classList.remove('is-visible');
    }

    function stopMomentum() {
      window.cancelAnimationFrame(momentumFrame);
      momentumFrame = 0;
    }

    function render() {
      hidden = clamp(hidden, 0, maximumHidden);
      full = hidden <= 0.5;

      if (full) {
        hidden = 0;

        // Remove clipping completely at the endpoint. The paper remains
        // naturally sized, including asynchronously loaded Forum replies.
        setStyle(paper, 'clip-path', 'none');
        setStyle(paper, '-webkit-clip-path', 'none');
        setStyle(roller, 'transform', 'none');
        setStyle(roller, 'touch-action', 'auto');
        setStyle(paper, 'will-change', 'auto');
        setStyle(roller, 'will-change', 'auto');

        restoreAttributes();
        tooltip.classList.remove('is-visible');
      } else {
        const inset = 'inset(0 -90px ' + hidden.toFixed(3) + 'px -90px)';

        setStyle(paper, 'clip-path', inset);
        setStyle(paper, '-webkit-clip-path', inset);

        // The roller's natural position is below the entire paper.
        // A negative translation raises it to the exposed paper edge.
        // Dragging down reduces hidden pixels and moves it toward zero.
        setStyle(
          roller,
          'transform',
          'translateY(' + (-hidden).toFixed(3) + 'px)'
        );

        setStyle(roller, 'touch-action', 'none');
        setStyle(paper, 'will-change', 'clip-path');
        setStyle(roller, 'will-change', 'transform');

        setAttribute(roller, 'role', 'button');
        setAttribute(roller, 'tabindex', '0');
        setAttribute(
          roller,
          'aria-label',
          'Drag down to unfurl, or press Enter to reveal the entire page'
        );

        // offsetTop is independent of the roller's transform.
        const edge = roller.offsetTop - hidden + roller.offsetHeight + 15;
        tooltip.style.top = edge.toFixed(3) + 'px';
      }
    }

    function measure(firstMeasurement) {
      if (disposed) return;

      const previousHeight = height;
      const previousVisible = height - hidden;
      const wasFull = full;

      height = paper.getBoundingClientRect().height;

      const viewportHeight = window.visualViewport
        ? window.visualViewport.height
        : window.innerHeight;

      const paperTop = paper.getBoundingClientRect().top;
      const viewportTop = window.visualViewport
        ? window.visualViewport.offsetTop
        : 0;

      // Start approximately 70% open on short pages. On long pages, cap
      // the exposed area so the roller and its hint remain reachable.
      const available = Math.max(
        64,
        viewportTop + viewportHeight - paperTop - roller.offsetHeight - 100
      );

      const minimumVisible = Math.min(height * 0.7, available);
      maximumHidden = Math.max(0, height - minimumVisible);

      if (firstMeasurement) {
        hidden = maximumHidden;
      } else if (wasFull) {
        hidden = 0;
      } else {
        // Preserve the visible paper edge when fonts, replies, images,
        // composer forms, or viewport dimensions change.
        hidden = clamp(height - previousVisible, 0, maximumHidden);
      }

      if (dragging && Math.abs(height - previousHeight) > 0.5) {
        startY = lastY;
        startHidden = hidden;
        samples = [{ y: lastY, time: performance.now() }];
      }

      render();
    }

    function scheduleMeasurement() {
      if (disposed || measurementFrame) return;

      measurementFrame = window.requestAnimationFrame(function () {
        measurementFrame = 0;
        measure(false);
      });
    }

    function touchByIdentifier(list, id) {
      for (let index = 0; index < list.length; index += 1) {
        if (list[index].identifier === id) return list[index];
      }
      return null;
    }

    function recordSample(y, time) {
      samples.push({ y: y, time: time });

      // Estimate release speed from the last 100 ms rather than from
      // the whole gesture. This allows a reversal before release.
      while (samples.length > 2 && samples[0].time < time - 100) {
        samples.shift();
      }

      const first = samples[0];
      const elapsed = time - first.time;
      velocity = elapsed > 0 ? clamp((y - first.y) / elapsed, -4, 4) : 0;
    }

    function animateTo(target, releaseVelocity) {
      stopMomentum();

      if (reducedMotion.matches) {
        hidden = target;
        render();
        return;
      }

      // Work in revealed pixels: positive velocity means unrolling.
      let position = maximumHidden - hidden;
      const destination = maximumHidden - target;
      let speed = releaseVelocity * 1000;
      let previousTime = performance.now();
      const startedAt = previousTime;

      // Critically damped spring: a = w²(target - x) - 2wv.
      // x is pixels, v is pixels/second, and time is seconds.
      const angularFrequency = 12;

      function frame(now) {
        if (disposed) return;

        const elapsed = clamp((now - previousTime) / 1000, 0, 0.032);
        previousTime = now;

        // Small integration steps keep the spring stable after slow frames.
        const steps = Math.max(1, Math.ceil(elapsed / 0.008));
        const step = elapsed / steps;

        for (let index = 0; index < steps; index += 1) {
          const acceleration =
            angularFrequency * angularFrequency * (destination - position) -
            2 * angularFrequency * speed;

          speed += acceleration * step;
          position += speed * step;

          if (position <= 0) {
            position = 0;
            speed = Math.max(0, speed);
          }

          if (position >= maximumHidden) {
            position = maximumHidden;
            speed = Math.min(0, speed);
          }
        }

        hidden = maximumHidden - position;

        const arrived =
          Math.abs(destination - position) < 0.5 &&
          Math.abs(speed) < 8;

        if (arrived || now - startedAt >= 1800) {
          hidden = target;
          momentumFrame = 0;
          render();
          return;
        }

        render();
        momentumFrame = window.requestAnimationFrame(frame);
      }

      momentumFrame = window.requestAnimationFrame(frame);
    }

    function onTouchStart(event) {
      // Once fully open, these listeners never cancel browser scrolling.
      if (full || event.touches.length !== 1) return;

      stopMomentum();

      const touch = event.touches[0];
      const now = performance.now();

      dragging = true;
      moved = false;
      identifier = touch.identifier;
      startY = touch.pageY;
      lastY = touch.pageY;
      startHidden = hidden;
      lastTime = now;
      velocity = 0;
      samples = [{ y: touch.pageY, time: now }];
    }

    function onTouchMove(event) {
      if (!dragging) return;

      if (event.touches.length !== 1) {
        dragging = false;
        identifier = null;
        animateTo(0, 0);
        return;
      }

      const touch = touchByIdentifier(event.touches, identifier);
      if (!touch) return;

      if (!event.cancelable) {
        dragging = false;
        identifier = null;
        animateTo(0, 0);
        return;
      }

      event.preventDefault();

      const now = performance.now();
      const displacement = touch.pageY - startY;

      if (Math.abs(displacement) > 0.5) {
        moved = true;
        dismissTooltip();
      }

      hidden = clamp(startHidden - displacement, 0, maximumHidden);
      lastY = touch.pageY;
      lastTime = now;
      recordSample(touch.pageY, now);
      render();
    }

    function onTouchEnd(event) {
      if (!dragging) return;

      const touch = touchByIdentifier(event.changedTouches, identifier);
      if (!touch) return;

      dragging = false;
      identifier = null;

      if (!moved) return;

      const now = performance.now();
      if (now - lastTime > 100) velocity = 0;

      // A downward flick opens fully; an upward flick returns to the
      // reachable initial furl. A slow release snaps to the nearer end.
      let target;

      if (velocity > 0.08) target = 0;
      else if (velocity < -0.08) target = maximumHidden;
      else target = hidden < maximumHidden * 0.5 ? 0 : maximumHidden;

      animateTo(target, velocity);
    }

    function onTouchCancel() {
      if (!dragging) return;
      dragging = false;
      identifier = null;
      dismissTooltip();
      animateTo(0, 0);
    }

    function revealImmediately() {
      if (full) return;
      stopMomentum();
      dragging = false;
      identifier = null;
      dismissTooltip();
      hidden = 0;
      render();
    }

    function onKeyDown(event) {
      if (full) return;

      if (
        event.key === 'Enter' ||
        event.key === ' ' ||
        event.key === 'ArrowDown' ||
        event.key === 'End'
      ) {
        event.preventDefault();
        dismissTooltip();
        animateTo(0, 0);
      }
    }

    roller.addEventListener('touchstart', onTouchStart, {
      passive: true,
      signal: signal,
    });

    roller.addEventListener('touchmove', onTouchMove, {
      passive: false,
      signal: signal,
    });

    roller.addEventListener('touchend', onTouchEnd, {
      passive: true,
      signal: signal,
    });

    roller.addEventListener('touchcancel', onTouchCancel, {
      passive: true,
      signal: signal,
    });

    roller.addEventListener('keydown', onKeyDown, { signal: signal });

    // A keyboard user reaching content inside the clipped region must
    // never end up focused on an invisible control.
    paper.addEventListener('focusin', revealImmediately, { signal: signal });

    window.addEventListener('resize', scheduleMeasurement, {
      passive: true,
      signal: signal,
    });

    window.addEventListener('pageshow', function (event) {
      if (event.persisted) revealImmediately();
      scheduleMeasurement();
    }, { signal: signal });

    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', scheduleMeasurement, {
        passive: true,
        signal: signal,
      });
    }

    const resizeObserver = typeof ResizeObserver === 'function'
      ? new ResizeObserver(scheduleMeasurement)
      : null;

    if (resizeObserver) resizeObserver.observe(paper);

    paper.addEventListener('load', scheduleMeasurement, {
      capture: true,
      signal: signal,
    });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () {
        if (!disposed) scheduleMeasurement();
      });
    }

    measure(true);

    // Preserve restored scroll positions and direct links to deep content.
    if (window.scrollY > 20 || window.location.hash) {
      revealImmediately();
    }

    tooltipTimer = window.setTimeout(function () {
      if (!disposed && !tooltipDismissed && !full) {
        tooltip.classList.add('is-visible');
      }
    }, 500);

    disposeCurrent = function () {
      disposed = true;
      controller.abort();
      stopMomentum();
      window.cancelAnimationFrame(measurementFrame);
      window.clearTimeout(tooltipTimer);

      if (resizeObserver) resizeObserver.disconnect();

      tooltip.remove();
      restoreAttributes();

      savedStyles.forEach(function (properties, element) {
        properties.forEach(function (saved, property) {
          if (saved.value) {
            element.style.setProperty(property, saved.value, saved.priority);
          } else {
            element.style.removeProperty(property);
          }
        });
      });
    };
  }

  function destroy() {
    lifecycle.abort();

    if (disposeCurrent) {
      disposeCurrent();
      disposeCurrent = null;
    }
  }

  window[globalKey] = destroy;

  mobile.addEventListener('change', initialize, {
    signal: lifecycle.signal,
  });

  document.addEventListener('astro:before-swap', function () {
    if (disposeCurrent) {
      disposeCurrent();
      disposeCurrent = null;
    }
  }, { signal: lifecycle.signal });

  document.addEventListener('astro:page-load', initialize, {
    signal: lifecycle.signal,
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, {
      once: true,
      signal: lifecycle.signal,
    });
  } else {
    initialize();
  }
})();
    </script>
    <!-- STEP17_MOBILE_SCROLL_PHYSICS_END -->
  </body>
</html>
