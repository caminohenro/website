---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../data/siteConfig.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.siteTitleJp + ' | ' + siteConfig.siteTitleEn,
  description = siteConfig.tagline,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={siteConfig.crestImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+JP:wght@400;600&family=Shippori+Mincho:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="selection:bg-[#6E2B25] selection:text-[#E6DFCF]">
    <!-- LAYER 1: Fixed Road & Apple Background -->
    <div
      class="fixed-backdrop"
      style="background-image: url('/assets/apple-bg.jpeg'), url('/assets/apple-bg.svg');"
    ></div>
    <div class="backdrop-dimmer" id="dimmer"></div>

    <!-- PERSISTENT WEBSITE HEADER (Outside the Scroll) -->
    <Header />

    <!-- LAYER 2: THE INDIVIDUAL PAGE SCROLL WITH WOODEN ROLLERS -->
    <div class="scroll-stage">
      <div class="scroll-roller-top"></div>
      <main class="washi-scroll">
        <slot />
        <Footer />
      </main>
      <div class="scroll-roller-bottom"></div>
    </div>

    <!-- THE SURPRISE REVEAL AT THE BOTTOM OF EVERY PAGE -->
    <div class="apple-reveal-stage" aria-hidden="true">
      <div class="apple-whisper">
        お接待 • <em>Osettai</em> — The simplest gift of the road is enough.
      </div>
    </div>

    <script is:inline>
      // Gently brighten the road & apple as the user scrolls past the bottom roller
      window.addEventListener('scroll', function () {
        const dimmer = document.getElementById('dimmer');
        if (!dimmer) return;
        const scrollBottom = window.scrollY + window.innerHeight;
        const docHeight = document.documentElement.scrollHeight;
        const revealProgress = Math.max(0, Math.min(1, (scrollBottom - (docHeight - window.innerHeight * 0.85)) / (window.innerHeight * 0.6)));
        const centerAlpha = (0.58 - revealProgress * 0.48).toFixed(2);
        const edgeAlpha = (0.84 - revealProgress * 0.35).toFixed(2);
        dimmer.style.setProperty('--center-dim', centerAlpha);
        dimmer.style.setProperty('--edge-dim', edgeAlpha);
      });
    </script>
  
    <!-- MOBILE TOUCH PHYSICS ENGINE -->
    <script is:inline>
      (function() {
        if (window.innerWidth > 680) return;
        
        const stage = document.querySelector('.scroll-stage');
        const scroll = document.querySelector('.washi-scroll');
        const bottomRoller = document.querySelector('.scroll-stage > .scroll-roller-bottom');
        
        if (!stage || !scroll || !bottomRoller) return;

        // Tooltip Setup
        const style = document.createElement('style');
        style.innerHTML = `
          @keyframes arrowBounce { 0% { transform: translateY(0); } 100% { transform: translateY(6px); } }
          .physics-tooltip {
            position: absolute; left: 50%; transform: translateX(-50%);
            top: calc(100% + 15px); color: white; text-align: center;
            opacity: 0; transition: opacity 0.5s ease; pointer-events: none;
            white-space: nowrap; z-index: 20;
          }
          .physics-tooltip-arrow {
            font-size: 1.2rem; margin-bottom: 4px;
            animation: arrowBounce 0.7s infinite alternate ease-in-out;
          }
          .physics-tooltip-text {
            font-family: 'EB Garamond', Georgia, serif; font-style: italic;
            font-weight: 300; font-size: 1.1rem;
          }
        `;
        document.head.appendChild(style);

        const tooltip = document.createElement('div');
        tooltip.className = 'physics-tooltip';
        tooltip.innerHTML = '<div class="physics-tooltip-arrow">↓</div><div class="physics-tooltip-text">Drag to unfurl</div>';
        bottomRoller.appendChild(tooltip);

        // State Variables
        let isUnfurled = false;
        let hasDragged = false;
        let offsetY = 0; // Negative value representing how much the scroll is furled up
        let maxOffset = 0; // Max negative limit based on 30% of scroll height
        let startY = 0;
        let lastTouchY = 0;
        let lastTime = 0;
        let velocity = 0;
        let animationFrame = null;

        function applyTransform(y) {
          const hidden = Math.abs(y);
          scroll.style.clipPath = \`inset(0 -90px \${hidden}px -90px)\`;
          bottomRoller.style.transform = \`translateY(\${y}px)\`;
        }

        function checkUnfurled() {
          if (offsetY >= 0) {
            offsetY = 0;
            isUnfurled = true;
            scroll.style.clipPath = 'none';
            bottomRoller.style.transform = 'translateY(0)';
          }
        }

        // Dynamically calculate hidden amount if content loads asynchronously (like Forum threads)
        const observer = new ResizeObserver(() => {
          if (isUnfurled || hasDragged) return;
          const sh = scroll.scrollHeight;
          if (sh > window.innerHeight) {
            maxOffset = -(sh * 0.3); // Hide bottom 30% of the content
            offsetY = maxOffset;
            applyTransform(offsetY);
          }
        });
        observer.observe(scroll);

        // Fade in tooltip after 0.5s delay
        setTimeout(() => {
          if (!hasDragged && !isUnfurled && maxOffset < 0) {
            tooltip.style.opacity = '1';
          }
        }, 500);

        bottomRoller.addEventListener('touchstart', (e) => {
          if (isUnfurled) return;
          hasDragged = true;
          tooltip.style.opacity = '0'; // Permanently hide tooltip on first touch
          cancelAnimationFrame(animationFrame);
          
          startY = e.touches[0].clientY;
          lastTouchY = startY;
          lastTime = performance.now();
          velocity = 0;
        }, { passive: true });

        bottomRoller.addEventListener('touchmove', (e) => {
          if (isUnfurled) return;
          e.preventDefault(); // Lock native scrolling while unfurling
          
          const touchY = e.touches[0].clientY;
          const currentTime = performance.now();
          const dt = currentTime - lastTime;
          const deltaY = touchY - lastTouchY;

          offsetY += deltaY;
          if (offsetY > 0) offsetY = 0;
          if (offsetY < maxOffset * 1.5) offsetY = maxOffset * 1.5; // Slight elastic resistance past max

          if (dt > 0) {
            velocity = deltaY / dt; // px per millisecond
          }

          lastTouchY = touchY;
          lastTime = currentTime;
          applyTransform(offsetY);
        }, { passive: false });

        bottomRoller.addEventListener('touchend', () => {
          if (isUnfurled) return;
          
          const coast = () => {
            offsetY += velocity * 16; // approximate 60fps frame delta
            velocity *= 0.92; // Friction

            // Coasting fully open
            if (offsetY > 0) {
              offsetY = 0;
              applyTransform(offsetY);
              checkUnfurled();
              return;
            }
            
            // Re-furl boundary checking
            if (offsetY < maxOffset) {
              offsetY += (maxOffset - offsetY) * 0.1; // Smooth snap back up
              if (Math.abs(offsetY - maxOffset) < 1) offsetY = maxOffset;
            }

            applyTransform(offsetY);

            // Terminate coasting when velocity is dead
            if (Math.abs(velocity) < 0.1 && offsetY >= maxOffset) {
              checkUnfurled();
              return;
            }
            animationFrame = requestAnimationFrame(coast);
          };
          
          animationFrame = requestAnimationFrame(coast);
        });
      })();
    </script>
  </body>
</html>
