---
import Header from '../components/Header.astro';
import siteConfig from '../data/siteConfig.json';
import '../styles/global.css';

interface Props {
  title?: string;
  heading?: string;
  message?: string;
  plans?: string;
  previewHref?: string;
}

const {
  title = 'Coming Soon',
  heading = 'Coming soon',
  message = 'Henro is currently working on this page. <br />The road will be shorter than the path to Japan, but patience is still required.',
  plans = '',
  previewHref = '',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteConfig.siteTitleJp} | {siteConfig.siteTitleEn} — {title}</title>
    <link rel="icon" type="image/png" href="/assets/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- display=block on Dancing Script prevents the fallback font flash (FOUT) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&display=block"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+JP:wght@400;600&family=Shippori+Mincho:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      body.uc-body {
        background-color: var(--bg-outer-obsidian, #08090C);
        color: #F4F1EA;
        font-family: 'EB Garamond', Georgia, 'Yu Mincho', serif;
        line-height: 1.85;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        overflow-y: auto;
        min-height: 100vh;
        min-height: 100dvh;
      }

      .construction-content {
        position: relative;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: calc(100dvh - 84px);
        text-align: center;
        color: #F4F1EA;
        padding: 40px 20px 84px;
        opacity: 0;
      }

      /* Uses the exact stageFadeIn animation and --fade-duration from global.css */
      .construction-content.is-ready {
        animation: stageFadeIn var(--fade-duration, 0.8s) ease-out both;
      }

      .logo-large {
        width: 200px;
        margin-bottom: 20px;
        filter: drop-shadow(0px 4px 8px rgba(253, 252, 252, 0.8));
      }

      .construction-title {
        font-family: 'Dancing Script', cursive;
        font-size: clamp(2.8rem, 8vw, 4rem);
        font-weight: 600;
        margin-bottom: 12px;
        line-height: 1.2;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
      }

      .construction-text {
        font-family: 'EB Garamond', Georgia, 'Yu Mincho', serif;
        font-size: clamp(1.2rem, 3.8vw, 1.5rem);
        color: #dee2e7;
        max-width: 620px;
        line-height: 1.6;
        margin-bottom: 16px;
        text-shadow: 1px 1px 6px rgba(0, 0, 0, 0.85);
      }

      .construction-plans {
        font-family: 'EB Garamond', Georgia, 'Yu Mincho', serif;
        font-size: clamp(1.05rem, 3.4vw, 1.25rem);
        max-width: 600px;
        line-height: 1.65;
        color: rgba(244, 241, 234, 0.9);
        margin-top: 4px;
        margin-bottom: 18px;
        text-shadow: 1px 1px 6px rgba(0, 0, 0, 0.85);
      }

      .construction-preview-prompt {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 1rem;
        color: rgba(244, 241, 234, 0.78);
        margin-top: 14px;
        letter-spacing: 0.03em;
        text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.85);
      }

      .construction-preview-link {
        color: #eb1906;
        font-weight: 400;
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-color: rgba(219, 30, 13, 0.6);
        transition: color 0.2s ease, text-decoration-color 0.2s ease;
      }

      .construction-preview-link:hover {
        color: var(--color-crimson-light, #8C3B33);
        text-decoration-color: #8C3B33;
      }

      @media (prefers-reduced-motion: reduce) {
        .construction-content,
        .construction-content.is-ready {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
      }
    </style>
  </head>
  <body class="uc-body selection:bg-[#6E2B25] selection:text-[#E6DFCF]">
    <!-- LAYER 1: Fixed Road & Apple Background (uses classes from global.css) -->
    <div
      class="fixed-backdrop"
      style="background-image: url('/assets/apple-bg.jpeg'), url('/assets/apple-diff.jpg');"
    ></div>
    <div class="backdrop-dimmer"></div>

    <!-- PERSISTENT WEBSITE HEADER (Your existing Header.astro) -->
    <Header />

    <!-- COMING SOON CONTENT -->
    <main class="construction-content" id="uc-content">
      <img
        src="/assets/logo.png"
        onerror="this.onerror=null;this.src='/assets/crest.png';"
        alt="Henro Stamp"
        class="logo-large"
      />
      <h1 class="construction-title">{heading}</h1>
      <p class="construction-text" set:html={message} />

      {plans && <p class="construction-plans" set:html={plans} />}

      <slot />

      {previewHref && (
        <p class="construction-preview-prompt">
          Want a <a href={previewHref} class="construction-preview-link">sneak preview</a> of this page?
        </p>
      )}
    </main>

    <script is:inline>
      (function () {
        const content = document.getElementById('uc-content');
        if (!content) return;

        function reveal() {
          content.classList.add('is-ready');
        }

        // Wait for the cursive font to be ready (or 250ms max fallback) before fading in
        if (document.fonts && document.fonts.ready) {
          const fallbackTimer = setTimeout(reveal, 250);
          document.fonts.ready.then(function () {
            clearTimeout(fallbackTimer);
            reveal();
          });
        } else {
          reveal();
        }
      })();
    </script>
  </body>
</html>
