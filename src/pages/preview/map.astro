    <!-- Leaflet 1.9.4 JS -->
    <script
      is:inline
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
    ></script>

    <script
      is:inline
      define:vars={{
        walkedTrack,
        milestones,
        plannedWaypoints,
      }}
    >
      (function () {
        function initMapPage() {
          if (typeof window.L === 'undefined') {
            setTimeout(initMapPage, 50);
            return;
          }

          const L = window.L;
          const html = document.documentElement;
          const mapEl = document.getElementById('henro-map');
          const horizontalSlot = document.getElementById('horizontal-map-slot');
          const verticalSlot = document.getElementById('vertical-map-slot');
          const emakimonoViewport = document.getElementById('emakimono-paper-viewport');
          const kakemonoPaper = document.getElementById('kakemono-paper');
          const rotateTooltip = document.getElementById('mobile-rotate-tooltip');
          const dismissTooltipBtn = document.getElementById('dismiss-rotate-tooltip');

          if (!mapEl || !horizontalSlot || !verticalSlot) return;

          // Mount map element into initial active slot before Leaflet initializes
          let currentMode = html.getAttribute('data-map-scroll-mode') || 'horizontal';
          (currentMode === 'horizontal' ? horizontalSlot : verticalSlot).appendChild(mapEl);

          const map = L.map(mapEl, {
            scrollWheelZoom: true,
            zoomControl: true,
            worldCopyJump: true,
          });

          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            attribution: '&copy; OpenStreetMap contributors',
          }).addTo(map);

          // 1. Planned Eurasia Corridor (Dashed ink line: SJPP -> Europe -> North Caspian -> N. India -> S. Korea -> Shikoku)
          const plannedLatLngs = plannedWaypoints.map(function (wp) {
            return [wp[0], wp[1]];
          });

          const plannedPolyline = L.polyline(plannedLatLngs, {
            color: '#524D46',
            weight: 2.5,
            opacity: 0.85,
            dashArray: '6, 8',
          }).addTo(map);

          plannedWaypoints.forEach(function (wp, idx) {
            // Skip duplicate dot on index 0 (Saint-Jean-Pied-de-Port already has the pulsing current marker)
            if (idx === 0) return;
            const isDestination = idx === plannedWaypoints.length - 1;
            L.circleMarker([wp[0], wp[1]], {
              radius: isDestination ? 6 : 3.5,
              color: isDestination ? '#6E2B25' : '#1C1A17',
              weight: isDestination ? 2 : 1.25,
              fillColor: isDestination ? '#D4AF37' : '#E6DFCF',
              fillOpacity: 0.95,
            })
              .bindTooltip(wp[2], {
                direction: 'top',
                offset: [0, -4],
              })
              .addTo(map);
          });

          // 2. Detailed Walked Iberian Trail (Solid Aged Bengala Crimson polyline)
          const walkedPolyline = L.polyline(walkedTrack, {
            color: '#6E2B25',
            weight: 4,
            opacity: 0.96,
            lineJoin: 'round',
            lineCap: 'round',
          }).addTo(map);

          // 3. Milestone Crimson Stamps & Pulsing Current Position Marker
          const stampIcon = L.divIcon({
            className: '',
            html: '<div class="henro-stamp-marker" title="Milestone Stamp">印</div>',
            iconSize: [22, 22],
            iconAnchor: [11, 11],
            popupAnchor: [0, -12],
          });

          const currentIcon = L.divIcon({
            className: '',
            html: '<div class="henro-current-marker" title="Henro Current Position">今</div>',
            iconSize: [28, 28],
            iconAnchor: [14, 14],
            popupAnchor: [0, -14],
          });

          const milestoneMarkers = [];
          let currentMarker = null;
          let currentMilestone = null;

          milestones.forEach(function (m) {
            const badgeHtml = m.isCurrent
              ? '<span style="color:#6E2B25;font-weight:700;">● CURRENT LOCATION</span> &middot; '
              : '';

            const popupHtml =
              '<div style="font-family:\'EB Garamond\',Georgia,serif;min-width:210px;max-width:265px;padding:2px;">' +
              '<div style="font-family:\'JetBrains Mono\',monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:#524D46;margin-bottom:4px;">' +
              badgeHtml +
              '<span>' + m.leg + '</span> &middot; <span style="color:#6E2B25;font-weight:600;">KM ' + m.kmMarker + '</span>' +
              '</div>' +
              '<div style="font-family:\'Cormorant Garamond\',Georgia,serif;font-size:18px;font-weight:700;color:#1C1A17;line-height:1.25;margin-bottom:6px;">' +
              m.title +
              '</div>' +
              '<p style="font-size:14px;line-height:1.5;color:#1C1A17;margin:0;">' +
              m.summary +
              '</p>' +
              '</div>';

            const marker = L.marker([m.lat, m.lng], {
              icon: m.isCurrent ? currentIcon : stampIcon,
              zIndexOffset: m.isCurrent ? 1000 : 100,
            })
              .bindPopup(popupHtml, {
                className: 'henro-washi-popup',
                maxWidth: 280,
              })
              .addTo(map);

            milestoneMarkers.push(marker);
            if (m.isCurrent) {
              currentMarker = marker;
              currentMilestone = m;
            }
          });

          // Camera control helpers
          let activeCamera = 'corridor';
          const allCorridorBounds = L.featureGroup([plannedPolyline, walkedPolyline]).getBounds();

          function updateCameraButtonStyles(target) {
            activeCamera = target;
            document.querySelectorAll('.cam-btn').forEach(function (btn) {
              btn.classList.toggle('is-active', btn.getAttribute('data-camera') === target);
            });
          }

          function applyCamera(target, animate) {
            updateCameraButtonStyles(target);
            if (target === 'walked' && walkedTrack.length > 0) {
              map.fitBounds(walkedPolyline.getBounds(), {
                padding: [40, 40],
                maxZoom: 8,
                animate: Boolean(animate),
              });
            } else if (target === 'current' && currentMilestone) {
              map.setView([currentMilestone.lat, currentMilestone.lng], 10, {
                animate: Boolean(animate),
              });
              if (currentMarker) currentMarker.openPopup();
            } else {
              map.fitBounds(allCorridorBounds, {
                padding: [28, 28],
                animate: Boolean(animate),
              });
            }
          }

          function triggerUnfurl(mode) {
            if (mode === 'horizontal' && emakimonoViewport) {
              emakimonoViewport.classList.remove('is-unfurling');
              void emakimonoViewport.offsetWidth;
              emakimonoViewport.classList.add('is-unfurling');
            } else if (mode === 'vertical' && kakemonoPaper) {
              kakemonoPaper.classList.remove('is-unfurling');
              void kakemonoPaper.offsetWidth;
              kakemonoPaper.classList.add('is-unfurling');
            }
          }

          function syncMapSize(refitCamera) {
            map.invalidateSize({ animate: false });
            if (refitCamera) {
              applyCamera(activeCamera, false);
            }
          }

          function setScrollMode(nextMode, animateUnfurl) {
            currentMode = nextMode === 'vertical' ? 'vertical' : 'horizontal';
            html.setAttribute('data-map-scroll-mode', currentMode);

            const targetSlot = currentMode === 'horizontal' ? horizontalSlot : verticalSlot;
            if (mapEl.parentElement !== targetSlot) {
              targetSlot.appendChild(mapEl);
            }

            // Enable scroll wheel zoom primarily in full-screen horizontal mode so vertical page scrolling stays smooth
            if (currentMode === 'horizontal') {
              map.scrollWheelZoom.enable();
            } else {
              map.scrollWheelZoom.disable();
            }

            if (animateUnfurl) {
              triggerUnfurl(currentMode);
            }

            // Refresh Leaflet tiles during & immediately after scroll unfurl
            setTimeout(function () { syncMapSize(false); }, 120);
            setTimeout(function () { syncMapSize(true); }, 650);
            setTimeout(function () { syncMapSize(false); }, 1350);
          }

          // Wire up mode toggle buttons
          document.querySelectorAll('[data-switch-mode]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              const targetMode = btn.getAttribute('data-switch-mode');
              setScrollMode(targetMode, true);
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });
          });

          // Wire up camera buttons in both views
          document.querySelectorAll('[data-camera]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              const cam = btn.getAttribute('data-camera') || 'corridor';
              applyCamera(cam, true);
            });
          });

          // Wire up milestone quick-jump chips in the horizontal scroll footer
          document.querySelectorAll('[data-milestone-index]').forEach(function (chip) {
            chip.addEventListener('click', function () {
              const idx = Number(chip.getAttribute('data-milestone-index'));
              const marker = milestoneMarkers[idx];
              const m = milestones[idx];
              if (marker && m) {
                map.setView([m.lat, m.lng], m.isCurrent ? 10 : 9, { animate: true });
                marker.openPopup();
              }
            });
          });

          // Dismissible mobile portrait rotate tooltip
          if (dismissTooltipBtn && rotateTooltip) {
            dismissTooltipBtn.addEventListener('click', function () {
              rotateTooltip.classList.add('is-dismissed');
            });
          }

          // Automatic orientation switching on mobile/tablet rotation
          const landscapeQuery = window.matchMedia('(orientation: landscape)');
          function handleOrientationChange() {
            const shortestSide = Math.min(window.innerWidth, window.innerHeight);
            if (shortestSide <= 768) {
              const autoMode = landscapeQuery.matches ? 'horizontal' : 'vertical';
              if (autoMode !== currentMode) {
                setScrollMode(autoMode, true);
              } else {
                setTimeout(function () { syncMapSize(false); }, 200);
              }
            } else {
              setTimeout(function () { syncMapSize(false); }, 150);
            }
          }

          if (typeof landscapeQuery.addEventListener === 'function') {
            landscapeQuery.addEventListener('change', handleOrientationChange);
          }
          window.addEventListener('resize', function () {
            setTimeout(function () { syncMapSize(false); }, 150);
          });

          // Initial unfurl + default view (Full Eurasia corridor)
          setScrollMode(currentMode, true);
          applyCamera('corridor', false);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMapPage);
        } else {
          initMapPage();
        }
      })();
    </script>
  </body>
</html>