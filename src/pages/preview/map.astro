  <!-- Map Engine + Centered-to-Left Horizontal Scroll Physics + Mode Toggle -->
  <script
    is:inline
    define:vars={{
      walkedPath,
      milestones,
      plannedWaypoints,
      currentCoords: stats.currentCoords || [43.1631, -1.2381],
    }}
  >
    (function () {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const html = document.documentElement;

      const hStage = document.getElementById('emakimono-stage');
      const hPaper = document.getElementById('emakimono-paper');
      const hRollerLeft = document.getElementById('h-roller-left');
      const hRollerRight = document.getElementById('h-roller-right');
      const hClosedHint = document.getElementById('h-closed-hint');
      const horizontalSlot = document.getElementById('horizontal-map-slot');
      const verticalSlot = document.getElementById('vertical-map-slot');
      const mapEl = document.getElementById('henro-map');
      const rotateTooltip = document.getElementById('mobile-rotate-tooltip');
      const dismissTooltipBtn = document.getElementById('dismiss-rotate-tooltip');

      let mapInstance = null;
      let plannedPolyline = null;
      let walkedPolyline = null;
      let milestoneMarkers = [];
      let activeCamera = 'corridor';
      let userLockedMode = false;

      // ------------------------------------------------------------------
      // 1. CENTERED <-> LEFT DRAMATIC HORIZONTAL SCROLL ENGINE
      // ------------------------------------------------------------------
      // hProgress: 0 = rolled closed, 1 = fully unrolled left->right
      // hShiftFrac: 1 = closed bundle centered on screen, 0 = anchored left
      let hProgress = 0;
      let hShiftFrac = 1;
      let hIsOpen = false;
      let hAnimFrame = 0;
      let hDelayTimer = 0;
      let hAnimEpoch = 0;

      function cubicBezierY(t, p1x, p1y, p2x, p2y) {
        if (t <= 0) return 0;
        if (t >= 1) return 1;
        let lo = 0;
        let hi = 1;
        for (let i = 0; i < 24; i++) {
          const mid = (lo + hi) / 2;
          const inv = 1 - mid;
          const x =
            3 * inv * inv * mid * p1x +
            3 * inv * mid * mid * p2x +
            mid * mid * mid;
          if (x < t) lo = mid;
          else hi = mid;
        }
        const u = (lo + hi) / 2;
        const inv = 1 - u;
        return (
          3 * inv * inv * u * p1y +
          3 * inv * u * u * p2y +
          u * u * u
        );
      }

      function renderHorizontalFrame(progress, shiftFrac) {
        if (!hStage || !hPaper || !hRollerRight) return;

        hProgress = Math.max(0, Math.min(1, progress));
        hShiftFrac = Math.max(0, Math.min(1, shiftFrac));

        const paperWidth = hPaper.offsetWidth || 0;
        const hiddenRight = paperWidth * (1 - hProgress);
        const centerOffsetX = (paperWidth / 2) * hShiftFrac;

        hStage.style.transform =
          centerOffsetX > 0.05
            ? 'translateX(' + centerOffsetX.toFixed(2) + 'px)'
            : 'translateX(0px)';

        if (hProgress >= 0.999) {
          hPaper.style.clipPath = 'none';
          hPaper.style.webkitClipPath = 'none';
          hPaper.style.pointerEvents = '';
          hRollerRight.style.transform = 'translateX(0px)';
        } else {
          const clip = 'inset(-40px ' + hiddenRight.toFixed(2) + 'px -40px 0px)';
          hPaper.style.clipPath = clip;
          hPaper.style.webkitClipPath = clip;
          hPaper.style.pointerEvents = hProgress < 0.05 ? 'none' : '';
          hRollerRight.style.transform = 'translateX(' + (-hiddenRight).toFixed(2) + 'px)';
        }
      }

      function stopHorizontalAnim() {
        hAnimEpoch += 1;
        window.cancelAnimationFrame(hAnimFrame);
        window.clearTimeout(hDelayTimer);
        hAnimFrame = 0;
        hDelayTimer = 0;
      }

      function setClosedHintVisible(show) {
        if (!hClosedHint) return;
        hClosedHint.classList.toggle('is-visible', Boolean(show));
      }

      function runPhase(epoch, duration, onUpdate, onDone) {
        if (duration <= 0) {
          onUpdate(1);
          if (onDone) onDone();
          return;
        }
        const startedAt = performance.now();
        function step(now) {
          if (epoch !== hAnimEpoch) return;
          const t = Math.min(1, (now - startedAt) / duration);
          onUpdate(t);
          if (t < 1) {
            hAnimFrame = window.requestAnimationFrame(step);
          } else {
            hAnimFrame = 0;
            if (onDone) onDone();
          }
        }
        hAnimFrame = window.requestAnimationFrame(step);
      }

      // Open: Centered -> Glide Left -> Pause -> Slow Dramatic Unfurl Left->Right
      function openHorizontalScroll(withInitialPause) {
        stopHorizontalAnim();
        const epoch = hAnimEpoch;
        hIsOpen = true;
        setClosedHintVisible(false);

        if (reducedMotion.matches) {
          renderHorizontalFrame(1, 0);
          if (mapInstance) setTimeout(function () { mapInstance.invalidateSize({ animate: false }); }, 60);
          return;
        }

        const startShift = hShiftFrac;
        const startProgress = hProgress;
        const pauseBeforeMove = withInitialPause ? 300 : 0;
        const moveDuration = startShift > 0.01 ? Math.round(880 * startShift) : 0;
        const unfurlDuration = Math.max(700, Math.round(3200 * (1 - startProgress)));

        function beginUnfurl() {
          if (epoch !== hAnimEpoch) return;
          runPhase(
            epoch,
            unfurlDuration,
            function (t) {
              const eased = cubicBezierY(t, 0.22, 1, 0.36, 1);
              renderHorizontalFrame(startProgress + (1 - startProgress) * eased, 0);
            },
            function () {
              renderHorizontalFrame(1, 0);
              if (mapInstance) {
                mapInstance.invalidateSize({ animate: false });
              }
            }
          );
        }

        function beginGlideLeft() {
          if (epoch !== hAnimEpoch) return;
          if (moveDuration === 0) {
            beginUnfurl();
            return;
          }
          runPhase(
            epoch,
            moveDuration,
            function (t) {
              const eased = 1 - Math.pow(1 - t, 3);
              renderHorizontalFrame(startProgress, startShift * (1 - eased));
            },
            function () {
              hDelayTimer = window.setTimeout(beginUnfurl, 140);
            }
          );
        }

        if (pauseBeforeMove > 0) {
          hDelayTimer = window.setTimeout(beginGlideLeft, pauseBeforeMove);
        } else {
          beginGlideLeft();
        }
      }

      // Close: Furl Right->Left -> Glide Back to Center
      function closeHorizontalScroll() {
        stopHorizontalAnim();
        const epoch = hAnimEpoch;
        hIsOpen = false;
        setClosedHintVisible(false);

        if (reducedMotion.matches) {
          renderHorizontalFrame(0, 1);
          setClosedHintVisible(true);
          return;
        }

        const startProgress = hProgress;
        const startShift = hShiftFrac;
        const furlDuration = startProgress > 0.01 ? Math.max(320, Math.round(1050 * startProgress)) : 0;
        const centerDuration = Math.max(300, Math.round(860 * (1 - startShift)));

        function beginGlideCenter() {
          if (epoch !== hAnimEpoch) return;
          runPhase(
            epoch,
            centerDuration,
            function (t) {
              const eased = 1 - Math.pow(1 - t, 3);
              renderHorizontalFrame(0, startShift + (1 - startShift) * eased);
            },
            function () {
              renderHorizontalFrame(0, 1);
              setClosedHintVisible(true);
            }
          );
        }

        if (furlDuration > 0) {
          runPhase(
            epoch,
            furlDuration,
            function (t) {
              const eased = t * t * (3 - 2 * t);
              renderHorizontalFrame(startProgress * (1 - eased), startShift);
            },
            function () {
              hDelayTimer = window.setTimeout(beginGlideCenter, 90);
            }
          );
        } else {
          beginGlideCenter();
        }
      }

      function toggleHorizontalRoller(event) {
        if (
          event.type === 'keydown' &&
          event.key !== 'Enter' &&
          event.key !== ' '
        ) {
          return;
        }
        event.preventDefault();
        if (hIsOpen) {
          closeHorizontalScroll();
        } else {
          openHorizontalScroll(false);
        }
      }

      [hRollerLeft, hRollerRight].forEach(function (roller) {
        if (!roller) return;
        roller.addEventListener('click', toggleHorizontalRoller);
        roller.addEventListener('keydown', toggleHorizontalRoller);
      });

      if (hClosedHint) {
        hClosedHint.addEventListener('click', function () {
          openHorizontalScroll(false);
        });
      }

      // ------------------------------------------------------------------
      // 2. VIEW MODE SWITCHING & SINGLE-MAP REPARENTING
      // ------------------------------------------------------------------
      function mountMapForCurrentView() {
        const mode = html.getAttribute('data-map-view') || 'horizontal';
        const targetSlot = mode === 'horizontal' ? horizontalSlot : verticalSlot;

        if (mapEl && targetSlot && mapEl.parentElement !== targetSlot) {
          targetSlot.appendChild(mapEl);
        }

        if (mapInstance) {
          if (mode === 'horizontal') {
            mapInstance.scrollWheelZoom.enable();
          } else {
            mapInstance.scrollWheelZoom.disable();
          }

          setTimeout(function () {
            mapInstance.invalidateSize({ animate: false });
            applyCamera(activeCamera, false);
          }, 90);
        }
      }

      function setMapView(mode, isManual) {
        if (isManual) userLockedMode = true;
        const previous = html.getAttribute('data-map-view');
        html.setAttribute('data-map-view', mode);
        mountMapForCurrentView();

        if (mode === 'horizontal') {
          if (previous !== 'horizontal' || !hIsOpen) {
            renderHorizontalFrame(0, 1);
            openHorizontalScroll(true);
          }
        } else {
          stopHorizontalAnim();
          setClosedHintVisible(false);

          const vPaper = document.querySelector('body > .scroll-stage > main.washi-scroll');
          if (
            window.innerWidth > 680 &&
            vPaper &&
            typeof window.prepareScrollUnfurl === 'function'
          ) {
            vPaper.style.animation = 'none';
            void vPaper.offsetHeight;
            window.prepareScrollUnfurl(vPaper);
            vPaper.style.animation = '';
          }

          window.dispatchEvent(new Event('resize'));
        }
      }

      document.querySelectorAll('[data-switch-mode]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const targetMode = btn.getAttribute('data-switch-mode') || 'horizontal';
          setMapView(targetMode, true);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });

      if (dismissTooltipBtn && rotateTooltip) {
        dismissTooltipBtn.addEventListener('click', function () {
          rotateTooltip.classList.add('is-dismissed');
        });
      }

      function handleViewportOrientation() {
        if (html.getAttribute('data-map-view') === 'horizontal' && !hAnimFrame) {
          renderHorizontalFrame(hIsOpen ? 1 : 0, hIsOpen ? 0 : 1);
        }
        if (mapInstance) {
          mapInstance.invalidateSize({ animate: false });
        }
        if (userLockedMode) return;

        const isPortraitMobile =
          window.innerWidth <= 680 && window.innerHeight > window.innerWidth;
        const recommended = isPortraitMobile ? 'vertical' : 'horizontal';
        if (html.getAttribute('data-map-view') !== recommended) {
          setMapView(recommended, false);
        }
      }

      window.addEventListener('resize', handleViewportOrientation, { passive: true });
      window.addEventListener('orientationchange', function () {
        setTimeout(handleViewportOrientation, 180);
      });

      // ------------------------------------------------------------------
      // 3. LEAFLET CARTOGRAPHY INITIALIZATION
      // ------------------------------------------------------------------
      function updateCameraButtonStyles(camName) {
        document.querySelectorAll('.cam-btn[data-camera]').forEach(function (btn) {
          btn.classList.toggle('is-active', btn.getAttribute('data-camera') === camName);
        });
      }

      function applyCamera(camName, animate) {
        activeCamera = camName;
        updateCameraButtonStyles(camName);
        if (!mapInstance) return;

        if (camName === 'corridor' && plannedPolyline) {
          const allBounds = plannedPolyline.getBounds();
          if (walkedPolyline) allBounds.extend(walkedPolyline.getBounds());
          mapInstance.fitBounds(allBounds, {
            padding: [28, 28],
            animate: animate !== false,
          });
        } else if (camName === 'walked' && walkedPolyline) {
          mapInstance.fitBounds(walkedPolyline.getBounds(), {
            padding: [40, 40],
            maxZoom: 8,
            animate: animate !== false,
          });
        } else if (camName === 'current') {
          mapInstance.setView(currentCoords, 10, {
            animate: animate !== false,
          });
          const curIdx = milestones.findIndex(function (m) {
            return Boolean(m.isCurrent);
          });
          if (curIdx >= 0 && milestoneMarkers[curIdx]) {
            milestoneMarkers[curIdx].openPopup();
          }
        }
      }

      function initHenroMap() {
        if (typeof window.L === 'undefined') {
          setTimeout(initHenroMap, 50);
          return;
        }
        if (!mapEl) return;

        mountMapForCurrentView();

        const initialMode = html.getAttribute('data-map-view') || 'horizontal';
        const L = window.L;
        mapInstance = L.map(mapEl, {
          scrollWheelZoom: initialMode === 'horizontal',
          zoomControl: true,
          worldCopyJump: true,
        });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; OpenStreetMap contributors',
        }).addTo(mapInstance);

        // 1. Planned Eurasia Corridor (Dashed ink line: SJPP -> North Caspian -> N. India -> S. Korea -> Shikoku)
        const plannedLatLngs = plannedWaypoints.map(function (wp) {
          return [wp[0], wp[1]];
        });

        plannedPolyline = L.polyline(plannedLatLngs, {
          color: '#524D46',
          weight: 2.5,
          opacity: 0.86,
          dashArray: '6, 8',
        }).addTo(mapInstance);

        plannedWaypoints.forEach(function (wp, idx) {
          if (idx === 0) return;
          const isDestination = idx === plannedWaypoints.length - 1;
          L.circleMarker([wp[0], wp[1]], {
            radius: isDestination ? 6 : 3.5,
            color: isDestination ? '#6E2B25' : '#1C1A17',
            weight: isDestination ? 2 : 1.25,
            fillColor: isDestination ? '#D4AF37' : '#E6DFCF',
            fillOpacity: 0.95,
          })
            .bindTooltip(wp[2], { direction: 'top', offset: [0, -4] })
            .addTo(mapInstance);
        });

        // 2. Detailed Walked Iberian Path (Solid Bengala Crimson)
        const walkedLatLngs = walkedPath.map(function (pt) {
          return [pt[0], pt[1]];
        });

        walkedPolyline = L.polyline(walkedLatLngs, {
          color: '#6E2B25',
          weight: 4,
          opacity: 0.96,
          lineJoin: 'round',
          lineCap: 'round',
        }).addTo(mapInstance);

        // 3. Static Paper-Map Ink Stamps & Current Location Seal (No Pulsing)
        const stampIcon = L.divIcon({
          className: '',
          html: '<div class="henro-stamp-marker" title="Milestone Stamp">印</div>',
          iconSize: [22, 22],
          iconAnchor: [11, 11],
          popupAnchor: [0, -12],
        });

        const currentIcon = L.divIcon({
          className: '',
          html: '<div class="henro-current-marker" title="Current Position">今</div>',
          iconSize: [28, 28],
          iconAnchor: [14, 14],
          popupAnchor: [0, -14],
        });

        milestoneMarkers = [];

        milestones.forEach(function (ms) {
          const badgeHtml = ms.isCurrent
            ? '<span style="color:#6E2B25;font-weight:700;">CURRENT LOCATION</span> &middot; '
            : '';

          const popupHtml =
            '<div style="font-family:\'EB Garamond\',Georgia,serif;min-width:210px;max-width:265px;padding:2px;">' +
            '<div style="font-family:\'JetBrains Mono\',monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:#524D46;margin-bottom:4px;">' +
            badgeHtml +
            '<span>' + ms.leg + '</span> &middot; <span style="color:#6E2B25;font-weight:600;">KM ' + ms.kmMarker + '</span>' +
            '</div>' +
            '<div style="font-family:\'Cormorant Garamond\',Georgia,serif;font-size:18px;font-weight:700;color:#1C1A17;line-height:1.25;margin-bottom:6px;">' +
            ms.title +
            '</div>' +
            '<p style="font-size:14px;line-height:1.5;color:#1C1A17;margin:0;">' +
            ms.summary +
            '</p>' +
            '</div>';

          const marker = L.marker([ms.lat, ms.lng], {
            icon: ms.isCurrent ? currentIcon : stampIcon,
            zIndexOffset: ms.isCurrent ? 1000 : 100,
          })
            .bindPopup(popupHtml, {
              className: 'henro-washi-popup',
              maxWidth: 280,
            })
            .addTo(mapInstance);

          milestoneMarkers.push(marker);
        });

        // Wire up camera buttons in both views
        document.querySelectorAll('.cam-btn[data-camera]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            applyCamera(btn.getAttribute('data-camera') || 'corridor', true);
          });
        });

        // Wire up clickable milestone quick-jump chips in both views
        document.querySelectorAll('[data-milestone-index]').forEach(function (chip) {
          chip.addEventListener('click', function () {
            const idx = Number(chip.getAttribute('data-milestone-index'));
            const marker = milestoneMarkers[idx];
            const ms = milestones[idx];
            if (marker && ms) {
              mapInstance.setView([ms.lat, ms.lng], ms.isCurrent ? 10 : 9, {
                animate: true,
              });
              marker.openPopup();
            }
          });
        });

        // Default camera: full Eurasia corridor
        applyCamera('corridor', false);

        // Start centered & closed, glide left, then dramatically unfurl left-to-right
        if (initialMode === 'horizontal') {
          renderHorizontalFrame(0, 1);
          openHorizontalScroll(true);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHenroMap);
      } else {
        initHenroMap();
      }
    })();
  </script>
</BaseLayout>