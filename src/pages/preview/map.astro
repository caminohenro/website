---
import BaseLayout from '../../layouts/BaseLayout.astro';
import routeData from '../../data/route.json';
import newsletterLogData from '../../data/newsletter-log.json';

const stats = routeData.stats || {
  totalPlannedKm: 17500,
  completedKm: 1341,
  daysOnTrail: 55,
  countriesCrossed: 3,
  currentLocation: 'Saint-Jean-Pied-de-Port, France',
  currentCoords: [43.1631, -1.2381],
};

const walkedLegs = Array.isArray(routeData.walkedLegs) ? routeData.walkedLegs : [];
const walkedPath = Array.isArray(routeData.walkedPath)
  ? routeData.walkedPath
  : Array.isArray(routeData.walkedTrack)
    ? routeData.walkedTrack
    : [];
const milestones = Array.isArray(routeData.milestones) ? routeData.milestones : [];
const plannedWaypoints = Array.isArray(routeData.plannedWaypoints)
  ? routeData.plannedWaypoints
  : [];

const newsletterEntries = Array.isArray(newsletterLogData?.entries)
  ? newsletterLogData.entries
  : [];
const substackHomeUrl =
  newsletterLogData?.substackHomeUrl || 'https://caminohenro.substack.com';
const subscribeUrl =
  newsletterLogData?.subscribeUrl || 'https://caminohenro.substack.com/subscribe';

const rawPct =
  stats.totalPlannedKm > 0
    ? (stats.completedKm / stats.totalPlannedKm) * 100
    : 0;
const formattedPct = rawPct.toFixed(2);
const visualBarPct = Math.max(rawPct, 2.0);
const remainingKm = Math.max(0, stats.totalPlannedKm - stats.completedKm);

function getChipLabel(ms: { shortLabel?: string; title: string }) {
  if (ms.shortLabel) return ms.shortLabel;
  return ms.title
    .replace(/\s*\([^)]*\)/g, '')
    .split(',')[0]
    .replace('Saint-Jean-Pied-de-Port', 'SJPP')
    .replace('Santiago de Compostela', 'Santiago')
    .replace('Cape Finisterra', 'Finisterra')
    .trim();
}
---

<BaseLayout
  title="Eurasia Route Map | CAMINO HENRO"
  description="Interactive overland cartography tracing Henro's continuous footpath from Coimbra through Santiago, Muxía, Finisterra, and Saint-Jean-Pied-de-Port across Eurasia to Shikoku, Japan."
  startClosed={false}
  enablePhysics={true}
>
  <!-- Leaflet 1.9.4 CSS -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  <!-- ====================================================================== -->
  <!-- MODE 1: HORIZONTAL FULL-SCREEN EMAKIMONO MAP SCROLL (pre-scroll slot)  -->
  <!-- Zero extra bars above the scroll; toggle lives inside the top bar.     -->
  <!-- ====================================================================== -->
  <div slot="pre-scroll">
    <!-- Pre-paint orientation check -->
    <script is:inline>
      (function setInitialMapView() {
        var isPortraitMobile =
          window.innerWidth <= 680 && window.innerHeight > window.innerWidth;
        document.documentElement.setAttribute(
          'data-map-view',
          isPortraitMobile ? 'vertical' : 'horizontal'
        );
      })();
    </script>

    <section
      id="horizontal-scroll-view"
      class="emakimono-shell"
      aria-label="Full-Screen Horizontal Eurasia Map Scroll"
    >
      <div class="emakimono-stage" id="emakimono-stage">
        <!-- Left Ornate Vertical Wooden Roller -->
        <div
          class="emakimono-roller emakimono-roller-left"
          id="h-roller-left"
          role="button"
          tabindex="0"
          aria-label="Furl or unfurl horizontal map scroll"
          title="Click to roll up or unfurl the map scroll"
        >
          <span class="roller-finial roller-finial-top"></span>
          <span class="roller-cap roller-cap-top"></span>
          <span class="roller-ferrule"></span>
          <span class="roller-silk-band"></span>
          <span class="roller-shaft"></span>
          <span class="roller-silk-band"></span>
          <span class="roller-ferrule"></span>
          <span class="roller-cap roller-cap-bottom"></span>
          <span class="roller-finial roller-finial-bottom"></span>
        </div>

        <!-- Unfurling Horizontal Washi Paper Canvas -->
        <div class="emakimono-paper" id="emakimono-paper">
          <!-- Compact Top Cartographic Header & Inline Mode Toggle -->
          <div class="emakimono-topbar">
            <div class="emakimono-brand">
              <span class="font-jp text-xs text-[#6E2B25] tracking-widest">行程図</span>
              <h1 class="font-heading text-xl lg:text-2xl font-bold uppercase tracking-wider text-[#1C1A17] leading-none">
                Eurasia Route Map
              </h1>
              <span class="hidden xl:inline-flex items-center gap-1.5 font-mono text-[11px] text-[#524D46] border-l border-[#1C1A17]/20 pl-3 ml-1">
                <span class="ink-seal-dot" aria-hidden="true"></span>
                <span>Now: <strong class="text-[#6E2B25]">{stats.currentLocation}</strong></span>
                <span>·</span>
                <span>{stats.completedKm.toLocaleString('en-US')} / {stats.totalPlannedKm.toLocaleString('en-US')} km</span>
              </span>
            </div>

            <div class="emakimono-controls font-mono text-[11px]">
              <button
                type="button"
                data-camera="corridor"
                class="cam-btn is-active"
              >
                Full Eurasia
              </button>
              <button
                type="button"
                data-camera="walked"
                class="cam-btn"
              >
                Walked (Iberia)
              </button>
              <button
                type="button"
                data-camera="current"
                class="cam-btn"
              >
                Current Spot
              </button>
              <button
                type="button"
                data-switch-mode="vertical"
                class="mode-toggle-btn"
                title="Switch to Vertical Scroll for route details and monthly newsletter log"
              >
                ↕ Vertical Info &amp; Log
              </button>
            </div>
          </div>

          <!-- Full-Canvas Map Mount Slot -->
          <div id="horizontal-map-slot" class="emakimono-map-slot">
            <div
              id="henro-map"
              class="henro-map-canvas"
              aria-label="Interactive Eurasia Pilgrimage Map"
            ></div>
          </div>

          <!-- Slim Bottom Legend + Quick-Jump Milestone Bar -->
          <div class="emakimono-bottombar font-mono text-[11px]">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[#524D46]">
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-4 h-[3px] bg-[#6E2B25]"></span>
                <span>Walked ({stats.completedKm.toLocaleString('en-US')} km)</span>
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-4 border-t-2 border-dashed border-[#524D46]"></span>
                <span>Planned (North Caspian → N. India → S. Korea → Shikoku)</span>
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="ink-seal-dot" aria-hidden="true"></span>
                <span>Current Position</span>
              </span>
            </div>

            <div class="milestone-chips" aria-label="Jump to walked milestone">
              {milestones.map((ms, idx) => (
                <button
                  type="button"
                  data-milestone-index={idx}
                  class:list={[
                    'milestone-chip',
                    ms.isCurrent && 'milestone-chip-current',
                  ]}
                  title={`${ms.title} (KM ${ms.kmMarker})`}
                >
                  {getChipLabel(ms)}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Right Ornate Vertical Wooden Roller -->
        <div
          class="emakimono-roller emakimono-roller-right"
          id="h-roller-right"
          role="button"
          tabindex="0"
          aria-label="Furl or unfurl horizontal map scroll"
          title="Click to roll up or unfurl the map scroll"
        >
          <span class="roller-finial roller-finial-top"></span>
          <span class="roller-cap roller-cap-top"></span>
          <span class="roller-ferrule"></span>
          <span class="roller-silk-band"></span>
          <span class="roller-shaft"></span>
          <span class="roller-silk-band"></span>
          <span class="roller-ferrule"></span>
          <span class="roller-cap roller-cap-bottom"></span>
          <span class="roller-finial roller-finial-bottom"></span>
        </div>
      </div>

      <!-- Quiet centered prompt shown only when the horizontal scroll is rolled closed -->
      <button
        type="button"
        id="h-closed-hint"
        class="h-closed-hint"
        aria-label="Unfurl the horizontal map scroll"
      >
        <span class="font-jp text-[#D4AF37]">巻</span>
        <span>Click rollers to unfurl map</span>
      </button>
    </section>
  </div>

  <!-- ====================================================================== -->
  <!-- MODE 2: VERTICAL SCROLL CONTENT (Native BaseLayout & ScrollPhysics)    -->
  <!-- ====================================================================== -->

  <!-- Mobile Portrait Orientation Tooltip (inside top of vertical scroll) -->
  <div
    id="mobile-rotate-tooltip"
    class="mobile-rotate-tooltip"
    role="status"
  >
    <div class="flex items-start gap-2.5">
      <span class="rotate-icon" aria-hidden="true">↻</span>
      <div>
        <strong class="block font-mono text-[11px] uppercase tracking-wider text-[#6E2B25]">
          Best Viewed Sideways
        </strong>
        <p class="font-body text-sm text-[#1C1A17] leading-snug mt-0.5 mb-0">
          Rotate your phone horizontally to unfurl the full-screen Eurasia Map Scroll left to right.
        </p>
      </div>
    </div>
    <button
      type="button"
      id="dismiss-rotate-tooltip"
      class="shrink-0 font-mono text-xs text-[#524D46] hover:text-[#6E2B25] px-1.5 py-0.5 cursor-pointer bg-transparent border-0"
      aria-label="Dismiss orientation tip"
    >
      ✕
    </button>
  </div>

  <!-- Inline Top Mode Switch Banner -->
  <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-2 border-b border-[#1C1A17]/15 font-mono text-[11px]">
    <span class="uppercase tracking-widest text-[#524D46]">
      ↕ Route Info &amp; Newsletter Log
    </span>
    <button
      type="button"
      data-switch-mode="horizontal"
      class="mode-toggle-btn"
    >
      ⟷ Unfurl Full-Screen Horizontal Map Scroll
    </button>
  </div>

  <!-- STANDARDIZED_SCROLL_HEADER_START -->
  <div class="scroll-title-block">
    <div class="scroll-eyebrow">行程図 • Coimbra → Shikoku Overland Corridor</div>
    <h1 class="page-heading">Eurasia Route Map</h1>
    <div class="page-subtitle">
      Tracing the continuous footpath from Coimbra through Santiago, Muxía, Finisterra, and Saint-Jean-Pied-de-Port — north of the Caspian Sea, through Northern India and South Korea to Shikoku
    </div>
  </div>

  <div class="page-break">
    <div class="line"></div>
    <div class="kanji">道</div>
    <div class="line"></div>
  </div>
  <!-- STANDARDIZED_SCROLL_HEADER_END -->

  <!-- 4-Column Expedition Telemetry + Progress Bar -->
  <section class="py-6 border-b border-[#1C1A17]/15">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono">
      <div class="border border-[#1C1A17]/20 bg-[#D8CEB8]/40 p-4">
        <span class="block text-[10px] uppercase tracking-widest text-[#524D46] mb-1">
          Distance Walked
        </span>
        <span class="text-xl sm:text-2xl font-medium text-[#6E2B25]">
          {stats.completedKm.toLocaleString('en-US')} km
        </span>
      </div>

      <div class="border border-[#1C1A17]/20 bg-[#D8CEB8]/40 p-4">
        <span class="block text-[10px] uppercase tracking-widest text-[#524D46] mb-1">
          Planned Corridor
        </span>
        <span class="text-xl sm:text-2xl font-medium text-[#1C1A17]">
          ~{stats.totalPlannedKm.toLocaleString('en-US')} km
        </span>
      </div>

      <div class="border border-[#1C1A17]/20 bg-[#D8CEB8]/40 p-4">
        <span class="block text-[10px] uppercase tracking-widest text-[#524D46] mb-1">
          Countries Crossed
        </span>
        <span class="text-xl sm:text-2xl font-medium text-[#1C1A17]">
          {stats.countriesCrossed}
        </span>
        <span class="block text-[10px] text-[#524D46] mt-0.5">PT · ES · FR</span>
      </div>

      <div class="border border-[#6E2B25]/45 bg-[#6E2B25]/8 p-4">
        <span class="block text-[10px] uppercase tracking-widest text-[#6E2B25] mb-1">
          Current Position
        </span>
        <span class="text-sm sm:text-base font-medium text-[#1C1A17] leading-tight block">
          {stats.currentLocation}
        </span>
      </div>
    </div>

    <!-- Progress Percentage Bar -->
    <div class="mt-5">
      <div class="flex flex-wrap items-center justify-between gap-1 font-mono text-xs text-[#524D46] mb-1.5">
        <span class="uppercase tracking-widest">
          Overland Progress (Coimbra → Shikoku)
        </span>
        <span class="text-[#6E2B25] font-medium">
          {formattedPct}% ({stats.completedKm.toLocaleString('en-US')} / {stats.totalPlannedKm.toLocaleString('en-US')} km)
        </span>
      </div>
      <div class="w-full h-2.5 bg-[#D8CEB8] border border-[#1C1A17]/25 overflow-hidden">
        <div
          class="h-full bg-[#6E2B25] transition-all duration-500"
          style={`width: ${visualBarPct}%;`}
        ></div>
      </div>
    </div>
  </section>

  <!-- Compact Inset Map Preview -->
  <section class="py-7 border-b border-[#1C1A17]/15">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3 font-mono text-[11px]">
      <div class="flex flex-wrap items-center gap-1.5">
        <button type="button" data-camera="corridor" class="cam-btn is-active">
          Full Eurasia
        </button>
        <button type="button" data-camera="walked" class="cam-btn">
          Walked Trail
        </button>
        <button type="button" data-camera="current" class="cam-btn">
          Current Spot
        </button>
      </div>
      <button
        type="button"
        data-switch-mode="horizontal"
        class="text-[#6E2B25] hover:text-[#8C3B33] underline underline-offset-4 uppercase tracking-wider cursor-pointer bg-transparent border-0"
      >
        Expand Full-Screen Map ⟷
      </button>
    </div>

    <div id="vertical-map-slot" class="vertical-map-slot"></div>

    <!-- Clickable Milestone Chips -->
    <div class="mt-3 flex flex-wrap items-center gap-1.5 font-mono" aria-label="Jump to walked milestone">
      {milestones.map((ms, idx) => (
        <button
          type="button"
          data-milestone-index={idx}
          class:list={[
            'milestone-chip',
            ms.isCurrent && 'milestone-chip-current',
          ]}
          title={`${ms.title} (KM ${ms.kmMarker})`}
        >
          {getChipLabel(ms)}
        </button>
      ))}
    </div>
  </section>

  <!-- Detailed Walked Legs & Planned Corridor Breakdown -->
  <section class="py-8 border-b border-[#6E2B25]">
    <div class="mb-5">
      <span class="font-jp text-xs text-[#6E2B25] tracking-widest block mb-1">
        踏破区間 • ROUTE LOG
      </span>
      <h2 class="font-heading text-2xl sm:text-3xl font-semibold tracking-wider uppercase text-[#1C1A17]">
        Route Completed &amp; Corridor Ahead
      </h2>
    </div>

    <div class="space-y-3.5">
      {walkedLegs.map((leg) => (
        <article class="border border-[#1C1A17]/20 bg-[#D8CEB8]/35 p-4 sm:p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
            <h3 class="font-heading text-xl font-semibold text-[#1C1A17]">
              {leg.legNumber && (
                <span class="font-mono text-xs text-[#6E2B25] mr-2">LEG {leg.legNumber}</span>
              )}
              {leg.name}
            </h3>
            <span class="font-mono text-xs text-[#6E2B25] font-medium">
              ~{leg.distanceKm} km
            </span>
          </div>
          <div class="font-mono text-[11px] uppercase tracking-wider text-[#524D46] mb-2">
            {leg.route || leg.span}
          </div>
          <p class="font-body text-base text-[#1C1A17]/90 leading-relaxed m-0">
            {leg.summary}
          </p>
        </article>
      ))}

      <article class="border border-dashed border-[#524D46]/60 bg-[#E6DFCF]/70 p-4 sm:p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
          <h3 class="font-heading text-xl font-semibold text-[#1C1A17]">
            Ahead • Planned Eurasia Overland Corridor
          </h3>
          <span class="font-mono text-xs text-[#524D46]">
            Dotted Line • ~{remainingKm.toLocaleString('en-US')} km Remaining
          </span>
        </div>
        <div class="font-mono text-[11px] uppercase tracking-wider text-[#524D46] mb-2">
          France → Italy → Balkans → Black Sea → North Caspian → Central Asia → Northern India → China → South Korea → Shikoku
        </div>
        <p class="font-body text-base text-[#1C1A17]/85 leading-relaxed m-0">
          Continuing eastward from Saint-Jean-Pied-de-Port across southern Europe and around the north shore of the Caspian Sea (Astrakhan &amp; Atyrau), descending through Central Asia into Northern India (Amritsar, Rishikesh, Varanasi), crossing China to the Yellow Sea, walking South Korea from Incheon/Seoul to Busan, and crossing to Temple 1 (Ryōzen-ji) in Shikoku.
        </p>
      </article>
    </div>
  </section>

  <!-- Monthly Substack Newsletter Log -->
  <section class="pt-8 pb-4">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
      <div>
        <span class="font-jp text-xs text-[#6E2B25] tracking-widest block mb-1">
          月報 • SUBSTACK NEWSLETTER LOG
        </span>
        <h2 class="font-heading text-2xl sm:text-3xl font-semibold tracking-wider uppercase text-[#1C1A17]">
          Monthly Newsletter Archive
        </h2>
      </div>
      <div class="flex items-center gap-2 font-mono text-[11px]">
        <span class="text-[#524D46]">
          {newsletterEntries.length} {newsletterEntries.length === 1 ? 'Issue' : 'Issues'} Logged
        </span>
        <a
          href={subscribeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#6E2B25] hover:bg-[#8C3B33] text-[#E6DFCF] px-3 py-1.5 uppercase tracking-wider transition-colors no-underline"
        >
          Subscribe on Substack ↗
        </a>
      </div>
    </div>

    <div class="mb-5 border-l-2 border-[#6E2B25] bg-[#D8CEB8]/40 px-4 py-3 font-body text-sm sm:text-base text-[#524D46]">
      Monthly updates are published on Substack. Past issues are available for paid subscribers.{' '}
      <a
        href={substackHomeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#6E2B25] hover:text-[#8C3B33] underline underline-offset-4 font-medium"
      >
        Open Substack ↗
      </a>
    </div>

    {newsletterEntries.length > 0 ? (
      <div class="overflow-x-auto border border-[#1C1A17]/20">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-[#1C1A17]/20 bg-[#D8CEB8]/60 font-mono text-[11px] uppercase tracking-widest text-[#524D46]">
              <th class="py-3 px-4">Date</th>
              <th class="py-3 px-4">Issue</th>
              <th class="py-3 px-4">Monthly Newsletter</th>
              <th class="py-3 px-4 text-right">Substack</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1C1A17]/15 text-sm">
            {newsletterEntries.map((entry) => (
              <tr class="hover:bg-[#D8CEB8]/30 transition-colors">
                <td class="py-3.5 px-4 font-mono text-xs text-[#524D46] whitespace-nowrap align-top">
                  {entry.date || '—'}
                </td>
                <td class="py-3.5 px-4 font-mono text-xs text-[#6E2B25] font-medium whitespace-nowrap align-top">
                  #{String(entry.issueNumber).padStart(2, '0')}
                  {entry.kmMarker !== null && entry.kmMarker !== undefined && (
                    <span class="block text-[10px] text-[#524D46] mt-0.5">
                      KM {entry.kmMarker}
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4 align-top">
                  <a
                    href={entry.substackUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-heading text-lg font-semibold text-[#1C1A17] hover:text-[#6E2B25] transition-colors block leading-snug no-underline"
                  >
                    {entry.title}
                  </a>
                  {entry.location && (
                    <span class="font-mono text-[10px] uppercase tracking-wider text-[#6E2B25] block mt-0.5">
                      {entry.location}
                    </span>
                  )}
                  {entry.subtitle && (
                    <p class="font-body text-sm text-[#524D46] leading-relaxed mt-1 mb-0">
                      {entry.subtitle}
                    </p>
                  )}
                </td>
                <td class="py-3.5 px-4 font-mono text-xs text-right whitespace-nowrap align-top">
                  <a
                    href={entry.substackUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block text-[#6E2B25] hover:text-[#8C3B33] underline underline-offset-4 font-medium"
                  >
                    Read Issue ↗
                  </a>
                  <span class="block text-[10px] text-[#524D46]/80 mt-0.5">
                    {entry.isArchivedPaid ? 'Paid Archive' : 'Latest Issue'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="border border-[#1C1A17]/20 bg-[#D8CEB8]/30 p-6 text-center">
        <p class="font-body italic text-base text-[#524D46] mb-3">
          Monthly newsletter issues will appear here automatically once synced from Substack.
        </p>
        <a
          href={subscribeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-[#6E2B25] hover:bg-[#8C3B33] text-[#E6DFCF] font-mono text-xs uppercase tracking-widest px-4 py-2 transition-colors no-underline"
        >
          Follow on Substack ↗
        </a>
      </div>
    )}
  </section>

  <!-- ====================================================================== -->
  <!-- STYLES: Dual Scroll Architecture, Ornate Rollers & Paper Cartography   -->
  <!-- ====================================================================== -->
  <style is:global>
    /* Toggle visibility between Horizontal Map Scroll and native Vertical BaseLayout Scroll */
    html[data-map-view="horizontal"] body > .scroll-stage,
    html[data-map-view="horizontal"] body > .apple-reveal-stage {
      display: none !important;
    }

    html[data-map-view="vertical"] #horizontal-scroll-view {
      display: none !important;
    }

    /* ====================================================================== */
    /* HORIZONTAL EMAKIMONO SCROLL (FULL-SCREEN, CENTERED -> LEFT -> UNFURL)  */
    /* ====================================================================== */
    .emakimono-shell {
      position: relative;
      z-index: 20;
      width: 100%;
      min-height: calc(100dvh - 76px);
      padding: 14px 16px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
      box-sizing: border-box;
    }

    .emakimono-stage {
      display: flex;
      align-items: stretch;
      justify-content: center;
      width: 100%;
      max-width: 1840px;
      height: calc(100dvh - 106px);
      min-height: 460px;
      will-change: transform;
    }

    /* Ornate Vertical Wooden Rollers (Left & Right) */
    .emakimono-roller {
      position: relative;
      z-index: 30;
