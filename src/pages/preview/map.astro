---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import siteConfig from '../../data/siteConfig.json';
import routeData from '../../data/route.json';
import '../../styles/global.css';

interface NewsletterEntry {
  title: string;
  date: string;
  url: string;
  excerpt: string;
}

const stats = routeData.stats || {
  totalPlannedKm: 19500,
  completedKm: 1355,
  daysOnTrail: 58,
  countriesCrossed: 3,
  currentLocation: 'Saint-Jean-Pied-de-Port, France',
  currentStageLabel: 'Pyrenees Gate • End of Reverse Camino Francés',
};

const walkedLegs = Array.isArray(routeData.walkedLegs) ? routeData.walkedLegs : [];
const walkedTrack = Array.isArray(routeData.walkedTrack) ? routeData.walkedTrack : [];
const milestones = Array.isArray(routeData.milestones) ? routeData.milestones : [];
const plannedWaypoints = Array.isArray(routeData.plannedWaypoints) ? routeData.plannedWaypoints : [];

const substackConfig = routeData.substackNewsletter || {
  publicationUrl: 'https://caminohenro.substack.com',
  subscribeUrl: 'https://caminohenro.substack.com/subscribe',
  newsletterSectionUrl: 'https://caminohenro.substack.com/s/newsletter',
  feedUrls: ['https://caminohenro.substack.com/s/newsletter/feed'],
  maxEntries: 24,
  archiveNotice:
    'Monthly road dispatches are published on Substack. Past archive issues are accessible to paid subscribers.',
  fallbackEntries: [],
};

// Lightweight zero-dependency RSS XML parser for Substack feeds (runs at Astro build time)
function decodeHtmlEntities(input: string): string {
  return input
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;|&#x27;/g, "'")
    .replace(/&nbsp;/g, ' ')
    .replace(/&#8217;|&#x2019;/g, '’')
    .replace(/&#8216;|&#x2018;/g, '‘')
    .replace(/&#8220;|&#x201C;/g, '“')
    .replace(/&#8221;|&#x201D;/g, '”')
    .replace(/&#8212;|&#x2014;/g, '—')
    .replace(/&#8211;|&#x2013;/g, '–')
    .replace(/&#8230;/g, '…')
    .replace(/&#(\d+);/g, (_m, dec) => String.fromCharCode(Number(dec)));
}

function stripHtml(input: string): string {
  return decodeHtmlEntities(input)
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function extractTag(block: string, tagName: string): string {
  const regex = new RegExp(`<${tagName}[^>]*>([\\s\\S]*?)<\\/${tagName}>`, 'i');
  const match = block.match(regex);
  return match ? match[1].trim() : '';
}

function formatDispatchDate(rawDate: string): string {
  if (!rawDate) return '—';
  const parsed = new Date(rawDate);
  if (Number.isNaN(parsed.getTime())) return rawDate;
  return parsed.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });
}

function truncateText(text: string, limit = 190): string {
  if (text.length <= limit) return text;
  return text.slice(0, limit - 1).trimEnd() + '…';
}

async function fetchSubstackDispatches(): Promise<{ entries: NewsletterEntry[]; isLive: boolean }> {
  const feedUrls = Array.isArray(substackConfig.feedUrls) ? substackConfig.feedUrls : [];
  const maxEntries = typeof substackConfig.maxEntries === 'number' ? substackConfig.maxEntries : 24;

  for (const url of feedUrls) {
    if (!url || typeof url !== 'string') continue;
    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 7000);
      const response = await fetch(url, {
        signal: controller.signal,
        headers: {
          Accept: 'application/rss+xml, application/xml, text/xml;q=0.9, */*;q=0.8',
          'User-Agent': 'CaminoHenroSite/1.0 (+https://caminohenro.org)',
        },
      });
      clearTimeout(timeout);

      if (!response.ok) continue;
      const xml = await response.text();
      if (!xml || !xml.includes('<item')) continue;

      const items = xml.match(/<item\b[\s\S]*?<\/item>/gi) || [];
      const parsed: NewsletterEntry[] = [];

      for (const itemXml of items.slice(0, maxEntries)) {
        const rawTitle = extractTag(itemXml, 'title');
        const rawLink = extractTag(itemXml, 'link');
        const rawDate = extractTag(itemXml, 'pubDate');
        const rawDesc = extractTag(itemXml, 'description');

        const title = stripHtml(rawTitle);
        const link = decodeHtmlEntities(rawLink).trim();
        if (!title || !link) continue;

        parsed.push({
          title,
          date: rawDate,
          url: link,
          excerpt: truncateText(stripHtml(rawDesc) || 'Monthly trail dispatch on Substack.'),
        });
      }

      if (parsed.length > 0) {
        return { entries: parsed, isLive: true };
      }
    } catch (_err) {
      // Try next feed URL or fall back to static entries
    }
  }

  const fallback = Array.isArray(substackConfig.fallbackEntries)
    ? (substackConfig.fallbackEntries as NewsletterEntry[])
    : [];

  return { entries: fallback, isLive: false };
}

const { entries: substackDispatches, isLive: isFeedLive } = await fetchSubstackDispatches();

const rawPct =
  stats.totalPlannedKm > 0 ? (stats.completedKm / stats.totalPlannedKm) * 100 : 0;
const formattedPct = rawPct.toFixed(2);
const visualBarPct = Math.max(rawPct, 2.0);
---

<!doctype html>
<html lang="en" data-map-scroll-mode="horizontal">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eurasia Route Map | {siteConfig.siteTitleEn || 'CAMINO HENRO'}</title>
    <meta
      name="description"
      content="Interactive overland cartography tracing Henro's continuous footpath from Coimbra through Santiago, Muxía, Finisterra, and Saint-Jean-Pied-de-Port across Eurasia to Shikoku, Japan."
    />
    <link rel="icon" type="image/svg+xml" href={siteConfig.crestImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+JP:wght@400;600&family=Shippori+Mincho:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Leaflet 1.9.4 CSS -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />

    <!-- Immediate orientation check before first paint to prevent layout flash -->
    <script is:inline>
      (function () {
        var isPortraitMobile =
          window.innerWidth <= 768 && window.innerHeight > window.innerWidth;
        document.documentElement.setAttribute(
          'data-map-scroll-mode',
          isPortraitMobile ? 'vertical' : 'horizontal'
        );
      })();
    </script>
  </head>

  <body class="selection:bg-[#6E2B25] selection:text-[#E6DFCF] map-page-body">
    <!-- Fixed Road & Apple Backdrop (matching BaseLayout.astro) -->
    <div
      class="fixed-backdrop"
      style="background-image: url('/assets/apple-bg.jpeg'), url('/assets/apple-diff.jpg');"
    ></div>
    <div class="backdrop-dimmer" id="dimmer"></div>

    <!-- Persistent Site Header -->
    <Header />

    <!-- ================================================================ -->
    <!-- MODE 1: HORIZONTAL FULL-SCREEN EMAKIMONO MAP SCROLL (LEFT -> RIGHT) -->
    <!-- ================================================================ -->
    <section
      id="horizontal-scroll-view"
      class="emakimono-shell"
      aria-label="Full-Screen Horizontal Eurasia Map Scroll"
    >
      <div class="emakimono-stage" id="emakimono-stage">
        <!-- Left Vertical Wooden Roller -->
        <div class="emakimono-roller emakimono-roller-left" aria-hidden="true">
          <span class="roller-cap roller-cap-top"></span>
          <span class="roller-ferrule roller-ferrule-top"></span>
          <span class="roller-shaft"></span>
          <span class="roller-ferrule roller-ferrule-bottom"></span>
          <span class="roller-cap roller-cap-bottom"></span>
        </div>

        <!-- Unfurling Horizontal Washi Paper Canvas -->
        <div class="emakimono-paper-viewport" id="emakimono-paper-viewport">
          <div class="emakimono-paper">
            <!-- Compact Top Cartographic Header & Mode Toggle -->
            <div class="emakimono-topbar">
              <div class="emakimono-brand">
                <span class="font-jp text-xs text-[#6E2B25] tracking-widest">行程図</span>
                <h1 class="font-heading text-xl lg:text-2xl font-bold uppercase tracking-wider text-[#1C1A17] leading-none">
                  Eurasia Route Map
                </h1>
                <span class="hidden xl:inline-flex items-center gap-1.5 font-mono text-[11px] text-[#524D46] border-l border-[#1C1A17]/20 pl-3 ml-1">
                  <span class="live-dot"></span>
                  <span>Now: <strong class="text-[#6E2B25]">{stats.currentLocation}</strong></span>
                  <span>·</span>
                  <span>{stats.completedKm.toLocaleString('en-US')} / {stats.totalPlannedKm.toLocaleString('en-US')} km</span>
                </span>
              </div>

              <div class="emakimono-controls font-mono text-[11px]">
                <button
                  type="button"
                  data-camera="corridor"
                  class="cam-btn cam-btn-corridor"
                >
                  Full Eurasia
                </button>
                <button
                  type="button"
                  data-camera="walked"
                  class="cam-btn cam-btn-walked is-active"
                >
                  Walked (Iberia)
                </button>
                <button
                  type="button"
                  data-camera="current"
                  class="cam-btn cam-btn-current"
                >
                  ● Current Spot
                </button>
                <button
                  type="button"
                  data-switch-mode="vertical"
                  class="mode-toggle-btn"
                  title="Switch to Vertical Scroll for route details & Substack dispatch log"
                >
                  ↕ Vertical Info &amp; Log
                </button>
              </div>
            </div>

            <!-- Full-Canvas Map Mount Slot -->
            <div id="horizontal-map-slot" class="emakimono-map-slot"></div>

            <!-- Slim Bottom Legend + Quick-Jump Milestone Bar -->
            <div class="emakimono-bottombar font-mono text-[11px]">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[#524D46]">
                <span class="inline-flex items-center gap-1.5">
                  <span class="inline-block w-4 h-[3px] bg-[#6E2B25]"></span>
                  <span>Walked ({stats.completedKm.toLocaleString('en-US')} km)</span>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="inline-block w-4 border-t-2 border-dashed border-[#524D46]"></span>
                  <span>Planned (North Caspian → N. India → S. Korea → Shikoku)</span>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="live-dot"></span>
                  <span>Current Position</span>
                </span>
              </div>

              <div class="milestone-chips" aria-label="Jump to walked milestone">
                {milestones.map((m, idx) => (
                  <button
                    type="button"
                    data-milestone-index={idx}
                    class:list={[
                      'milestone-chip',
                      m.isCurrent && 'milestone-chip-current',
                    ]}
                  >
                    {m.shortLabel || m.title}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Right Vertical Wooden Roller (glides left -> right on unfurl) -->
        <div class="emakimono-roller emakimono-roller-right" aria-hidden="true">
          <span class="roller-cap roller-cap-top"></span>
          <span class="roller-ferrule roller-ferrule-top"></span>
          <span class="roller-shaft"></span>
          <span class="roller-ferrule roller-ferrule-bottom"></span>
          <span class="roller-cap roller-cap-bottom"></span>
        </div>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- MODE 2: VERTICAL KAKEMONO INFO & LOG SCROLL (TOP -> BOTTOM)      -->
    <!-- ================================================================ -->
    <section
      id="vertical-scroll-view"
      class="kakemono-shell"
      aria-label="Vertical Route Information and Substack Dispatch Log Scroll"
    >
      <div class="kakemono-stage" id="kakemono-stage">
        <!-- Top Horizontal Wooden Roller -->
        <div class="kakemono-roller" aria-hidden="true">
          <span class="h-roller-cap h-roller-cap-left"></span>
          <span class="h-roller-ferrule"></span>
          <span class="h-roller-shaft"></span>
          <span class="h-roller-ferrule"></span>
          <span class="h-roller-cap h-roller-cap-right"></span>
        </div>

        <!-- Unfurling Vertical Washi Parchment -->
        <main class="kakemono-paper" id="kakemono-paper">
          <!-- Mobile Portrait Orientation Tooltip -->
          <div
            id="mobile-rotate-tooltip"
            class="mobile-rotate-tooltip"
            role="status"
          >
            <div class="flex items-start gap-2.5">
              <span class="rotate-icon" aria-hidden="true">↻</span>
              <div>
                <strong class="block font-mono text-[11px] uppercase tracking-wider text-[#6E2B25]">
                  Best Viewed Sideways
                </strong>
                <p class="font-body text-sm text-[#1C1A17] leading-snug mt-0.5">
                  Rotate your phone horizontally to unfurl the full-screen Eurasia Map Scroll left to right.
                </p>
              </div>
            </div>
            <button
              type="button"
              id="dismiss-rotate-tooltip"
              class="shrink-0 font-mono text-xs text-[#524D46] hover:text-[#6E2B25] px-1.5 py-0.5 cursor-pointer"
              aria-label="Dismiss orientation tip"
            >
              ✕
            </button>
          </div>

          <!-- Top Mode Switch Banner -->
          <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-2 border-b border-[#1C1A17]/15 font-mono text-[11px]">
            <span class="uppercase tracking-widest text-[#524D46]">
              ↕ Information &amp; Dispatch Scroll
            </span>
            <button
              type="button"
              data-switch-mode="horizontal"
              class="mode-toggle-btn"
            >
              ⟷ Unfurl Full-Screen Horizontal Map Scroll
            </button>
          </div>

          <!-- Standardized Scroll Title Block -->
          <div class="scroll-title-block">
            <div class="scroll-eyebrow">行程図 • Coimbra → Shikoku Overland Corridor</div>
            <h1 class="page-heading">Eurasia Route Map</h1>
            <div class="page-subtitle">
              Tracing the continuous footpath from Coimbra through Santiago, Muxía, Finisterra, and Saint-Jean-Pied-de-Port — north of the Caspian Sea, through Northern India and South Korea to Shikoku
            </div>
          </div>

          <div class="page-break">
            <div class="line"></div>
            <div class="kanji">道</div>
            <div class="line"></div>
          </div>

          <!-- 4-Column Expedition Telemetry + Progress Bar -->
          <section class="py-6 border-b border-[#1C1A17]/15">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono">
              <div class="border border-[#1C1A17]/20 bg-[#D8CEB8]/40 p-4">
                <span class="block text-[10px] uppercase tracking-widest text-[#524D46] mb-1">
                  Distance Walked
                </span>
                <span class="text-xl sm:text-2xl font-medium text-[#6E2B25]">
                  {stats.completedKm.toLocaleString('en-US')} km
                </span>
              </div>

              <div class="border border-[#1C1A17]/20 bg-[#D8CEB8]/40 p-4">
                <span class="block text-[10px] uppercase tracking-widest text-[#524D46] mb-1">
                  Planned Corridor
                </span>
                <span class="text-xl sm:text-2xl font-medium text-[#1C1A17]">
                  ~{stats.totalPlannedKm.toLocaleString('en-US')} km
                </span>
              </div>

              <div class="border border-[#1C1A17]/20 bg-[#D8CEB8]/40 p-4">
                <span class="block text-[10px] uppercase tracking-widest text-[#524D46] mb-1">
                  Countries Crossed
                </span>
                <span class="text-xl sm:text-2xl font-medium text-[#1C1A17]">
                  {stats.countriesCrossed}
                </span>
                <span class="block text-[10px] text-[#524D46] mt-0.5">PT · ES · FR</span>
              </div>

              <div class="border border-[#6E2B25]/45 bg-[#6E2B25]/8 p-4">
                <span class="block text-[10px] uppercase tracking-widest text-[#6E2B25] mb-1">
                  ● Current Position
                </span>
                <span class="text-sm sm:text-base font-medium text-[#1C1A17] leading-tight block">
                  {stats.currentLocation}
                </span>
              </div>
            </div>

            <!-- Progress Percentage Bar -->
            <div class="mt-5">
              <div class="flex flex-wrap items-center justify-between gap-1 font-mono text-xs text-[#524D46] mb-1.5">
                <span class="uppercase tracking-widest">
                  Overland Progress (Coimbra → Shikoku)
                </span>
                <span class="text-[#6E2B25] font-medium">
                  {formattedPct}% ({stats.completedKm.toLocaleString('en-US')} / {stats.totalPlannedKm.toLocaleString('en-US')} km)
                </span>
              </div>
              <div class="w-full h-2.5 bg-[#D8CEB8] border border-[#1C1A17]/25 overflow-hidden">
                <div
                  class="h-full bg-[#6E2B25] transition-all duration-500"
                  style={`width: ${visualBarPct}%;`}
                ></div>
              </div>
            </div>
          </section>

          <!-- Compact Inset Map Preview (hosts the shared Leaflet instance in vertical mode) -->
          <section class="py-7 border-b border-[#1C1A17]/15">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3 font-mono text-[11px]">
              <div class="flex flex-wrap items-center gap-1.5">
                <button type="button" data-camera="corridor" class="cam-btn cam-btn-corridor">
                  Full Eurasia
                </button>
                <button type="button" data-camera="walked" class="cam-btn cam-btn-walked is-active">
                  Walked Trail
                </button>
                <button type="button" data-camera="current" class="cam-btn cam-btn-current">
                  ● Current Spot
                </button>
              </div>
              <button
                type="button"
                data-switch-mode="horizontal"
                class="text-[#6E2B25] hover:text-[#8C3B33] underline underline-offset-4 uppercase tracking-wider cursor-pointer"
              >
                Expand Full-Screen Map ⟷
              </button>
            </div>

            <div id="vertical-map-slot" class="vertical-map-slot"></div>

            <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-[#524D46]">
              <span>Click any crimson 印 stamp on the map to inspect trail notes.</span>
              <span>Coimbra → Santiago → Muxía → Finisterra → Santiago → SJPP</span>
            </div>
          </section>

          <!-- Detailed Walked Legs & Planned Corridor Breakdown -->
          <section class="py-8 border-b border-[#6E2B25]">
            <div class="mb-5">
              <span class="font-jp text-xs text-[#6E2B25] tracking-widest block mb-1">
                踏破区間 • TRAIL ARCHIVE
              </span>
              <h2 class="font-heading text-2xl sm:text-3xl font-semibold tracking-wider uppercase text-[#1C1A17]">
                Route Completed &amp; Corridor Ahead
              </h2>
            </div>

            <div class="space-y-3.5">
              {walkedLegs.map((leg) => (
                <article class="border border-[#1C1A17]/20 bg-[#D8CEB8]/35 p-4 sm:p-5">
                  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
                    <h3 class="font-heading text-xl font-semibold text-[#1C1A17]">
                      {leg.name}
                    </h3>
                    <span class="font-mono text-xs text-[#6E2B25] font-medium">
                      {leg.kmRange} ({leg.distanceKm} km)
                    </span>
                  </div>
                  <div class="font-mono text-[11px] uppercase tracking-wider text-[#524D46] mb-2">
                    {leg.span}
                  </div>
                  <p class="font-body text-base text-[#1C1A17]/90 leading-relaxed">
                    {leg.summary}
                  </p>
                </article>
              ))}

              <article class="border border-dashed border-[#524D46]/60 bg-[#E6DFCF]/70 p-4 sm:p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
                  <h3 class="font-heading text-xl font-semibold text-[#1C1A17]">
                    Ahead • Planned Eurasia Overland Corridor
                  </h3>
                  <span class="font-mono text-xs text-[#524D46]">
                    Dotted Line • ~18,150 km Remaining
                  </span>
                </div>
                <div class="font-mono text-[11px] uppercase tracking-wider text-[#524D46] mb-2">
                  France → Italy → Balkans → Turkey → Caucasus → North Caspian → Central Asia → Northern India → China → South Korea → Shikoku
                </div>
                <p class="font-body text-base text-[#1C1A17]/85 leading-relaxed">
                  Continuing eastward from Saint-Jean-Pied-de-Port across southern Europe and Anatolia into the Caucasus, arcing north around the Caspian Sea (Astrakhan &amp; Atyrau), descending through Central Asia into Northern India (Ladakh, Himachal, Uttarakhand, Varanasi), crossing China to the Yellow Sea, walking South Korea from Incheon/Seoul to Busan, and crossing the strait to Temple 1 (Ryōzen-ji) in Shikoku.
                </p>
              </article>
            </div>
          </section>

          <!-- Monthly Substack Dispatch Log (Replaces Outdated Chronological Checkpoints) -->
          <section class="pt-8 pb-4">
            <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
              <div>
                <span class="font-jp text-xs text-[#6E2B25] tracking-widest block mb-1">
                  月報・書簡 • SUBSTACK NEWSLETTER LOG
                </span>
                <h2 class="font-heading text-2xl sm:text-3xl font-semibold tracking-wider uppercase text-[#1C1A17]">
                  Monthly Trail Dispatches
                </h2>
              </div>
              <div class="flex items-center gap-2 font-mono text-[11px]">
                <span class="text-[#524D46]">
                  {substackDispatches.length} {substackDispatches.length === 1 ? 'Issue' : 'Issues'} Logged
                </span>
                <a
                  href={substackConfig.subscribeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-[#6E2B25] hover:bg-[#8C3B33] text-[#E6DFCF] px-3 py-1.5 uppercase tracking-wider transition-colors"
                >
                  Subscribe on Substack 印
                </a>
              </div>
            </div>

            <div class="mb-5 border-l-2 border-[#6E2B25] bg-[#D8CEB8]/40 px-4 py-3 font-body text-sm sm:text-base text-[#524D46]">
              {substackConfig.archiveNotice}{' '}
              <a
                href={substackConfig.newsletterSectionUrl || substackConfig.publicationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#6E2B25] hover:text-[#8C3B33] underline underline-offset-4 font-medium"
              >
                Open Substack Archive ↗
              </a>
            </div>

            {substackDispatches.length > 0 ? (
              <div class="overflow-x-auto border border-[#1C1A17]/20">
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="border-b border-[#1C1A17]/20 bg-[#D8CEB8]/60 font-mono text-[11px] uppercase tracking-widest text-[#524D46]">
                      <th class="py-3 px-4">Date</th>
                      <th class="py-3 px-4">Monthly Newsletter</th>
                      <th class="py-3 px-4 text-right">Substack</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-[#1C1A17]/15 text-sm">
                    {substackDispatches.map((entry) => (
                      <tr class="hover:bg-[#D8CEB8]/30 transition-colors">
                        <td class="py-3.5 px-4 font-mono text-xs text-[#524D46] whitespace-nowrap align-top">
                          {formatDispatchDate(entry.date)}
                        </td>
                        <td class="py-3.5 px-4 align-top">
                          <a
                            href={entry.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-heading text-lg font-semibold text-[#1C1A17] hover:text-[#6E2B25] transition-colors block leading-snug"
                          >
                            {entry.title}
                          </a>
                          {entry.excerpt && (
                            <p class="font-body text-sm text-[#524D46] leading-relaxed mt-1">
                              {entry.excerpt}
                            </p>
                          )}
                        </td>
                        <td class="py-3.5 px-4 font-mono text-xs text-right whitespace-nowrap align-top">
                          <a
                            href={entry.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-[#6E2B25] hover:text-[#8C3B33] underline underline-offset-4 font-medium"
                          >
                            Read Issue ↗
                          </a>
                          <span class="block text-[10px] text-[#524D46]/80 mt-0.5">
                            Paid Archive
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <div class="border border-[#1C1A17]/20 bg-[#D8CEB8]/30 p-6 text-center">
                <p class="font-body italic text-base text-[#524D46] mb-3">
                  Monthly trail dispatches will appear here automatically as they are published on Substack.
                </p>
                <a
                  href={substackConfig.subscribeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block bg-[#6E2B25] hover:bg-[#8C3B33] text-[#E6DFCF] font-mono text-xs uppercase tracking-widest px-4 py-2 transition-colors"
                >
                  Follow on Substack ↗
                </a>
              </div>
            )}

            <p class="mt-3 font-mono text-[10px] uppercase tracking-wider text-[#524D46]/75">
              Feed status: {isFeedLive ? 'Synced live from Substack RSS at build time' : 'Showing cached dispatch entries (configure feedUrls in route.json)'}
            </p>
          </section>

          <Footer />
        </main>

        <!-- Bottom Horizontal Wooden Roller -->
        <div class="kakemono-roller" aria-hidden="true">
          <span class="h-roller-cap h-roller-cap-left"></span>
          <span class="h-roller-ferrule"></span>
          <span class="h-roller-shaft"></span>
          <span class="h-roller-ferrule"></span>
          <span class="h-roller-cap h-roller-cap-right"></span>
        </div>
      </div>
    </section>

