---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../data/siteConfig.json';

const supabaseUrl = ""; // Stripped for Sneak Preview security
const supabaseAnonKey = ""; // Stripped for Sneak Preview security

const categories = [
  "All Topics",
  "Philosophy & Sufficiency",
  "Osettai & Hospitality",
  "Community & Book Initiatives",
  "Notes for the Road"
];
---

<BaseLayout
  title="The Philosophical Forum | CAMINO HENRO"
  description="Community dialogues on material security, Osettai, and the pilgrimage across Eurasia."
>
  <div
    id="forum-root"
    data-scroll-loading="true"
    data-supabase-url={supabaseUrl}
    data-supabase-key={supabaseAnonKey}
  >
    <!-- Scroll Title Header Block -->
    <header class="scroll-title-block">
      <div class="scroll-eyebrow">広場 • The Pilgrim's Courtyard</div>
      <h1 class="page-heading">The Philosophical Forum</h1>
      <p class="page-subtitle">
        Community dialogues on material security, Osettai, and the pilgrimage
      </p>
    </header>

    <!-- Ornamental Kanji Divider -->
    <div class="page-break" aria-hidden="true">
      <div class="line"></div>
      <div class="kanji">語</div>
      <div class="line"></div>
    </div>

    <!-- Category Filter Bar + "+ Inscribe New Topic" Action Button -->
    <section class="forum-toolbar" aria-label="Forum Categories and Actions">
      <div class="forum-Toolbar-row">
        <div class="category-filter-bar" role="tablist" aria-label="Filter discussions by category">
          {categories.map((cat, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              data-category={cat}
              class={`ink-action-btn category-filter-btn ${idx === 0 ? "is-active" : ""}`}
            >
              {cat}
            </button>
          ))}
        </div>

        <button
          type="button"
          id="toggle-new-topic-btn"
          class="ink-action-btn crimson-filled-btn"
          aria-expanded="false"
          aria-controls="new-topic-drawer"
        >
          + Inscribe New Topic 印
        </button>
      </div>

      <!-- Subtle Subscribe to New Forum Posts Bar + Collapsible Drawer -->
      <div class="board-subscribe-bar">
        <button
          type="button"
          id="toggle-board-subscribe-btn"
          class="ink-action-btn"
          aria-expanded="false"
          aria-controls="board-subscribe-drawer"
        >
          ✉ Subscribe to New Forum Posts 印
        </button>
      </div>

      <div id="board-subscribe-slot" style="display:flow-root">
      <div
        id="board-subscribe-drawer"
        class="forum-form-panel hidden-view"
        aria-labelledby="board-subscribe-heading"
      >
        <div class="forum-form-header">
          <div>
            <span class="forum-form-eyebrow">回覧板 • COURTYARD DISPATCH ALERTS</span>
            <h3 id="board-subscribe-heading" class="forum-form-title">
              Subscribe to New Forum Posts
            </h3>
          </div>
          <button
            type="button"
            id="close-board-subscribe-btn"
            class="ink-action-btn forum-close-btn"
          >
            Close ✕
          </button>
        </div>

        <p class="forum-form-note">
          Receive an email notification whenever a new philosophical topic is inscribed in the courtyard. Your email address is kept 100% private.
        </p>

        <form id="board-subscribe-form" class="washi-form" novalidate>
          <div class="form-grid-row">
            <div class="form-field">
              <label for="board-sub-name">Your Name or Pilgrim Alias *</label>
              <input
                type="text"
                id="board-sub-name"
                name="subscriber_name"
                required
                minlength="1"
                maxlength="60"
                placeholder="e.g. Clara (Porto)"
              />
            </div>

            <div class="form-field">
              <label for="board-sub-email">Your Email Address *</label>
              <input
                type="email"
                id="board-sub-email"
                name="subscriber_email"
                required
                maxlength="120"
                placeholder="Private — never shown on the site"
              />
            </div>

            <div class="form-field">
              <label for="board-sub-category">Category Filter</label>
              <select id="board-sub-category" name="category_filter">
                <option value="All">All Categories</option>
                <option value="Philosophy & Sufficiency">Philosophy &amp; Sufficiency</option>
                <option value="Osettai & Hospitality">Osettai &amp; Hospitality</option>
                <option value="Community & Book Initiatives">Community &amp; Book Initiatives</option>
                <option value="Notes for the Road">Notes for the Road</option>
              </select>
            </div>
          </div>

          <div id="board-subscribe-feedback" class="form-feedback" role="status" aria-live="polite"></div>

          <div class="form-actions">
            <button
              type="button"
              id="cancel-board-subscribe-btn"
              class="ink-action-btn"
            >
              Cancel
            </button>
            <button
              type="submit"
              id="submit-board-subscribe-btn"
              class="ink-action-btn crimson-filled-btn"
            >
              Confirm Subscription 印
            </button>
          </div>
        </form>
      </div>

      </div><!-- board-subscribe-slot -->

      <!-- Compact mode selector, inside the parchment and beneath the category/action row. -->
      <div class="compose-mode-control" aria-label="Message composer presentation">
        <span class="compose-mode-label">Compose</span>
        <div class="compose-mode-options" role="group" aria-label="Choose message-box layout">
          <button type="button" id="compose-mode-overlay-btn" class="compose-mode-btn is-active" aria-label="Option 1: separate scrolls" title="Option 1: separate side scrolls" aria-pressed="true">1</button>
          <button type="button" id="compose-mode-inline-btn" class="compose-mode-btn" aria-label="Option 2: expand the main scroll" title="Option 2: expand the main scroll" aria-pressed="false">2</button>
          <button type="button" id="compose-mode-mixed-btn" class="compose-mode-btn" aria-label="Mixed: new topics in a side scroll, replies in the main scroll" title="Mixed: new topics in a side scroll; replies in the main scroll" aria-pressed="false">M</button>
        </div>
        <button type="button" class="compose-mode-info" aria-label="About message-box layouts" aria-describedby="compose-mode-tooltip">?</button>
        <span id="compose-mode-tooltip" class="compose-mode-tooltip" role="tooltip">1: Topics and replies use separate scrolls. 2: Both forms open in the main scroll. M: New topics use a side scroll; replies open in the main scroll. Your choice is remembered on this device.</span>
      </div>

      <!-- Status & Mode Indicator Strip -->
      <div class="forum-status-bar">
        <span id="forum-status-indicator" class="forum-status-text">
          {supabaseUrl && supabaseAnonKey
            ? "● Connected to the Open Courtyard Ledger"
            : "○ Sneak Preview Mode (Read & UI Demo Only — Submissions Disabled)"}
        </span>
        <span id="forum-count-indicator" class="forum-count-text">
          Showing All Topics
        </span>
      </div>

    </section>

    <!-- Collapsible "New Discussion Topic" Washi Form -->
    <div id="new-topic-inline-slot" class="composer-inline-slot">
    <section
      id="new-topic-drawer"
      class="forum-form-panel hidden-view"
      aria-labelledby="new-topic-heading"
    >
      <div class="forum-form-header">
        <div>
          <span class="forum-form-eyebrow">新規の問い • INSCRIBE A NEW INQUIRY</span>
          <h2 id="new-topic-heading" class="forum-form-title">
            Start a New Discussion Topic
          </h2>
        </div>
        <button
          type="button"
          id="close-new-topic-btn"
          class="ink-action-btn forum-close-btn"
        >
          Close ✕
        </button>
      </div>

      <p class="forum-form-note">
        No account or login screen is required. Post immediately as a guest, or enter an optional passcode to claim and protect your pilgrim alias with a verified badge (✓).
      </p>

      <form id="new-topic-form" class="washi-form" novalidate>
        <!-- Honeypot field to silently block automated spam bots -->
        <div class="honeypot-field" aria-hidden="true">
          <label for="topic-website-url">Website URL (Leave empty)</label>
          <input
            type="text"
            id="topic-website-url"
            name="website_url"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="form-grid-row">
          <div class="form-field">
            <label for="topic-category">Category *</label>
            <select id="topic-category" name="category" required>
              <option value="Philosophy & Sufficiency">Philosophy &amp; Sufficiency</option>
              <option value="Osettai & Hospitality">Osettai &amp; Hospitality</option>
              <option value="Community & Book Initiatives">Community &amp; Book Initiatives</option>
              <option value="Notes for the Road">Notes for the Road</option>
            </select>
          </div>

          <div class="form-field">
            <label for="topic-author">Your Name or Pilgrim Alias *</label>
            <input
              type="text"
              id="topic-author"
              name="author_name"
              required
              minlength="1"
              maxlength="60"
              placeholder="e.g. Clara (Porto) or A Fellow Walker"
            />
          </div>

          <div class="form-field">
            <label for="topic-email">Optional Email (Kept Private)</label>
            <input
              type="email"
              id="topic-email"
              name="author_email"
              maxlength="120"
              placeholder="Private — never shown on the site"
            />
          </div>

          <div class="form-field">
            <label for="topic-passcode">Optional Alias Passcode (Claim or Unlock Name)</label>
            <input
              type="password"
              id="topic-passcode"
              name="author_passcode"
              maxlength="120"
              autocomplete="current-password"
              placeholder="Set or enter passcode to protect your name"
            />
            <span class="field-helper-caption">
              First time using a name with a passcode claims it. Next time, enter the same passcode to post under your name.
            </span>
          </div>
        </div>

        <div class="remember-identity-row">
          <label class="remember-checkbox-label" for="topic-remember-identity">
            <input
              type="checkbox"
              id="topic-remember-identity"
              name="remember_identity"
              checked
            />
            <span>Remember my alias, email &amp; passcode on this device</span>
          </label>
        </div>

        <div class="remember-identity-row">
          <label class="remember-checkbox-label" for="topic-notify-replies">
            <input
              type="checkbox"
              id="topic-notify-replies"
              name="notify_replies"
              checked
            />
            <span>Notify me by email when someone replies to this thread</span>
          </label>
        </div>

        <div class="form-field">
          <label for="topic-title">Topic Title *</label>
          <input
            type="text"
            id="topic-title"
            name="title"
            required
            minlength="3"
            maxlength="160"
            placeholder="Summarize your philosophical question, story, or initiative..."
          />
        </div>

        <div class="form-field">
          <label for="topic-body">Your Reflection / Question *</label>
          <textarea
            id="topic-body"
            name="body"
            rows="6"
            required
            minlength="5"
            maxlength="5000"
            placeholder="Write your thoughts in full. Paragraph breaks are preserved..."
          ></textarea>
        </div>

        <div id="new-topic-feedback" class="form-feedback" role="status" aria-live="polite"></div>

        <div class="form-actions">
          <button
            type="button"
            id="cancel-new-topic-btn"
            class="ink-action-btn"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="submit-new-topic-btn"
            class="ink-action-btn crimson-filled-btn"
          >
            Inscribe Topic into Scroll 印
          </button>
        </div>
      </form>
    </section>
    </div>

    <!-- ================================================================== -->
    <!-- MAIN VIEW 1: THREAD LIST VIEW (#forum-list-view)                   -->
    <!-- ================================================================== -->
    <div id="forum-main-views" style="display:flow-root">
    <section id="forum-list-view" aria-label="Discussion Threads">
      <div id="threads-stream-container" class="threads-stream">
        <div class="stream-item loading-placeholder">
          <div class="stream-meta">UNROLLING COURTYARD LEDGER...</div>
          <h3 class="stream-title">Gathering community dialogues...</h3>
          <p class="stream-excerpt">
            Please wait a moment while the latest reflections are retrieved.
          </p>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- MAIN VIEW 2: SINGLE THREAD & REPLIES VIEW (#forum-thread-view)     -->
    <!-- ================================================================== -->
    <section
      id="forum-thread-view"
      class="hidden-view"
      aria-label="Selected Discussion Thread and Replies"
    >
      <div class="thread-nav-bar">
        <button
          type="button"
          id="back-to-list-btn"
          class="ink-action-btn"
        >
          ← Back to All Forum Topics
        </button>
      </div>

      <!-- Full Original Topic Article -->
      <article id="active-thread-article" class="active-thread-box">
        <div id="active-thread-meta" class="stream-meta"></div>
        <h2 id="active-thread-title" class="active-thread-heading"></h2>
        <div id="active-thread-body" class="active-thread-prose"></div>
      </article>

      <!-- Divider between OP and Replies -->
      <div class="page-break" aria-hidden="true">
        <div class="line"></div>
        <div class="kanji">響</div>
        <div class="line"></div>
      </div>

      <!-- Chronological Replies Section -->
      <div class="replies-section">
        <div class="replies-header">
          <h3 class="replies-heading">Voices in Response</h3>
          <span id="active-thread-reply-count" class="replies-badge">0 Replies</span>
        </div>

        <div id="replies-list-container" class="replies-list"></div>
      </div>

      <!-- Toggle for the reply form; remains visible while the form is closed -->
      <button
        type="button"
        id="toggle-reply-form-btn"
        class="ink-action-btn"
        aria-expanded="false"
        aria-controls="reply-form-box"
      >
        Reply to This Thread
      </button>

      <!-- Post a Reply to This Thread Form (closed by default) -->
      <div id="reply-inline-slot" class="composer-inline-slot">
      <div id="reply-form-box" class="reply-form-box hidden-view">
        <div class="forum-form-header">
          <div>
            <span class="forum-form-eyebrow">返答 • ADD YOUR VOICE</span>
            <h3 id="reply-form-heading" class="forum-form-title">Post a Reply to This Thread</h3>
          </div>
          <button
            type="button"
            id="close-reply-btn"
            class="ink-action-btn forum-close-btn"
            aria-label="Close reply form"
          >
            Close ✕
          </button>
        </div>

        <form id="new-reply-form" class="washi-form" novalidate>
          <!-- Honeypot field -->
          <div class="honeypot-field" aria-hidden="true">
            <label for="reply-website-url">Website URL (Leave empty)</label>
            <input
              type="text"
              id="reply-website-url"
              name="website_url"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="form-grid-row">
            <div class="form-field">
              <label for="reply-author">Your Name or Pilgrim Alias *</label>
              <input
                type="text"
                id="reply-author"
                name="author_name"
                required
                minlength="1"
                maxlength="60"
                placeholder="e.g. Kenji (Matsuyama)"
              />
            </div>

            <div class="form-field">
              <label for="reply-email">Optional Email (Kept Private)</label>
              <input
                type="email"
                id="reply-email"
                name="author_email"
                maxlength="120"
                placeholder="Never displayed publicly"
              />
            </div>

            <div class="form-field">
              <label for="reply-passcode">Optional Alias Passcode (Claim or Unlock Name)</label>
              <input
                type="password"
                id="reply-passcode"
                name="author_passcode"
                maxlength="120"
                autocomplete="current-password"
                placeholder="Set or enter passcode to protect your name"
              />
              <span class="field-helper-caption">
                First time using a name with a passcode claims it. Next time, enter the same passcode to post under your name.
              </span>
            </div>
          </div>

          <div class="remember-identity-row">
            <label class="remember-checkbox-label" for="reply-remember-identity">
              <input
                type="checkbox"
                id="reply-remember-identity"
                name="remember_identity"
                checked
              />
              <span>Remember my alias, email &amp; passcode on this device</span>
            </label>
          </div>

          <div class="remember-identity-row">
            <label class="remember-checkbox-label" for="reply-notify-replies">
              <input
                type="checkbox"
                id="reply-notify-replies"
                name="notify_replies"
                checked
              />
              <span>Notify me by email when someone replies to this thread</span>
            </label>
          </div>

          <div class="form-field">
            <label for="reply-body">Reply Message *</label>
            <textarea
              id="reply-body"
              name="body"
              rows="4"
              required
              minlength="2"
              maxlength="3000"
              placeholder="Offer your reflection, answer, or roadside encouragement..."
            ></textarea>
          </div>

          <div id="new-reply-feedback" class="form-feedback" role="status" aria-live="polite"></div>

          <div class="form-actions">
            <button
              type="submit"
              id="submit-new-reply-btn"
              class="ink-action-btn crimson-filled-btn"
            >
              Inscribe Reply 印
            </button>
          </div>
        </form>
      </div>
      </div>
    </section>

    </div><!-- forum-main-views -->

    <!-- The separate-scroll composer lives here and receives the existing form element when Option 1 is selected. -->
    <div id="forum-compose-overlay" class="forum-compose-overlay hidden-view" aria-hidden="true">
      <div id="forum-compose-scroll-stage" class="forum-compose-scroll-stage" aria-hidden="true">
        <div class="scroll-roller-top" aria-hidden="true"></div>
        <div id="forum-compose-scroll-paper" class="washi-scroll forum-compose-scroll-content"></div>
        <div class="scroll-roller-bottom" aria-hidden="true"></div>
      </div>
    </div>

      </div>
</BaseLayout>

<style is:global>
  html:has(#forum-main-views) {
    overflow-anchor: none;
    scroll-behavior: auto;
  }

  :root {
    --washi-bg: #E6DFCF;
    --washi-dark: #D8CEB8;
    --ink-sumi: #1C1A17;
    --ink-muted: #5A534A;
    --accent-crimson: #6E2B25;
    --accent-crimson-light: #8C3B33;
    --parchment-light: #F4F1EA;
    --admin-gold: #D4AF37;
  }

  /* Scroll Header & Dividers (matching Camino_Henro_Apple_Scroll_Preview-v2.html) */
  .scroll-title-block {
    text-align: center;
    padding: 0.5rem 0 1.25rem;
  }

  .scroll-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-crimson);
    margin-bottom: 0.65rem;
  }

  .page-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.15rem, 4.5vw, 3.1rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-sumi);
    line-height: 1.15;
    margin: 0 0 0.6rem;
  }

  .page-subtitle {
    font-family: 'EB Garamond', Georgia, serif;
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink-muted);
    max-width: 38rem;
    margin: 0 auto;
    line-height: 1.6;
  }

  .page-break {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 2rem 0;
    user-select: none;
  }

  .page-break .line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(110, 43, 37, 0.45) 20%,
      rgba(110, 43, 37, 0.45) 80%,
      transparent 100%
    );
  }

  .page-break .kanji {
    font-family: 'Shippori Mincho', 'Noto Serif JP', serif;
    font-size: 0.95rem;
    color: var(--accent-crimson);
    padding: 0.2rem 0.5rem;
    border: 1px solid rgba(110, 43, 37, 0.35);
    background-color: rgba(216, 206, 184, 0.45);
    line-height: 1;
  }

  /* Buttons (.ink-action-btn & filled crimson variant) */
  .ink-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.55rem 0.95rem;
    border: 1px solid rgba(28, 26, 23, 0.35);
    background-color: rgba(216, 206, 184, 0.35);
    color: var(--ink-sumi);
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    line-height: 1.2;
  }

  .ink-action-btn:hover {
    border-color: var(--accent-crimson);
    color: var(--accent-crimson);
    background-color: rgba(216, 206, 184, 0.75);
  }

  .ink-action-btn.is-active {
    border-color: var(--accent-crimson);
    background-color: var(--washi-dark);
    color: var(--accent-crimson);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent-crimson);
  }

  .ink-action-btn.crimson-filled-btn {
    background: var(--accent-crimson);
    color: #F4F1EA;
    border-color: var(--accent-crimson);
    font-weight: 500;
  }

  .ink-action-btn.crimson-filled-btn:hover {
    background: var(--accent-crimson-light);
    border-color: var(--accent-crimson-light);
    color: #F4F1EA;
  }

  .ink-action-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* ========================================================================== */
  /* FEATURE 3: EYE-CATCHING ADMIN STAR & VERIFIED PILGRIM ROLE BADGES          */
  /* ========================================================================== */
  .author-badge-admin {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    background-color: #6E2B25;
    color: #F4F1EA;
    border: 1px solid #D4AF37;
    padding: 0.14rem 0.55rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: none;
    box-shadow: 0 1px 3px rgba(28, 26, 23, 0.22), inset 0 0 0 1px rgba(212, 175, 55, 0.22);
    line-height: 1.3;
    vertical-align: middle;
  }

  .author-badge-admin::first-letter {
    color: #D4AF37;
  }

  .admin-seal-tag {
    display: inline-block;
    font-family: 'JetBrains Mono', 'Shippori Mincho', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    color: #D4AF37;
    background-color: rgba(28, 26, 23, 0.32);
    border-left: 1px solid rgba(212, 175, 55, 0.55);
    padding: 0.05rem 0.35rem 0.05rem 0.42rem;
    margin-left: 0.1rem;
    text-transform: uppercase;
  }

  .author-badge-verified {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #1C1A17;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0.04em;
    vertical-align: middle;
  }

  .verified-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.05rem;
    height: 1.05rem;
    font-size: 0.64rem;
    font-weight: 700;
    color: #6E2B25;
    background-color: rgba(110, 43, 37, 0.12);
