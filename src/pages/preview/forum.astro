        if (activeThreadId !== null) {
          closeThreadView(); // Includes the animated return to the filtered list.
        } else {
          animateMainViewChange(listView, () => renderThreadList(), 620);
        }
      });
    });

    // Open Single Thread & Replies View (#forum-thread-view)
    async function openThreadView(threadId) {
      const thread = allThreads.find((t) => String(t.id) === String(threadId));
      if (!thread) return;

      activeThreadId = thread.id;

      // Start each opened thread with the reply form closed, including any active overlay.
      if (activeComposerType === 'reply') {
        void closeComposer('reply', { restoreFocus: false, clearFeedback: false });
      } else if (replyFormBox) {
        replyFormBox.classList.add('hidden-view');
        if (replyInlineSlot) {
          replyInlineSlot.style.height = '0px';
          replyInlineSlot.style.overflow = 'hidden';
        }
      }
      if (toggleReplyFormBtn) {
        toggleReplyFormBtn.textContent = 'Reply to This Thread';
        toggleReplyFormBtn.setAttribute('aria-expanded', 'false');
      }

      // Populate thread details using renderAuthorBadge()
      if (activeThreadMeta) {
        const pinnedHtml = thread.is_pinned ? '<span class="pinned-stamp">[PINNED 印]</span>' : '';
        const authorBadgeHtml = renderAuthorBadge(thread.author_name, thread.author_role);
        activeThreadMeta.innerHTML = `
          ${pinnedHtml}
          <span class="category-tag">${escapeHtml(thread.category)}</span>
          <span>INSCRIBED BY ${authorBadgeHtml}</span>
          <span>•</span>
          <time datetime="${escapeHtml(thread.created_at)}">${escapeHtml(formatDate(thread.created_at))}</time>
        `;
      }
      if (activeThreadTitle) {
        activeThreadTitle.textContent = thread.title;
      }
      if (activeThreadBody) {
        activeThreadBody.innerHTML = renderParagraphs(thread.body);
      }

      // Switch views with the same measured-height/fade treatment as Option 2.
      const switchViews = () => {
        if (listView) listView.classList.add('hidden-view');
        if (threadView) threadView.classList.remove('hidden-view');
      };
      if (threadView) animateMainViewChange(threadView, switchViews, 620);
      else switchViews();

      loadSavedIdentity();

      if (newReplyFeedback) {
        newReplyFeedback.textContent = '';
        newReplyFeedback.className = 'form-feedback';
      }

      await loadRepliesForThread(thread.id);
    }

    function closeThreadView() {
      activeThreadId = null;
      const switchViews = () => {
        if (threadView) threadView.classList.add('hidden-view');
        if (listView) listView.classList.remove('hidden-view');
        renderThreadList();
      };
      if (listView) animateMainViewChange(listView, switchViews, 620);
      else switchViews();
    }

    if (backToListBtn) {
      backToListBtn.addEventListener('click', function () {
        closeThreadView();
      });
    }

    // Fetch Replies for a Thread (including author_role)
    async function loadRepliesForThread(threadId) {
      if (!repliesListContainer) return;

      animateForumRegion(repliesListContainer, () => {
        repliesListContainer.innerHTML = '<div class="empty-replies-box">Unrolling responses...</div>';
      });

      if (!isLiveSupabase) {
        const list = demoStarterReplies[threadId] || [];
        renderRepliesList(list);
        return;
      }

      try {
        const endpoint = `${supabaseUrl}/rest/v1/forum_replies?thread_id=eq.${encodeURIComponent(threadId)}&select=id,author_name,author_role,body,created_at&order=created_at.asc`;
        const response = await fetch(endpoint, {
          method: 'GET',
          headers: {
            apikey: supabaseAnonKey,
            Authorization: `Bearer ${supabaseAnonKey}`,
          },
        });

        if (!response.ok) {
          throw new Error(`Supabase HTTP ${response.status}`);
        }

        const replies = await response.json();
        renderRepliesList(Array.isArray(replies) ? replies : []);
      } catch (err) {
        console.error('Error fetching replies:', err);
        const fallback = demoStarterReplies[threadId] || [];
        renderRepliesList(fallback);
      }
    }

    // Render Replies List using renderAuthorBadge() and .is-admin-reply
    function renderRepliesList(replies) {
      return animateForumRegion(repliesListContainer, () => renderRepliesListContent(replies));
    }

    function renderRepliesListContent(replies) {
      if (!repliesListContainer) return;

      if (activeThreadReplyCount) {
        const count = replies.length;
        activeThreadReplyCount.textContent = count === 1 ? '1 Reply' : `${count} Replies`;
      }

      if (replies.length === 0) {
        repliesListContainer.innerHTML = `
          <div class="empty-replies-box">
            No replies have been inscribed yet. Be the first to respond below.
          </div>
        `;
        return;
      }

      repliesListContainer.innerHTML = replies
        .map((reply) => {
          const role = String(reply.author_role || 'guest').toLowerCase().trim();
          const isAdminClass = role === 'admin' ? 'is-admin-reply' : '';
          const authorBadgeHtml = renderAuthorBadge(reply.author_name, role);

          return `
            <div class="reply-card ${isAdminClass}">
              <div class="reply-card-meta">
                ${authorBadgeHtml}
                <time datetime="${escapeHtml(reply.created_at)}">${escapeHtml(formatDate(reply.created_at))}</time>
              </div>
              <div class="reply-card-body">
                ${renderParagraphs(reply.body)}
              </div>
            </div>
          `;
        })
        .join('');
    }

    // Handle "New Discussion Topic" Form Submission
    if (newTopicForm) {
      newTopicForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        const honeypot = document.getElementById('topic-website-url');
        if (honeypot && honeypot.value.trim() !== '') {
          newTopicForm.reset();
          await setNewTopicDrawerOpen(false, { restoreFocus: false });
          return;
        }

        const categoryEl = document.getElementById('topic-category');
        const titleEl = document.getElementById('topic-title');
        const bodyEl = document.getElementById('topic-body');

        const category = categoryEl ? categoryEl.value.trim() : 'Philosophy & Sufficiency';
        const author_name = topicAuthorInput ? topicAuthorInput.value.trim() : '';
        const author_email = topicEmailInput ? topicEmailInput.value.trim() : '';
        const author_passcode = topicPasscodeInput ? topicPasscodeInput.value.trim() : '';
        const shouldRemember = topicRememberCheckbox ? topicRememberCheckbox.checked : true;
        const notify_replies = topicNotifyCheckbox ? Boolean(topicNotifyCheckbox.checked) : true;
        const title = titleEl ? titleEl.value.trim() : '';
        const body = bodyEl ? bodyEl.value.trim() : '';

        if (author_name.length < 1 || author_name.length > 60) {
          newTopicFeedback.textContent = 'Please enter your Name or Pilgrim Alias (1–60 characters).';
          newTopicFeedback.className = 'form-feedback is-error';
          return;
        }
        if (title.length < 3 || title.length > 160) {
          newTopicFeedback.textContent = 'Please enter a Topic Title between 3 and 160 characters.';
          newTopicFeedback.className = 'form-feedback is-error';
          return;
        }
        if (body.length < 5 || body.length > 5000) {
          newTopicFeedback.textContent = 'Please write a Reflection between 5 and 5,000 characters.';
          newTopicFeedback.className = 'form-feedback is-error';
          return;
        }

        submitNewTopicBtn.disabled = true;
        submitNewTopicBtn.textContent = 'Inscribing...';
        newTopicFeedback.textContent = '';
        newTopicFeedback.className = 'form-feedback';

        if (!isLiveSupabase) {
          const demoCheck = verifyDemoAliasAndRole(author_name, author_passcode);
          if (!demoCheck.ok) {
            newTopicFeedback.textContent = demoCheck.error;
            newTopicFeedback.className = 'form-feedback is-error';
            submitNewTopicBtn.disabled = false;
            submitNewTopicBtn.textContent = 'Inscribe Topic into Scroll 印';
            return;
          }

          handleIdentityPersistence(author_name, author_email, author_passcode, shouldRemember);

          const createdDemoThread = {
            id: 'demo-thread-' + Date.now(),
            category: category,
            title: title,
            author_name: author_name,
            author_role: demoCheck.role,
            body: body,
            is_pinned: false,
            reply_count: 0,
            created_at: new Date().toISOString(),
          };
          allThreads.unshift(createdDemoThread);
          demoStarterReplies[createdDemoThread.id] = [];

          if (titleEl) titleEl.value = '';
          if (bodyEl) bodyEl.value = '';
          loadSavedIdentity();

          submitNewTopicBtn.disabled = false;
          submitNewTopicBtn.textContent = 'Inscribe Topic into Scroll 印';
          await setNewTopicDrawerOpen(false, { restoreFocus: false });
          renderThreadList();
          openThreadView(createdDemoThread.id);
          return;
        }

        try {
          const endpoint = `${supabaseUrl}/rest/v1/forum_threads?select=id,category,title,author_name,author_role,body,is_pinned,reply_count,created_at`;
          const payload = {
            category: category,
            title: title,
            author_name: author_name,
            author_email: author_email || null,
            author_passcode: author_passcode || null,
            notify_replies: notify_replies,
            body: body,
          };

          const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
              apikey: supabaseAnonKey,
              Authorization: `Bearer ${supabaseAnonKey}`,
              'Content-Type': 'application/json',
              Prefer: 'return=representation',
            },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            const errText = await response.text();
            const friendlyProtectionError = extractProtectionErrorMessage(errText);
            if (friendlyProtectionError) {
              newTopicFeedback.textContent = friendlyProtectionError;
              newTopicFeedback.className = 'form-feedback is-error';
              return;
            }
            throw new Error(errText || `HTTP ${response.status}`);
          }

          handleIdentityPersistence(author_name, author_email, author_passcode, shouldRemember);

          const inserted = await response.json();
          const newThread = Array.isArray(inserted) && inserted[0] ? inserted[0] : null;

          if (titleEl) titleEl.value = '';
          if (bodyEl) bodyEl.value = '';
          loadSavedIdentity();
          await setNewTopicDrawerOpen(false, { restoreFocus: false });

          await loadThreads();
          if (newThread && newThread.id) {
            openThreadView(newThread.id);
          }
        } catch (err) {
          console.error('Failed to post new topic:', err);
          newTopicFeedback.textContent =
            'Could not inscribe topic. Please verify your Supabase connection or try again.';
          newTopicFeedback.className = 'form-feedback is-error';
        } finally {
          submitNewTopicBtn.disabled = false;
          submitNewTopicBtn.textContent = 'Inscribe Topic into Scroll 印';
        }
      });
    }

    // Handle "Post a Reply to This Thread" Form Submission
    if (newReplyForm) {
      newReplyForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (!activeThreadId) return;

        const honeypot = document.getElementById('reply-website-url');
        if (honeypot && honeypot.value.trim() !== '') {
          newReplyForm.reset();
          return;
        }

        const bodyEl = document.getElementById('reply-body');

        const author_name = replyAuthorInput ? replyAuthorInput.value.trim() : '';
        const author_email = replyEmailInput ? replyEmailInput.value.trim() : '';
        const author_passcode = replyPasscodeInput ? replyPasscodeInput.value.trim() : '';
        const shouldRemember = replyRememberCheckbox ? replyRememberCheckbox.checked : true;
        const notify_replies = replyNotifyCheckbox ? Boolean(replyNotifyCheckbox.checked) : true;
        const body = bodyEl ? bodyEl.value.trim() : '';

        if (author_name.length < 1 || author_name.length > 60) {
          newReplyFeedback.textContent = 'Please enter your Name or Pilgrim Alias (1–60 characters).';
          newReplyFeedback.className = 'form-feedback is-error';
          return;
        }
        if (body.length < 2 || body.length > 3000) {
          newReplyFeedback.textContent = 'Please enter a reply between 2 and 3,000 characters.';
          newReplyFeedback.className = 'form-feedback is-error';
          return;
        }

        submitNewReplyBtn.disabled = true;
        submitNewReplyBtn.textContent = 'Inscribing Reply...';
        newReplyFeedback.textContent = '';
        newReplyFeedback.className = 'form-feedback';

        if (!isLiveSupabase) {
          const demoCheck = verifyDemoAliasAndRole(author_name, author_passcode);
          if (!demoCheck.ok) {
            newReplyFeedback.textContent = demoCheck.error;
            newReplyFeedback.className = 'form-feedback is-error';
            submitNewReplyBtn.disabled = false;
            submitNewReplyBtn.textContent = 'Inscribe Reply 印';
            return;
          }

          handleIdentityPersistence(author_name, author_email, author_passcode, shouldRemember);

          const demoReply = {
            id: 'demo-reply-' + Date.now(),
            thread_id: activeThreadId,
            author_name: author_name,
            author_role: demoCheck.role,
            body: body,
            created_at: new Date().toISOString(),
          };
          if (!demoStarterReplies[activeThreadId]) {
            demoStarterReplies[activeThreadId] = [];
          }
          demoStarterReplies[activeThreadId].push(demoReply);

          const parentThread = allThreads.find((t) => String(t.id) === String(activeThreadId));
          if (parentThread) {
            parentThread.reply_count = Number(parentThread.reply_count || 0) + 1;
          }

          renderRepliesList(demoStarterReplies[activeThreadId]);
          if (bodyEl) bodyEl.value = '';
          loadSavedIdentity();

          newReplyFeedback.textContent = '✓ Reply inscribed into the thread.';
          newReplyFeedback.className = 'form-feedback is-success';
          submitNewReplyBtn.disabled = false;
          submitNewReplyBtn.textContent = 'Inscribe Reply 印';
          setReplyFormOpen(false, { restoreFocus: false, clearFeedback: false });
          return;
        }

        try {
          const endpoint = `${supabaseUrl}/rest/v1/forum_replies?select=id,author_name,author_role,body,created_at`;
          const payload = {
            thread_id: activeThreadId,
            author_name: author_name,
            author_email: author_email || null,
            author_passcode: author_passcode || null,
            notify_replies: notify_replies,
            body: body,
          };

          const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
              apikey: supabaseAnonKey,
              Authorization: `Bearer ${supabaseAnonKey}`,
              'Content-Type': 'application/json',
              Prefer: 'return=representation',
            },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            const errText = await response.text();
            const friendlyProtectionError = extractProtectionErrorMessage(errText);
            if (friendlyProtectionError) {
              newReplyFeedback.textContent = friendlyProtectionError;
              newReplyFeedback.className = 'form-feedback is-error';
              return;
            }
            throw new Error(errText || `HTTP ${response.status}`);
          }

          handleIdentityPersistence(author_name, author_email, author_passcode, shouldRemember);

          // Increment local thread reply_count and re-fetch replies chronologically
          const parentThread = allThreads.find((t) => String(t.id) === String(activeThreadId));
          if (parentThread) {
            parentThread.reply_count = Number(parentThread.reply_count || 0) + 1;
          }

          if (bodyEl) bodyEl.value = '';
          loadSavedIdentity();
          await loadRepliesForThread(activeThreadId);
          newReplyFeedback.textContent = '✓ Your reply has been inscribed into the thread.';
          newReplyFeedback.className = 'form-feedback is-success';
          setReplyFormOpen(false, { restoreFocus: false, clearFeedback: false });
        } catch (err) {
          console.error('Failed to post reply:', err);
          newReplyFeedback.textContent =
            'Could not post reply. Please verify your connection and try again.';
          newReplyFeedback.className = 'form-feedback is-error';
        } finally {
          submitNewReplyBtn.disabled = false;
          submitNewReplyBtn.textContent = 'Inscribe Reply 印';
        }
      });
    }

    // Pre-fill saved identity and initialize Forum on Page Load
    loadSavedIdentity();
    loadThreads().finally(() => {
      document.getElementById('forum-root')?.removeAttribute('data-scroll-loading');
    });
  })();
</script>

<style>
  .sneak-preview-banner {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6E2B25;
    background: rgba(110, 43, 37, 0.1);
    border: 1px dashed rgba(110, 43, 37, 0.45);
    padding: 0.6rem 0.9rem;
    margin-bottom: 1.25rem;
    text-align: center;
  }
</style>

<script is:inline>
  (function () {
    // Insert a subtle Sneak Preview notice inside the forum toolbar
    const toolbar = document.querySelector('.forum-toolbar');
    if (toolbar) {
      const banner = document.createElement('div');
      banner.className = 'sneak-preview-banner';
      banner.textContent = '印 Sneak Preview Mode — Feel free to test the categories, threads, and scroll animations. Posting is disabled until launch.';
      toolbar.insertBefore(banner, toolbar.firstChild);
    }

    // Intercept all form submissions in the capture phase so no messages are posted or sent
    const previewForms = [
      { formId: 'new-topic-form', feedbackId: 'new-topic-feedback' },
      { formId: 'new-reply-form', feedbackId: 'new-reply-feedback' },
      { formId: 'board-subscribe-form', feedbackId: 'board-subscribe-feedback' }
    ];

    previewForms.forEach(({ formId, feedbackId }) => {
      const formEl = document.getElementById(formId);
      const feedbackEl = document.getElementById(feedbackId);
      if (!formEl) return;

      formEl.addEventListener(
        'submit',
        function (e) {
          e.preventDefault();
          e.stopImmediatePropagation();
          if (feedbackEl) {
            feedbackEl.textContent =
              '🔒 Sneak Preview Mode: Sending messages and subscriptions is disabled in this preview for security.';
            feedbackEl.className = 'form-feedback is-error';
          }
          return false;
        },
        true
      );
    });
  })();
</script>

