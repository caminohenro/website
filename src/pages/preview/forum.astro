    // FORUM_VIEWPORT_FIX_V1
    // Observe an explicitly changing region, including every animated height step.
    const viewportRegions = new Set();
    function trackViewportRegion(region) {
      if (!region) return () => {};
      // An outer transition already accounts for nested content changes.
      if ([...viewportRegions].some(active => active.contains(region))) return () => {};
      viewportRegions.add(region);
      let oldHeight = region.getBoundingClientRect().height;
      let top = region.getBoundingClientRect().top + window.scrollY;
      let y = window.scrollY;
      let stopped = false;
      const onScroll = () => { y = window.scrollY; };
      const update = () => {
        if (stopped) return;
        const rect = region.getBoundingClientRect();
        const removed = Math.max(0, oldHeight - rect.height);
        // Removing [top, top + removed] subtracts only the part above the viewport.
        y = Math.max(0, y - Math.min(removed, Math.max(0, y - top)));
        window.scrollTo({ top: y, left: window.scrollX, behavior: 'instant' });
        y = window.scrollY; // Respect the browser's document-end limit.
        oldHeight = rect.height;
        top = region.getBoundingClientRect().top + window.scrollY;
      };
      const observer = new ResizeObserver(update);
      observer.observe(region);
      window.addEventListener('scroll', onScroll, { passive: true });
      const stop = () => {
        if (stopped) return;
        update();
        stopped = true;
        viewportRegions.delete(region);
        observer.disconnect();
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('wheel', stop);
        window.removeEventListener('touchstart', stop);
        window.removeEventListener('keydown', stop);
        document.removeEventListener('astro:before-swap', stop);
        window.removeEventListener('pagehide', stop);
      };
      // Give control back immediately when the user starts navigating.
      window.addEventListener('wheel', stop, { passive: true });
      window.addEventListener('touchstart', stop, { passive: true });
      window.addEventListener('keydown', stop);
      document.addEventListener('astro:before-swap', stop, { once: true });
      window.addEventListener('pagehide', stop, { once: true });
      return stop;
    }

    function changeViewportRegion(region, change) {
      const finish = trackViewportRegion(region);
      try { return change(); }
      finally { finish(); }
    }



    // FORUM_SHARED_UNFURL_V1

    const sharedAnimations = new Map();




    // FORUM_ROLLER_SYNC_V1
    let forumMutationDepth = 0;

    function animateForumRegion(region, mutate, close = false) {
      // INITIAL_SCROLL_READY_V1: the main entrance supplies the first render animation.
      if (!region || forumMutationDepth || document.getElementById('forum-root')?.dataset.scrollLoading === 'true') {
        mutate();
        return;
      }

      const ancestor = [...sharedAnimations.keys()].find(
        element => element !== region && element.contains(region)
      );

      if (ancestor) {
        // Sample the ancestor before changing its contents.
        animateForumRegion(ancestor, mutate);
        return;
      }

      const previous = sharedAnimations.get(region);
      const oldHeight = region.getBoundingClientRect().height;
      const descendants = [...sharedAnimations.entries()].filter(
        ([element]) => element !== region && region.contains(element)
      );

      // Release child viewport trackers at their current heights.
      // The outer tracker then owns the remaining transition.
      descendants.forEach(([, state]) => state.finishViewport());

      const state = previous || {
        finishViewport: trackViewportRegion(region),
        height: region.style.height,
        overflow: region.style.overflow,
        animations: []
      };

      // Settle existing child animations before measuring the destination.
      descendants.forEach(([element, childState]) => {
        childState.token = null;
        childState.animations.forEach(animation => animation.cancel());
        element.style.height = childState.height;
        element.style.overflow = childState.overflow;
        sharedAnimations.delete(element);
      });

      // Invalidate callbacks belonging to an interrupted animation.
      state.token = {};
      const token = state.token;

      state.animations.forEach(animation => animation.cancel());
      state.animations = [];

      // Register before mutate(), which may call renderThreadList()
      // or renderRepliesList() and re-enter this function.
      sharedAnimations.set(region, state);

      const restore = () => {
        region.style.height = state.height;
        region.style.overflow = state.overflow;
        state.animations.forEach(animation => animation.cancel());
        state.finishViewport();
        sharedAnimations.delete(region);
      };

      try {
        region.style.height = state.height;
        region.style.overflow = state.overflow;

        if (!close) {
          forumMutationDepth++;
          try {
            mutate();
          } finally {
            forumMutationDepth--;
          }
        }

        // Nested render calls have completed synchronously, so this is
        // the natural destination height, not a child's animation frame.
        const targetHeight = close
          ? 0
          : region.getBoundingClientRect().height;

        const shrinking = targetHeight < oldHeight;
        const duration = shrinking
          ? composerInlineCloseDuration
          : composerInlineOpenDuration;

        region.style.height = `${oldHeight}px`;
        region.style.overflow = 'hidden';

        state.animations.push(region.animate(
          [
            { height: `${oldHeight}px` },
            { height: `${targetHeight}px` }
          ],
          {
            duration,
            easing: shrinking
              ? 'cubic-bezier(0.4, 0, 0.8, 0.2)'
              : 'cubic-bezier(0.33, 1, 0.62, 1)',
            fill: 'both'
          }
        ));

        for (const child of region.children) {
          state.animations.push(child.animate(
            close
              ? [
                  { opacity: 1, transform: 'translateY(0)' },
                  { opacity: 0, transform: 'translateY(-12px)' }
                ]
              : [
                  { opacity: 0, transform: 'translateY(-14px)' },
                  { opacity: 1, transform: 'translateY(0)' }
                ],
            {
              duration: close
                ? Math.max(1, duration - 80)
                : composerContentFadeDuration,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'both'
            }
          ));
        }

        Promise.all(
          state.animations.map(animation =>
            animation.finished.catch(() => {})
          )
        ).then(() => {
          if (
            state.token !== token ||
            sharedAnimations.get(region) !== state
          ) return;

          try {
            if (close) {
              forumMutationDepth++;
              try {
                mutate();
              } finally {
                forumMutationDepth--;
              }
            }
          } finally {
            restore();
          }
        });
      } catch (error) {
        state.token = null;
        restore();
        throw error;
      }
    }


    function animateMainViewChange(view, mutate) {

      animateForumRegion(

        document.getElementById('forum-main-views'),

        mutate

      );

    }



    document.addEventListener('astro:before-swap', () => {

      sharedAnimations.forEach((state, region) => {

        state.token = null;

        state.animations.forEach(animation => animation.cancel());

        region.style.height = state.height;

        region.style.overflow = state.overflow;

        state.finishViewport();

      });

      sharedAnimations.clear();

    }, { once: true });



    // Render Thread List View (#forum-list-view) using renderAuthorBadge()
    function renderThreadList() {
      return animateForumRegion(threadsStreamContainer, () => renderThreadListContent());
    }

    function renderThreadListContent() {
      if (!threadsStreamContainer) return;

      const filtered =
        currentCategory === 'All Topics'
          ? allThreads
          : allThreads.filter((t) => t.category === currentCategory);

      if (countIndicator) {
        const label = currentCategory === 'All Topics' ? 'All Topics' : currentCategory;
        countIndicator.textContent = `${label} (${filtered.length} ${filtered.length === 1 ? 'Thread' : 'Threads'})`;
      }

      if (filtered.length === 0) {
        threadsStreamContainer.innerHTML = `
          <div class="stream-item">
            <div class="stream-meta">EMPTY COURTYARD SECTION</div>
            <h3 class="stream-title">No discussions inscribed in "${escapeHtml(currentCategory)}" yet</h3>
            <p class="stream-excerpt">
              Be the first pilgrim to open a dialogue in this category by clicking "+ Inscribe New Topic 印" above.
            </p>
          </div>
        `;
        return;
      }

      threadsStreamContainer.innerHTML = filtered
        .map((thread) => {
          const pinnedBadge = thread.is_pinned
            ? '<span class="pinned-stamp">[PINNED 印]</span>'
            : '';
          const replyCount = Number(thread.reply_count || 0);
          const replyLabel = replyCount === 1 ? '1 Reply' : `${replyCount} Replies`;
          const excerpt = makeExcerpt(thread.body, 180);
          const authorBadgeHtml = renderAuthorBadge(thread.author_name, thread.author_role);

          return `
            <article
              class="stream-item ${thread.is_pinned ? 'is-pinned-item' : ''}"
              data-thread-id="${escapeHtml(thread.id)}"
              tabindex="0"
              role="button"
              aria-label="Open discussion: ${escapeHtml(thread.title)}"
            >
              <div class="stream-meta">
                ${pinnedBadge}
                <span class="category-tag">${escapeHtml(thread.category)}</span>
                <span>BY ${authorBadgeHtml}</span>
                <span>•</span>
                <time datetime="${escapeHtml(thread.created_at)}">${escapeHtml(formatDate(thread.created_at))}</time>
                <span class="reply-count-tag">💬 ${escapeHtml(replyLabel)}</span>
              </div>
              <h3 class="stream-title">${escapeHtml(thread.title)}</h3>
              <p class="stream-excerpt">${escapeHtml(excerpt)}</p>
              <span class="stream-read-link">Unroll Discussion ➔</span>
            </article>
          `;
        })
        .join('');

      // Attach click & keyboard listeners to each .stream-item
      const items = threadsStreamContainer.querySelectorAll('.stream-item[data-thread-id]');
      items.forEach((item) => {
        item.addEventListener('click', function () {
          const id = item.getAttribute('data-thread-id');
          if (id) openThreadView(id);
        });
        item.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const id = item.getAttribute('data-thread-id');
            if (id) openThreadView(id);
          }
        });
      });
    }

    // Category Filter Buttons
    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', function () {
