    // Helpers
    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderAuthorBadge(authorName, authorRole) {
      const normalizedRole = String(authorRole || 'guest').toLowerCase().trim();
      if (normalizedRole === 'admin') {
        return `<span class="author-badge-admin">★ ${escapeHtml(authorName)} <span class="admin-seal-tag">ADMIN 印</span></span>`;
      }
      if (normalizedRole === 'verified') {
        return `<span class="author-badge-verified">${escapeHtml(authorName)} <span class="verified-check" title="Protected Pilgrim Alias">✓</span></span>`;
      }
      return `<span class="author-badge-guest">${escapeHtml(authorName)}</span>`;
    }

    function formatDate(isoString) {
      if (!isoString) return '';
      const d = new Date(isoString);
      if (Number.isNaN(d.getTime())) return isoString;
      return d.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: '2-digit',
      });
    }

    function makeExcerpt(text, maxLen) {
      const clean = String(text || '').replace(/\s+/g, ' ').trim();
      if (clean.length <= maxLen) return clean;
      return clean.slice(0, maxLen).trim() + '…';
    }

    function renderParagraphs(text) {
      const paragraphs = String(text || '')
        .split(/\n{2,}|\r\n{2,}/)
        .map((p) => p.trim())
        .filter(Boolean);

      if (paragraphs.length === 0) {
        return '<p>' + escapeHtml(text) + '</p>';
      }

      return paragraphs
        .map((p) => '<p>' + escapeHtml(p).replace(/\n/g, '<br />') + '</p>')
        .join('');
    }

    // Load & Save Pilgrim Identity in localStorage (Step 8A)
    function loadSavedIdentity() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY_IDENTITY);
        if (!raw) return;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return;

        if (topicAuthorInput && parsed.author_name) topicAuthorInput.value = parsed.author_name;
        if (topicEmailInput && parsed.author_email) topicEmailInput.value = parsed.author_email;
        if (topicPasscodeInput && parsed.author_passcode) topicPasscodeInput.value = parsed.author_passcode;

        if (replyAuthorInput && parsed.author_name) replyAuthorInput.value = parsed.author_name;
        if (replyEmailInput && parsed.author_email) replyEmailInput.value = parsed.author_email;
        if (replyPasscodeInput && parsed.author_passcode) replyPasscodeInput.value = parsed.author_passcode;

        if (boardSubNameInput && parsed.author_name && !boardSubNameInput.value) boardSubNameInput.value = parsed.author_name;
        if (boardSubEmailInput && parsed.author_email && !boardSubEmailInput.value) boardSubEmailInput.value = parsed.author_email;
      } catch (err) {
        console.warn('Could not read saved forum identity from localStorage:', err);
      }
    }

    function handleIdentityPersistence(author_name, author_email, author_passcode, shouldRemember) {
      try {
        if (shouldRemember) {
          localStorage.setItem(
            STORAGE_KEY_IDENTITY,
            JSON.stringify({
              author_name: author_name || '',
              author_email: author_email || '',
              author_passcode: author_passcode || '',
            })
          );
          if (topicAuthorInput) topicAuthorInput.value = author_name || '';
          if (topicEmailInput) topicEmailInput.value = author_email || '';
          if (topicPasscodeInput) topicPasscodeInput.value = author_passcode || '';
          if (replyAuthorInput) replyAuthorInput.value = author_name || '';
          if (replyEmailInput) replyEmailInput.value = author_email || '';
          if (replyPasscodeInput) replyPasscodeInput.value = author_passcode || '';
        } else {
          localStorage.removeItem(STORAGE_KEY_IDENTITY);
        }
      } catch (err) {
        console.warn('Could not persist forum identity to localStorage:', err);
      }
    }

    // Sync the two "Remember me" checkboxes so toggling one updates the other
    if (topicRememberCheckbox && replyRememberCheckbox) {
      topicRememberCheckbox.addEventListener('change', function () {
        replyRememberCheckbox.checked = topicRememberCheckbox.checked;
      });
      replyRememberCheckbox.addEventListener('change', function () {
        topicRememberCheckbox.checked = replyRememberCheckbox.checked;
      });
    }

    // Board-Wide New Topic Subscription Drawer Toggle & Submission
    function setBoardSubscribeDrawerOpen(isOpen) {
      if (!boardSubscribeDrawer || !toggleBoardSubscribeBtn) return;
      toggleBoardSubscribeBtn.setAttribute('aria-expanded', String(isOpen));
      animateForumRegion(document.getElementById('board-subscribe-slot'),
        () => setBoardSubscribeDrawerOpenContent(isOpen), !isOpen);
