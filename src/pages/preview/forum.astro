    function setBoardSubscribeDrawerOpenContent(isOpen) {
      if (!boardSubscribeDrawer || !toggleBoardSubscribeBtn) return;
      boardSubscribeDrawer.classList.toggle('hidden-view', !isOpen);
      toggleBoardSubscribeBtn.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        loadSavedIdentity();
        if (boardSubNameInput && !boardSubNameInput.value) {
          boardSubNameInput.focus({ preventScroll: true });
        } else if (boardSubEmailInput) {
          boardSubEmailInput.focus({ preventScroll: true });
        }
      }
    }

    if (toggleBoardSubscribeBtn && boardSubscribeDrawer) {
      toggleBoardSubscribeBtn.addEventListener('click', function () {
        const isCurrentlyHidden = toggleBoardSubscribeBtn.getAttribute('aria-expanded') !== 'true';
        setBoardSubscribeDrawerOpen(isCurrentlyHidden);
