    if (closeBoardSubscribeBtn) {
      closeBoardSubscribeBtn.addEventListener('click', function () {
        setBoardSubscribeDrawerOpen(false);
      });
    }
    if (cancelBoardSubscribeBtn) {
      cancelBoardSubscribeBtn.addEventListener('click', function () {
        setBoardSubscribeDrawerOpen(false);
      });
    }

    if (boardSubscribeForm) {
      boardSubscribeForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        const subName = boardSubNameInput ? boardSubNameInput.value.trim() : '';
        const subEmail = boardSubEmailInput ? boardSubEmailInput.value.trim() : '';
        const subCategory = boardSubCategorySelect ? boardSubCategorySelect.value.trim() : 'All';

        if (subName.length < 1 || subName.length > 60) {
          boardSubscribeFeedback.textContent = 'Please enter your Name or Pilgrim Alias (1–60 characters).';
          boardSubscribeFeedback.className = 'form-feedback is-error';
          return;
        }
        if (!subEmail.includes('@') || !subEmail.includes('.')) {
          boardSubscribeFeedback.textContent = 'Please enter a valid email address.';
          boardSubscribeFeedback.className = 'form-feedback is-error';
          return;
        }

        if (submitBoardSubscribeBtn) {
          submitBoardSubscribeBtn.disabled = true;
          submitBoardSubscribeBtn.textContent = 'Subscribing...';
        }
        boardSubscribeFeedback.textContent = '';
        boardSubscribeFeedback.className = 'form-feedback';

        if (!isLiveSupabase) {
          boardSubscribeFeedback.textContent =
            '✓ Local Demo Mode: Subscription simulated for ' + subEmail + ' (' + subCategory + ').';
          boardSubscribeFeedback.className = 'form-feedback is-success';
          if (submitBoardSubscribeBtn) {
            submitBoardSubscribeBtn.disabled = false;
            submitBoardSubscribeBtn.textContent = 'Confirm Subscription 印';
          }
          return;
        }

        try {
          const response = await fetch(`${supabaseUrl}/rest/v1/rpc/subscribe_to_forum_board`, {
            method: 'POST',
            headers: {
              apikey: supabaseAnonKey,
              Authorization: `Bearer ${supabaseAnonKey}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              p_name: subName,
              p_email: subEmail,
              p_category: subCategory || 'All',
            }),
          });

          if (!response.ok) {
            const errText = await response.text();
            throw new Error(errText || `HTTP ${response.status}`);
          }

          let result = null;
          try {
            result = await response.json();
          } catch (_e) {
            result = null;
          }

          boardSubscribeFeedback.textContent =
            (result && result.message) ||
            '✓ You are now subscribed to new forum topics.';
          boardSubscribeFeedback.className = 'form-feedback is-success';
        } catch (err) {
          console.error('Failed to subscribe to forum board:', err);
          boardSubscribeFeedback.textContent =
            'Could not complete subscription. Please ensure supabase-notifications-complete.sql has been run in Supabase.';
          boardSubscribeFeedback.className = 'form-feedback is-error';
        } finally {
          if (submitBoardSubscribeBtn) {
            submitBoardSubscribeBtn.disabled = false;
            submitBoardSubscribeBtn.textContent = 'Confirm Subscription 印';
          }
        }
      });
    }

    // Extract friendly ALIAS_PROTECTED error message from Supabase response
    function extractProtectionErrorMessage(errText) {
      const raw = String(errText || '');
      if (raw.includes('ALIAS_PROTECTED:')) {
        try {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.message) {
            return parsed.message.replace(/^.*ALIAS_PROTECTED:\s*/i, '');
          }
        } catch (_e) {
          // Fallback regex extraction if not JSON
        }
        const match = raw.match(/ALIAS_PROTECTED:\s*([^"\\]+)/i);
        if (match && match[1]) {
          return match[1].trim();
        }
        return 'This pilgrim alias is protected. Please enter the correct passcode for this name, or choose another alias.';
      }
      return null;
    }

    // Simulate alias verification & role assignment in Local Preview / Demo Mode
    function verifyDemoAliasAndRole(authorName, authorPasscode) {
      const aliasKey = String(authorName || '').toLowerCase().trim();
      const passcode = String(authorPasscode || '').trim();

      // Anti-Impersonation rule for Henro / Admin
      if (
        aliasKey.includes('henro') ||
        aliasKey.includes('admin') ||
        aliasKey.includes('カミノ遍路')
      ) {
        if (passcode !== 'henro') {
          return {
            ok: false,
            error:
              "The name Henro is reserved. In Local Demo Mode, enter passcode 'henro' to test posting with the ★ ADMIN badge, or choose another alias.",
          };
        }
        return { ok: true, role: 'admin' };
      }

      // Check existing claimed demo alias
      if (demoClaimedUsers[aliasKey]) {
        if (passcode !== demoClaimedUsers[aliasKey].passcode) {
          return {
            ok: false,
            error:
              'This pilgrim alias is already claimed and protected. Please enter its passcode to post, or choose a different alias.',
          };
        }
        return { ok: true, role: demoClaimedUsers[aliasKey].role };
      }

      // New alias with a passcode (3+ chars) claims 'verified' status
      if (passcode.length >= 3) {
        demoClaimedUsers[aliasKey] = { passcode: passcode, role: 'verified' };
        return { ok: true, role: 'verified' };
      }

      return { ok: true, role: 'guest' };
    }

    // Composer presentation helpers. The forms themselves are moved, not cloned,
    // so their IDs, validation, identity fields, and submit listeners stay intact.
    function getComposerPanel(type) {
      return type === 'topic' ? newTopicDrawer : replyFormBox;
    }

    function getComposerAnchor(type) {
      return type === 'topic' ? newTopicHomeAnchor : replyHomeAnchor;
    }

    function getComposerSlot(type) {
      return type === 'topic' ? newTopicInlineSlot : replyInlineSlot;
    }

    function getComposerHeadingId(type) {
      return type === 'topic' ? 'new-topic-heading' : 'reply-form-heading';
    }

    function restoreComposerHome(type) {
      const panel = getComposerPanel(type);
      const anchor = getComposerAnchor(type);
      if (!panel || !anchor || !anchor.parentNode) return;
      if (panel.parentNode !== anchor.parentNode) {
        anchor.parentNode.insertBefore(panel, anchor.nextSibling);
      }
    }

    function restoreComposeOverlayHome() {
      if (!composeOverlay || !composeOverlayHomeAnchor || !composeOverlayHomeAnchor.parentNode) return;
      if (composeOverlay.parentNode !== composeOverlayHomeAnchor.parentNode) {
        composeOverlayHomeAnchor.parentNode.insertBefore(composeOverlay, composeOverlayHomeAnchor.nextSibling);
      }
    }

    function positionComposeOverlay(trigger) {
      if (!composeOverlayStage || !trigger) return;
      const rect = trigger.getBoundingClientRect();
      const viewportWidth = document.documentElement.clientWidth;
      const viewportHeight = window.innerHeight;
      const mobile = viewportWidth <= 680;
      const overlayWidth = Math.min(mobile ? viewportWidth - 20 : 620, viewportWidth - 20);
      let left;
      if (mobile) {
        left = 10;
      } else {
        left = rect.right + 18;
        if (left + overlayWidth > viewportWidth - 10) {
          left = rect.left - overlayWidth - 18;
        }
        left = Math.max(10, Math.min(left, viewportWidth - overlayWidth - 10));
      }
      const expectedContentHeight = Math.min(viewportHeight - 80, Math.max(viewportHeight * 0.72, 260));
      const maxTop = Math.max(10, viewportHeight - expectedContentHeight - 50);
      const top = Math.max(10, Math.min(rect.top - 10, maxTop));
      composeOverlayStage.style.width = `${overlayWidth}px`;
      composeOverlayStage.style.left = `${left}px`;
      composeOverlayStage.style.top = `${top}px`;
    }

    // Drag a separate composer by its top roller. Pointer events support mouse and touch.
    const composeOverlayHandle = composeOverlayStage
      ? composeOverlayStage.querySelector('.scroll-roller-top')
      : null;
    if (composeOverlayHandle && composeOverlayStage) {
      let dragState = null;
      composeOverlayHandle.style.touchAction = 'none';
      composeOverlayHandle.style.cursor = 'grab';

      composeOverlayHandle.addEventListener('pointerdown', (event) => {
        if (activeComposerPresentation !== 'overlay' || event.button > 0) return;
        const rect = composeOverlayStage.getBoundingClientRect();
        dragState = {
          pointerId: event.pointerId,
          startX: event.clientX,
          startY: event.clientY,
          left: rect.left,
          top: rect.top,
        };
        composeOverlayHandle.style.cursor = 'grabbing';
        composeOverlayStage.classList.add('is-dragging');
        try { composeOverlayHandle.setPointerCapture(event.pointerId); } catch (_) {}
        event.preventDefault();
      });

      composeOverlayHandle.addEventListener('pointermove', (event) => {
        if (!dragState || dragState.pointerId !== event.pointerId) return;
        const maxLeft = Math.max(0, window.innerWidth - composeOverlayStage.offsetWidth);
        const maxTop = Math.max(0, window.innerHeight - composeOverlayStage.offsetHeight);
        const left = Math.max(0, Math.min(maxLeft, dragState.left + event.clientX - dragState.startX));
        const top = Math.max(0, Math.min(maxTop, dragState.top + event.clientY - dragState.startY));
        composeOverlayStage.style.left = `${left}px`;
        composeOverlayStage.style.top = `${top}px`;
      });

      const endOverlayDrag = (event) => {
        if (!dragState || (event && dragState.pointerId !== event.pointerId)) return;
        dragState = null;
        composeOverlayHandle.style.cursor = 'grab';
        composeOverlayStage.classList.remove('is-dragging');
      };
      composeOverlayHandle.addEventListener('pointerup', endOverlayDrag);
      composeOverlayHandle.addEventListener('pointercancel', endOverlayDrag);
      composeOverlayHandle.addEventListener('lostpointercapture', endOverlayDrag);
    }

    async function openInlineComposer(type, panel, operationId) {
      const slot = getComposerSlot(type);
      if (!slot) return;
      const finishViewport = trackViewportRegion(slot);
      panel.classList.remove('hidden-view');
      slot.style.height = '0px';
      slot.style.overflow = 'hidden';
      void slot.offsetHeight;

      const marginBottom = parseFloat(window.getComputedStyle(panel).marginBottom) || 0;
      const expandedHeight = panel.offsetHeight + marginBottom;
      const slotAnimation = slot.animate(
        [{ height: '0px' }, { height: `${expandedHeight}px` }],
        { duration: composerInlineOpenDuration, easing: 'cubic-bezier(0.33, 1, 0.62, 1)', fill: 'both' }
      );
      const contentAnimation = panel.animate(
        [
          { opacity: 0, transform: 'translateY(-14px)' },
          { opacity: 1, transform: 'translateY(0)' }
        ],
        { duration: composerContentFadeDuration, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' }
      );
      await Promise.all([
        slotAnimation.finished.catch(() => {}),
        contentAnimation.finished.catch(() => {})
      ]);
      if (operationId === composerOperationId) {
        slot.style.height = 'auto';
        slot.style.overflow = 'visible';
        panel.style.opacity = '';
        panel.style.transform = '';
      }
      slotAnimation.cancel();
      contentAnimation.cancel();
      finishViewport();
    }

    function updateComposeModeUI() {
      const buttons = [
        [composeModeOverlayBtn, 'overlay'],
        [composeModeInlineBtn, 'inline'],
        [composeModeMixedBtn, 'mixed'],
      ];
      buttons.forEach(([button, mode]) => {
        if (!button) return;
        const selected = composeMode === mode;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-pressed', String(selected));
      });
      if (composeModeHelp) {
        composeModeHelp.textContent = '(1): Topics and replies use separate scrolls. (2): Both forms open in the main scroll. (M): New topics use a side scroll; replies open in the main scroll. Your choice is remembered on this device.';
      }
    }

    async function openComposer(type, trigger) {
      const panel = getComposerPanel(type);
      if (!panel || composerTransitioning) return;
      if (activeComposerType && activeComposerType !== type) {
        await closeComposer(activeComposerType, { restoreFocus: false, clearFeedback: false });
      }

      activeComposerType = type;
      activeComposerPresentation = composeMode === 'mixed'
        ? (type === 'topic' ? 'overlay' : 'inline')
        : composeMode;
      const operationId = ++composerOperationId;
      lastComposerTrigger = trigger || lastComposerTrigger;
      const anchor = getComposerAnchor(type);

      if (activeComposerPresentation === 'overlay') {
        document.querySelector('header.site-header')?.classList.add('is-hidden');
        // Move the fixed overlay to <body> so the main scroll's transforms/overflow cannot clip it.
        if (composeOverlay && composeOverlay.parentNode !== document.body) {
          document.body.appendChild(composeOverlay);
        }
        if (composeOverlayPaper && panel.parentNode !== composeOverlayPaper) {
          composeOverlayPaper.appendChild(panel);
        }
        panel.classList.remove('hidden-view');
        if (composeOverlay) {
          composeOverlay.classList.remove('hidden-view');
          composeOverlay.setAttribute('aria-hidden', 'false');
        }
        if (composeOverlayStage) {
          composeOverlayStage.setAttribute('aria-hidden', 'false');
          composeOverlayStage.setAttribute('aria-labelledby', getComposerHeadingId(type));
          composeOverlayStage.classList.remove('is-closing');
          composeOverlayStage.style.setProperty('--composer-scroll-unfurl-duration', `${composerOverlayOpenDuration}ms`);
          composeOverlayStage.style.height = '';
          composeOverlayStage.style.opacity = '';
          composeOverlayStage.style.transform = '';
          positionComposeOverlay(lastComposerTrigger);
          composeOverlayStage.style.animation = 'none';
          void composeOverlayStage.offsetHeight;
          composeOverlayStage.style.animation = '';
        }
        if (composeOverlayPaper) {
          composeOverlayPaper.style.animation = 'none';
          void composeOverlayPaper.offsetHeight;
          composeOverlayPaper.style.animation = '';
        }
      } else {
        if (anchor && anchor.parentNode && panel.parentNode !== anchor.parentNode) {
          restoreComposerHome(type);
        }
        if (composeOverlay) {
          composeOverlay.classList.add('hidden-view');
          composeOverlay.setAttribute('aria-hidden', 'true');
        }
        if (composeOverlayStage) composeOverlayStage.setAttribute('aria-hidden', 'true');
        await openInlineComposer(type, panel, operationId);
      }

      if (type === 'topic') {
        if (toggleNewTopicBtn) toggleNewTopicBtn.setAttribute('aria-expanded', 'true');
      } else if (toggleReplyFormBtn) {
        toggleReplyFormBtn.textContent = 'Hide Reply Form';
        toggleReplyFormBtn.setAttribute('aria-expanded', 'true');
      }
      loadSavedIdentity();
      const focusTarget = type === 'topic'
        ? ((!topicAuthorInput || topicAuthorInput.value) ? document.getElementById('topic-title') : topicAuthorInput)
        : replyAuthorInput;
      if (focusTarget) focusTarget.focus({ preventScroll: true });
    }

    async function closeComposer(type, options = {}) {
      const panel = getComposerPanel(type);
      const { restoreFocus = false, clearFeedback = true } = options;
      if (!panel) return;
      if (activeComposerType !== type) {
        panel.classList.add('hidden-view');
        return;
      }
      if (composerTransitioning) return;
      composerTransitioning = true;
      const operationId = ++composerOperationId;
      const presentation = activeComposerPresentation;
      const slot = getComposerSlot(type);
      const finishViewport = presentation === 'inline' ? trackViewportRegion(slot) : () => {};
      const animations = [];
      const closeDuration = presentation === 'overlay' ? composerOverlayCloseDuration : composerInlineCloseDuration;

      if (presentation === 'overlay' && composeOverlay && composeOverlayStage && composeOverlayPaper) {
        document.querySelector('header.site-header')?.classList.remove('is-hidden');
        composeOverlayStage.classList.add('is-closing');
        const paperStyle = window.getComputedStyle(composeOverlayPaper);
        const currentMaxHeight = paperStyle.maxHeight === 'none'
          ? `${composeOverlayPaper.getBoundingClientRect().height}px`
          : paperStyle.maxHeight;
        const currentMinHeight = paperStyle.minHeight;
        const currentHeight = Math.max(composeOverlayStage.getBoundingClientRect().height, 1);
        composeOverlayPaper.style.setProperty('--scroll-furl-from-max-height', currentMaxHeight);
        composeOverlayPaper.style.setProperty('--scroll-furl-from-min-height', currentMinHeight);
        composeOverlayPaper.style.animation = `scrollFurlUp ${closeDuration}ms cubic-bezier(0.4, 0, 0.8, 0.2) forwards`;
        animations.push(composeOverlayStage.animate(
          [
            { height: `${currentHeight}px`, opacity: 1, transform: 'translateY(0)' },
            { height: '0px', opacity: 0, transform: 'translateY(-8px)' }
          ],
          { duration: closeDuration, easing: 'cubic-bezier(0.4, 0, 0.8, 0.2)', fill: 'both' }
        ));
      } else if (slot) {
        const currentHeight = slot.getBoundingClientRect().height || panel.offsetHeight;
        [...slot.getAnimations(), ...panel.getAnimations()].forEach((animation) => animation.cancel());
        slot.style.height = `${currentHeight}px`;
        slot.style.overflow = 'hidden';
        void slot.offsetHeight;
        animations.push(slot.animate(
          [{ height: `${currentHeight}px` }, { height: '0px' }],
          { duration: closeDuration, easing: 'cubic-bezier(0.4, 0, 0.8, 0.2)', fill: 'both' }
        ));
        animations.push(panel.animate(
          [
            { opacity: 1, transform: 'translateY(0)' },
            { opacity: 0, transform: 'translateY(-12px)' }
          ],
          { duration: Math.max(1, closeDuration - 80), easing: 'cubic-bezier(0.4, 0, 0.8, 0.2)', fill: 'both' }
        ));
      }

      await Promise.all(animations.map((animation) => animation.finished.catch(() => {})));
      if (operationId !== composerOperationId) { finishViewport(); return; }
      animations.forEach((animation) => animation.cancel());
      panel.classList.add('hidden-view');
      panel.style.opacity = '';
      panel.style.transform = '';
      if (slot) {
        slot.style.height = '0px';
        slot.style.overflow = 'hidden';
      }
      if (presentation === 'overlay') {
        restoreComposerHome(type);
        if (composeOverlay) {
          composeOverlay.classList.add('hidden-view');
          composeOverlay.setAttribute('aria-hidden', 'true');
        }
        if (composeOverlayStage) {
          composeOverlayStage.classList.remove('is-closing');
          composeOverlayStage.setAttribute('aria-hidden', 'true');
          composeOverlayStage.style.height = '';
          composeOverlayStage.style.opacity = '';
          composeOverlayStage.style.transform = '';
          composeOverlayStage.style.animation = '';
        }
        if (composeOverlayPaper) {
          composeOverlayPaper.style.animation = '';
          composeOverlayPaper.style.removeProperty('--scroll-furl-from-max-height');
          composeOverlayPaper.style.removeProperty('--scroll-furl-from-min-height');
        }
        restoreComposeOverlayHome();
      }

      if (type === 'topic') {
        if (toggleNewTopicBtn) toggleNewTopicBtn.setAttribute('aria-expanded', 'false');
        if (clearFeedback && newTopicFeedback) {
          newTopicFeedback.textContent = '';
          newTopicFeedback.className = 'form-feedback';
        }
      } else if (toggleReplyFormBtn) {
        toggleReplyFormBtn.textContent = 'Reply to This Thread';
        toggleReplyFormBtn.setAttribute('aria-expanded', 'false');
        if (clearFeedback && newReplyFeedback) {
          newReplyFeedback.textContent = '';
          newReplyFeedback.className = 'form-feedback';
        }
      }
      finishViewport();
      activeComposerType = null;
      activeComposerPresentation = null;
      composerTransitioning = false;
      if (restoreFocus && lastComposerTrigger && typeof lastComposerTrigger.focus === 'function') {
        lastComposerTrigger.focus({ preventScroll: true });
      }
    }

