---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/siteConfig.json';
import { getCollection } from 'astro:content';

const allEssays = await getCollection('essays', ({ data }) => !data.draft);
const sortedEssays = allEssays.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recentEssays = sortedEssays.slice(0, 4);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });
---

<BaseLayout title={`${siteConfig.siteTitleJp} | ${siteConfig.siteTitleEn}`} description={siteConfig.tagline}>
  <!-- ══════════════════════════════════════════════════════════════════
       OUTSIDE THE SCROLL: PRE-SCROLL CLIFFHANGER INQUIRY
       Stationary in the document flow, lower z-index than .scroll-stage.
       ══════════════════════════════════════════════════════════════════ -->
  <aside slot="pre-scroll" class="pre-scroll-inquiry-container">
    <div class="pre-scroll-inquiry-inner">
      <div class="inquiry-kicker">
        <span class="ink-kanji">問い</span>
        <span class="kicker-line"></span>
        <span class="inquiry-en">THE UNSETTLED QUESTION</span>
        <span class="kicker-line"></span>
      </div>

      <p class="inquiry-p1">
        What makes you feel <span class="ink-accent-amber">secure</span> in life? 
        Is it your job? Your partner's job? Your family?
      </p>

      <p class="inquiry-p2">
        Are you constantly struggling to <span class="ink-accent-vermilion">protect</span> that source of security, fearing what might happen if it gets <span class="ink-accent-vermilion">taken away</span>?
      </p>

      <p class="inquiry-p3">
        What if your source of security was so <span class="ink-accent-amber">strong</span>, so <span class="ink-accent-amber">deep</span>, so <span class="ink-accent-gold">unshakeable</span>, that you never had to fear? 
        <span class="inquiry-climax">What in this world could such a thing even be?</span>
      </p>

      <div class="pre-scroll-scroll-cue">
        <span class="scroll-cue-symbol">▼</span>
        <span class="scroll-cue-text">OPEN THE SCROLL</span>
      </div>
    </div>
  </aside>

  <!-- ══════════════════════════════════════════════════════════════════
       INSIDE THE SCROLL: THE PILGRIM'S MANIFESTO EXPEDITION
       ══════════════════════════════════════════════════════════════════ -->
  <div class="scroll-title-block">
    <img
      src={siteConfig.crestImage}
      style="width:88px; height:88px; mix-blend-mode:multiply; margin: 0 auto 10px; object-fit:contain;"
      alt="Henro Stamp"
    />
    <div class="scroll-eyebrow">{siteConfig.routeSummary}</div>
    <h1 class="page-heading">{siteConfig.siteTitleEn}</h1>
    <div class="page-subtitle">{siteConfig.tagline}</div>
  </div>

  <div class="page-break">
    <div class="line"></div>
    <div class="kanji">道の哲学 • PHILOSOPHY OF THE ROAD</div>
    <div class="line"></div>
  </div>

  <!-- THE MANIFESTO JOURNEY PRESENTATION -->
  <article class="manifesto-journey">
    
    <!-- EPIGRAPH: THE BOY & THE HAT -->
    <div class="tale-banner">
      <div class="stamp-seal">遍路</div>
      <div class="tale-content">
        <p class="tale-passage">
          A boy and a hat set out on a journey to cross a continent and discover a world where money, jobs and human society are simply another part of Nature.
        </p>
        <div class="zen-break">
          <span class="zen-circle">☯</span>
          <span class="zen-text">We have never left Nature — we've merely forgotten that everything is, inevitably, Nature.</span>
        </div>
        <ul class="destiny-list">
          <li><strong>For the hat:</strong> A homecoming — its very own Odyssey.</li>
          <li><strong>For the boy:</strong> A rite of initiation, and the beginning of a journey into manhood.</li>
        </ul>
      </div>
    </div>

    <!-- EXPEDITION RECORD -->
    <p class="manifesto-paragraph">
      This website follows <strong>Henro’s</strong> journey and insights on his notorious quest for that ultimate source of security. The journey began in <strong>Finisterra, Spain</strong>, and it will continue on foot until the <strong>88th and final temple</strong> of the Shikoku pilgrimage, in Japan.
    </p>

    <!-- THE PHILOSOPHICAL INQUIRY: WHY JAPAN? -->
    <div class="philosophical-journey-section">
      <div class="sub-chapter-title">
        <span class="sub-chapter-num">問答</span>
        <h3>Why Japan?</h3>
      </div>
      
      <div class="journey-reflection">
        <p class="reflection-lead">
          The truth is, this has <em>nothing</em> to do with Japan.
        </p>
        <p class="manifesto-paragraph">
          I wanted to discover my security in the modern world the same way our nomadic ancestors found it in the natural world: 
        </p> 
        <p class="manifesto-paragraph">
          <span class="compass-rose-inline">✦</span> <em>Learning to live within it without being trapped by it.</em>
        </p> 
        <p class="manifesto-paragraph">
          So I chose the longest distance I imagined it was possible to walk at the time: from the <strong>western tip of Europe</strong> to the <strong>eastern tip of Asia</strong>. Japan just happens to be only a boat’s ride away from there.
        </p>
      </div>
    </div>

  </article>

  <div class="page-break">
    <div class="line"></div>
    <div class="kanji">随筆 • READ THE ESSAYS</div>
    <div class="line"></div>
  </div>

  <div>
    {recentEssays.map((essay, idx) => (
      <a href={`/blog/${essay.slug}`} class="stream-item">
        <div class="stream-meta">
          Essay No. {String(sortedEssays.length - idx).padStart(2, '0')}  •  {essay.data.location}  •  {essay.data.readingTime || formatDate(essay.data.date)}
        </div>
        <div class="stream-title">{essay.data.title}</div>
        <div class="stream-excerpt">{essay.data.excerpt}</div>
        <span class="stream-read-link">Unroll Essay Scroll ➔</span>
      </a>
    ))}
  </div>

  <div style="text-align:center; margin-top:36px;">
    <a href="/blog" class="ink-action-btn">
      View Full Essay Archive ➔
    </a>
  </div>

  {siteConfig.features?.enableForumSpotlight && (
    <>
      <div class="page-break">
        <div class="line"></div>
        <div class="kanji">広場 • FROM THE PILGRIM'S COURTYARD</div>
        <div class="line"></div>
      </div>

      <section
        id="home-forum-spotlight"
        class="forum-spotlight-section"
        data-supabase-url={siteConfig.supabase?.url || ''}
        data-supabase-key={siteConfig.supabase?.anonKey || ''}
      >
        <div class="spotlight-header-bar">
          <span class="spotlight-label">COMMUNITY DIALOGUE SPOTLIGHT</span>
        </div>
        <a href="/forum" id="spotlight-thread-card" class="spotlight-thread-card">
          <h3 class="spotlight-title" id="spotlight-title">Forum Under Construction</h3>
        </a>
      </section>
    </>
  )}
</BaseLayout>

<style>
  /* ══════════════════════════════════════════════════════════════════
     PRE-SCROLL INQUIRY (Outside Parchment, directly on dark background)
     ══════════════════════════════════════════════════════════════════ */
/* ══════════════════════════════════════════════════════════════════
     PRE-SCROLL INQUIRY (Outside Parchment, directly on dark background)
     ══════════════════════════════════════════════════════════════════ */
  .pre-scroll-inquiry-container {
    position: relative;
    z-index: 5; /* Below .scroll-stage (z-index: 10) so the scroll unfurls over it */
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 1.5rem;
    box-sizing: border-box;
    text-align: center;
    pointer-events: auto;
    
    /* The Fade-in Animation */
    opacity: 0; /* Start invisible */
    animation: textFadeIn 0.8s ease-out 0.15s forwards;
  }

  @keyframes textFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .inquiry-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 1.25rem;
  }

  .ink-kanji {
    font-family: 'Shippori Mincho', 'Noto Serif JP', serif;
    font-size: 1.1rem;
    color: #dfaa5b;
  }

  .kicker-line {
    width: 32px;
    height: 1px;
    background: rgba(255, 255, 255, 0.25);
  }

  .inquiry-en {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
  }

  .pre-scroll-inquiry-inner p {
    font-family: 'EB Garamond', serif;
    color: #F8F6F0; /* Pure luminous parchment-white */
    line-height: 1.7;
    margin-bottom: 1.2rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.75);
  }

  .inquiry-p1 {
    font-size: 1.35rem;
    font-weight: 500;
  }

  .inquiry-p2 {
    font-size: 1.15rem;
    color: #ECE5D8 !important;
  }

  .inquiry-p3 {
    font-size: 1.25rem;
    line-height: 1.75;
  }

  .inquiry-climax {
    display: block;
    margin-top: 0.5rem;
    font-style: italic;
    color: #ffffff;
    font-size: 1.3rem;
  }

  /* Vibrant Accent Colors */
  .ink-accent-amber {
    color: #F3B352;
    font-weight: 600;
    text-shadow: 0 0 10px rgba(243, 179, 82, 0.35);
  }

  .ink-accent-vermilion {
    color: #EE6A59;
    font-weight: 600;
    text-shadow: 0 0 10px rgba(238, 106, 89, 0.35);
  }

  .ink-accent-gold {
    color: #F9DA7B;
    font-weight: 600;
    text-shadow: 0 0 12px rgba(249, 218, 123, 0.45);
  }

  .pre-scroll-scroll-cue {
    margin-top: 1.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    opacity: 0.75;
  }

  .scroll-cue-symbol {
    font-size: 0.8rem;
    color: #F9DA7B;
    animation: gentleBob 2s infinite ease-in-out;
  }

  .scroll-cue-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.65);
  }

  @keyframes gentleBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* ══════════════════════════════════════════════════════════════════
     INSIDE THE SCROLL (The Emakimono Journey Presentation)
     ══════════════════════════════════════════════════════════════════ */
  .manifesto-journey {
    margin: 1.5rem 0 2.5rem;
    color: #1C1A17;
  }

  .tale-banner {
    position: relative;
    border-left: 3px solid #8C2D19;
    background: linear-gradient(135deg, rgba(140, 45, 25, 0.05) 0%, rgba(205, 178, 137, 0.08) 100%);
    padding: 1.75rem 2rem 1.75rem 2.25rem;
    border-radius: 0 6px 6px 0;
    margin-bottom: 2rem;
  }

  .stamp-seal {
    position: absolute;
    top: -12px;
    right: 18px;
    border: 2px solid #8C2D19;
    color: #8C2D19;
    padding: 2px 6px;
    font-family: 'Shippori Mincho', serif;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 4px;
    opacity: 0.75;
    transform: rotate(3deg);
  }

  .tale-passage {
    font-family: 'EB Garamond', serif;
    font-size: 1.15rem;
    line-height: 1.65;
    color: #24201C;
    margin: 0;
  }

  .zen-break {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 1.25rem 0;
    padding: 0.85rem 1rem;
    background: rgba(28, 26, 23, 0.04);
    border-radius: 4px;
  }

  .zen-circle {
    font-size: 1.3rem;
    color: #2E5A44;
  }

  .zen-text {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 1.05rem;
    color: #38342E;
  }

  .destiny-list {
    font-family: 'EB Garamond', serif;
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 1.25rem 0 0 0;
    padding-left: 1.5rem;
    color: #38342E;
  }

  .destiny-list li {
    margin-bottom: 0.5rem;
  }

  .manifesto-paragraph {
    font-family: 'EB Garamond', serif;
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  /* Philosophical Journey Section */
  .philosophical-journey-section {
    position: relative;
    padding: 1rem 0 0.5rem;
  }

  .sub-chapter-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 0.75rem;
  }

  .sub-chapter-num {
    font-family: 'Shippori Mincho', serif;
    font-size: 0.95rem;
    color: #8C2D19;
    border: 1px solid #8C2D19;
    border-radius: 3px;
    padding: 1px 5px;
  }

  .sub-chapter-title h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
    color: #1C1A17;
  }

  .reflection-lead {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: #8C2D19;
    margin-bottom: 0.5rem;
  }

  .compass-rose-inline {
    color: #B5935A;
    font-size: 1.1rem;
    margin: 0 4px;
    vertical-align: middle;
  }

  @media (max-width: 680px) {
    .pre-scroll-inquiry-container {
      padding: 2rem 1.25rem 1rem;
    }
    .inquiry-p1 { font-size: 1.2rem; }
    .inquiry-p3 { font-size: 1.15rem; }
  }
</style>