---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/siteConfig.json';

const supabaseUrl = siteConfig.supabase?.url?.trim() || "";
const supabaseAnonKey = siteConfig.supabase?.anonKey?.trim() || "";

const categories = [
  "All Topics",
  "Philosophy & Sufficiency",
  "Osettai & Hospitality",
  "Community & Book Initiatives",
  "Notes for the Road"
];
---

<BaseLayout
  title="The Philosophical Forum | CAMINO HENRO"
  description="Community dialogues on material security, Osettai, and the pilgrimage across Eurasia."
>
  <div
    id="forum-root"
    data-supabase-url={supabaseUrl}
    data-supabase-key={supabaseAnonKey}
  >
    <!-- Scroll Title Header Block -->
    <header class="scroll-title-block">
      <div class="scroll-eyebrow">広場 • The Pilgrim's Courtyard</div>
      <h1 class="page-heading">The Philosophical Forum</h1>
      <p class="page-subtitle">
        Community dialogues on material security, Osettai, and the pilgrimage
      </p>
    </header>

    <!-- Ornamental Kanji Divider -->
    <div class="page-break" aria-hidden="true">
      <div class="line"></div>
      <div class="kanji">語</div>
      <div class="line"></div>
    </div>

    <!-- Category Filter Bar + "+ Inscribe New Topic" Action Button -->
    <section class="forum-toolbar" aria-label="Forum Categories and Actions">
      <div class="forum-Toolbar-row">
        <div class="category-filter-bar" role="tablist" aria-label="Filter discussions by category">
          {categories.map((cat, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              data-category={cat}
              class={`ink-action-btn category-filter-btn ${idx === 0 ? "is-active" : ""}`}
            >
              {cat}
            </button>
          ))}
        </div>

        <button
          type="button"
          id="toggle-new-topic-btn"
          class="ink-action-btn crimson-filled-btn"
          aria-expanded="false"
          aria-controls="new-topic-drawer"
        >
          + Inscribe New Topic 印
        </button>
      </div>

      <!-- Status & Mode Indicator Strip -->
      <div class="forum-status-bar">
        <span id="forum-status-indicator" class="forum-status-text">
          {supabaseUrl && supabaseAnonKey
            ? "● Connected to the Open Courtyard Ledger"
            : "○ Local Preview Mode (3 Starter Threads Loaded)"}
        </span>
        <span id="forum-count-indicator" class="forum-count-text">
          Showing All Topics
        </span>
      </div>
    </section>

    <!-- Collapsible "New Discussion Topic" Washi Form -->
    <section
      id="new-topic-drawer"
      class="forum-form-panel hidden-view"
      aria-labelledby="new-topic-heading"
    >
      <div class="forum-form-header">
        <div>
          <span class="forum-form-eyebrow">新規の問い • INSCRIBE A NEW INQUIRY</span>
          <h2 id="new-topic-heading" class="forum-form-title">
            Start a New Discussion Topic
          </h2>
        </div>
        <button
          type="button"
          id="close-new-topic-btn"
          class="ink-action-btn forum-close-btn"
        >
          Close ✕
        </button>
      </div>

      <p class="forum-form-note">
        If you secure your alias with a passcode, it belongs to you. Enter the same passcode next time to post securely.
      </p>

      <form id="new-topic-form" class="washi-form" novalidate>
        <!-- Honeypot field -->
        <div class="honeypot-field" aria-hidden="true">
          <label for="topic-website-url">Website URL (Leave empty)</label>
          <input type="text" id="topic-website-url" name="website_url" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-grid-row">
          <div class="form-field">
            <label for="topic-category">Category *</label>
            <select id="topic-category" name="category" required>
              <option value="Philosophy & Sufficiency">Philosophy &amp; Sufficiency</option>
              <option value="Osettai & Hospitality">Osettai &amp; Hospitality</option>
              <option value="Community & Book Initiatives">Community &amp; Book Initiatives</option>
              <option value="Notes for the Road">Notes for the Road</option>
            </select>
          </div>

          <div class="form-field">
            <label for="topic-author">Your Name or Pilgrim Alias *</label>
            <input
              type="text"
              id="topic-author"
              name="author_name"
              required
              minlength="1"
              maxlength="60"
              placeholder="e.g. Clara (Porto)"
            />
          </div>

          <div class="form-field">
            <label for="topic-passcode">Optional Alias Passcode (Claim or Unlock)</label>
            <input
              type="password"
              id="topic-passcode"
              name="author_passcode"
              placeholder="Set passcode to protect name"
            />
            <span class="field-helper">First time using a name with a passcode claims it.</span>
          </div>
        </div>

        <div class="form-field">
          <label for="topic-email">Optional Email (For Reply Notifications)</label>
          <input
            type="email"
            id="topic-email"
            name="author_email"
            placeholder="Get notified when someone replies (kept 100% private)"
          />
        </div>

        <div class="form-options">
          <label class="checkbox-label">
            <input type="checkbox" id="topic-remember-identity" checked />
            Remember my alias, email & passcode on this device
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="topic-notify-replies" name="notify_replies" checked />
            Notify me by email when someone replies to this thread
          </label>
        </div>

        <div class="form-field">
          <label for="topic-title">Topic Title *</label>
          <input
            type="text"
            id="topic-title"
            name="title"
            required
            minlength="3"
            maxlength="160"
            placeholder="Summarize your philosophical question, story, or initiative..."
          />
        </div>

        <div class="form-field">
          <label for="topic-body">Your Reflection / Question *</label>
          <textarea
            id="topic-body"
            name="body"
            rows="6"
            required
            minlength="5"
            maxlength="5000"
            placeholder="Write your thoughts in full..."
          ></textarea>
        </div>

        <div id="new-topic-feedback" class="form-feedback" role="status" aria-live="polite"></div>

        <div class="form-actions">
          <button type="button" id="cancel-new-topic-btn" class="ink-action-btn">Cancel</button>
          <button type="submit" id="submit-new-topic-btn" class="ink-action-btn crimson-filled-btn">
            Inscribe Topic into Scroll 印
          </button>
        </div>
      </form>
    </section>

    <!-- ================================================================== -->
    <!-- MAIN VIEW 1: THREAD LIST VIEW (#forum-list-view)                   -->
    <!-- ================================================================== -->
    <section id="forum-list-view" aria-label="Discussion Threads">
      <div id="threads-stream-container" class="threads-stream">
        <div class="stream-item loading-placeholder">
          <div class="stream-meta">UNROLLING COURTYARD LEDGER...</div>
          <h3 class="stream-title">Gathering community dialogues...</h3>
          <p class="stream-excerpt">Please wait a moment.</p>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- MAIN VIEW 2: SINGLE THREAD & REPLIES VIEW (#forum-thread-view)     -->
    <!-- ================================================================== -->
    <section
      id="forum-thread-view"
      class="hidden-view"
      aria-label="Selected Discussion Thread and Replies"
    >
      <div class="thread-nav-bar">
        <button type="button" id="back-to-list-btn" class="ink-action-btn">
          ← Back to All Forum Topics
        </button>
      </div>

      <!-- Full Original Topic Article -->
      <article id="active-thread-article" class="active-thread-box">
        <div id="active-thread-meta" class="stream-meta"></div>
        <h2 id="active-thread-title" class="active-thread-heading"></h2>
        <div id="active-thread-body" class="active-thread-prose"></div>
      </article>

      <div class="page-break" aria-hidden="true">
        <div class="line"></div>
        <div class="kanji">響</div>
        <div class="line"></div>
      </div>

      <!-- Chronological Replies Section -->
      <div class="replies-section">
        <div class="replies-header">
          <h3 class="replies-heading">Voices in Response</h3>
          <span id="active-thread-reply-count" class="replies-badge">0 Replies</span>
        </div>
        <div id="replies-list-container" class="replies-list"></div>
      </div>

      <!-- Post a Reply to This Thread Form -->
      <div class="reply-form-box">
        <div class="forum-form-header">
          <div>
            <span class="forum-form-eyebrow">返답 • ADD YOUR VOICE</span>
            <h3 class="forum-form-title">Post a Reply to This Thread</h3>
          </div>
          <span class="kanji-seal">印</span>
        </div>

        <form id="new-reply-form" class="washi-form" novalidate>
          <div class="honeypot-field" aria-hidden="true">
            <label for="reply-website-url">Website URL (Leave empty)</label>
            <input type="text" id="reply-website-url" name="website_url" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-grid-row">
            <div class="form-field">
              <label for="reply-author">Your Name or Pilgrim Alias *</label>
              <input type="text" id="reply-author" name="author_name" required minlength="1" maxlength="60" />
            </div>
            <div class="form-field">
              <label for="reply-passcode">Optional Alias Passcode</label>
              <input type="password" id="reply-passcode" name="author_passcode" placeholder="Protect your name" />
            </div>
          </div>

          <div class="form-field">
            <label for="reply-email">Optional Email (For Reply Notifications)</label>
            <input type="email" id="reply-email" name="author_email" placeholder="Get notified when someone replies" />
          </div>

          <div class="form-options">
            <label class="checkbox-label">
              <input type="checkbox" id="reply-remember-identity" checked />
              Remember my alias, email & passcode on this device
            </label>
            <label class="checkbox-label">
              <input type="checkbox" id="reply-notify-replies" name="notify_replies" checked />
              Notify me by email when someone replies to this thread
            </label>
          </div>

          <div class="form-field">
            <label for="reply-body">Reply Message *</label>
            <textarea id="reply-body" name="body" rows="4" required minlength="2" maxlength="3000" placeholder="Offer your reflection..."></textarea>
          </div>

          <div id="new-reply-feedback" class="form-feedback" role="status" aria-live="polite"></div>

          <div class="form-actions">
            <button type="submit" id="submit-new-reply-btn" class="ink-action-btn crimson-filled-btn">
              Inscribe Reply 印
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- 3-STEP SUPABASE ACTIVATION GUIDE -->
    {(!supabaseUrl || !supabaseAnonKey) && (
      <>
        <div class="page-break" aria-hidden="true">
          <div class="line"></div>
          <div class="kanji">印</div>
          <div class="line"></div>
        </div>

        <aside class="supabase-setup-box" aria-labelledby="supabase-setup-heading">
          <div class="supabase-setup-header">
            <span class="supabase-setup-eyebrow">開門の手引き • COURTYARD DATABASE ACTIVATION</span>
            <span class="supabase-setup-badge">LOCAL DEMO MODE ACTIVE</span>
          </div>
          <h2 id="supabase-setup-heading" class="supabase-setup-title">
            Database & Email Notification Setup
          </h2>
          <p class="supabase-setup-intro">
            You are currently in Preview Mode. To enable real database saving, Anti-Impersonation auth, Admin Badges, and Email notifications:
          </p>
          <ol class="supabase-steps-list">
            <li class="supabase-step-card">
              <div class="supabase-step-num">STEP 01 // SUPABASE & RESEND SETUP</div>
              <p>Run all 3 generated SQL files in your Supabase SQL Editor. Register a free account at resend.com for email notifications.</p>
            </li>
            <li class="supabase-step-card">
              <div class="supabase-step-num">STEP 02 // CONFIGURE siteConfig.json</div>
              <p>Paste your Supabase URL and anon public key into <code>src/data/siteConfig.json</code>.</p>
            </li>
            <li class="supabase-step-card">
              <div class="supabase-step-num">STEP 03 // INSERT RESEND API KEY</div>
              <p>In Supabase Table Editor, open <code>forum_secrets</code> and replace the <code>RESEND_API_KEY</code> value with your real Resend API key.</p>
            </li>
          </ol>
        </aside>
      </>
    )}
  </div>
</BaseLayout>

<style is:global>
  /* Base Colors & Forms (Preserved from Step 8) */
  :root {
    --washi-bg: #E6DFCF;
    --washi-dark: #D8CEB8;
    --ink-sumi: #1C1A17;
    --ink-muted: #5A534A;
    --accent-crimson: #6E2B25;
    --accent-crimson-light: #8C3B33;
    --parchment-light: #F4F1EA;
  }

  .scroll-title-block { text-align: center; padding: 0.5rem 0 1.25rem; }
  .scroll-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent-crimson); margin-bottom: 0.65rem; }
  .page-heading { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.15rem, 4.5vw, 3.1rem); font-weight: 700; color: var(--ink-sumi); line-height: 1.15; margin: 0 0 0.6rem; }
  .page-subtitle { font-family: 'EB Garamond', Georgia, serif; font-style: italic; font-size: 1.15rem; color: var(--ink-muted); max-width: 38rem; margin: 0 auto; line-height: 1.6; }
  .page-break { display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 2rem 0; user-select: none; }
  .page-break .line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent 0%, rgba(110, 43, 37, 0.45) 20%, rgba(110, 43, 37, 0.45) 80%, transparent 100%); }
  .page-break .kanji { font-family: 'Shippori Mincho', serif; font-size: 0.95rem; color: var(--accent-crimson); padding: 0.2rem 0.5rem; border: 1px solid rgba(110, 43, 37, 0.35); background-color: rgba(216, 206, 184, 0.45); line-height: 1; }

  /* Buttons */
  .ink-action-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.55rem 0.95rem; border: 1px solid rgba(28, 26, 23, 0.35); background-color: rgba(216, 206, 184, 0.35); color: var(--ink-sumi); cursor: pointer; transition: all 0.2s ease; }
  .ink-action-btn:hover { border-color: var(--accent-crimson); color: var(--accent-crimson); background-color: rgba(216, 206, 184, 0.75); }
  .ink-action-btn.is-active { border-color: var(--accent-crimson); background-color: var(--washi-dark); color: var(--accent-crimson); font-weight: 600; box-shadow: inset 0 -2px 0 var(--accent-crimson); }
  .ink-action-btn.crimson-filled-btn { background: var(--accent-crimson); color: #F4F1EA; border-color: var(--accent-crimson); font-weight: 500; }
  .ink-action-btn.crimson-filled-btn:hover { background: var(--accent-crimson-light); border-color: var(--accent-crimson-light); }
  .ink-action-btn:disabled { opacity: 0.55; cursor: not-allowed; }

  /* Forms */
  .hidden-view { display: none !important; }
  .honeypot-field { position: absolute; left: -9999px; opacity: 0; pointer-events: none; }
  .forum-form-panel, .reply-form-box { border: 1px solid var(--accent-crimson); background-color: rgba(216, 206, 184, 0.48); padding: 1.5rem; margin-bottom: 2rem; }
  .forum-form-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; padding-bottom: 0.85rem; margin-bottom: 1rem; border-bottom: 1px solid rgba(110, 43, 37, 0.25); }
  .forum-form-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent-crimson); margin-bottom: 0.2rem; display: block; }
  .forum-form-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.6rem; font-weight: 700; color: var(--ink-sumi); margin: 0; }
  .forum-form-note { font-family: 'EB Garamond', Georgia, serif; font-size: 1rem; color: var(--ink-muted); margin: 0 0 1.2rem; }
  .washi-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-grid-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem; }
  .form-field { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-field label { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-sumi); font-weight: 600; }
  .form-field input, .form-field select, .form-field textarea { font-family: 'EB Garamond', Georgia, serif; font-size: 1.05rem; color: var(--ink-sumi); background-color: var(--washi-bg); border: 1px solid rgba(28, 26, 23, 0.3); padding: 0.6rem 0.75rem; outline: none; transition: border-color 0.2s ease; }
  .form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--accent-crimson); }
  .field-helper { font-family: 'EB Garamond', Georgia, serif; font-size: 0.85rem; color: var(--ink-muted); font-style: italic; }
  
  .form-options { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.2rem; }
  .checkbox-label { display: flex; align-items: center; gap: 0.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--ink-sumi); cursor: pointer; }
  
  .form-feedback { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; line-height: 1.4; min-height: 1.2rem; }
  .form-feedback.is-error { color: #8B1E1E; font-weight: 600; }
  .form-feedback.is-success { color: var(--accent-crimson); font-weight: 600; }
  .form-actions { display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 0.4rem; }

  /* Thread Streams */
  .forum-toolbar { margin-bottom: 1.75rem; }
  .forum-Toolbar-row { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(28, 26, 23, 0.16); padding-bottom: 1rem; }
  .category-filter-bar { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .forum-status-bar { display: flex; justify-content: space-between; padding-top: 0.65rem; font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--ink-muted); }
  .forum-status-text { color: var(--accent-crimson); }

  .threads-stream { display: flex; flex-direction: column; }
  .stream-item { padding: 1.6rem 1.25rem; border-bottom: 1px solid rgba(28, 26, 23, 0.15); cursor: pointer; }
  .stream-item:hover { background-color: rgba(216, 206, 184, 0.45); }
  .stream-item.is-pinned-item { border-left: 3px solid var(--accent-crimson); background-color: rgba(216, 206, 184, 0.28); }
  .stream-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem 0.65rem; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 0.55rem; }
  .pinned-stamp { color: var(--accent-crimson); font-weight: 700; border: 1px solid rgba(110, 43, 37, 0.45); background-color: rgba(110, 43, 37, 0.08); padding: 0.1rem 0.4rem; }
  .category-tag { color: var(--ink-sumi); background-color: rgba(216, 206, 184, 0.7); border: 1px solid rgba(28, 26, 23, 0.2); padding: 0.1rem 0.45rem; }
  .reply-count-tag { margin-left: auto; color: var(--accent-crimson); font-weight: 600; }
  .stream-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.55rem; font-weight: 700; color: var(--ink-sumi); margin: 0 0 0.5rem; }
  .stream-excerpt { font-family: 'EB Garamond', Georgia, serif; font-size: 1.08rem; line-height: 1.65; color: var(--ink-muted); margin: 0 0 0.85rem; }
  .stream-read-link { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; text-transform: uppercase; color: var(--accent-crimson); font-weight: 600; }

  /* Thread View */
  .thread-nav-bar { margin-bottom: 1.5rem; }
  .active-thread-box { border: 1px solid rgba(28, 26, 23, 0.25); border-left: 3px solid var(--accent-crimson); background-color: rgba(216, 206, 184, 0.35); padding: 1.75rem; }
  .active-thread-heading { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3.5vw, 2.35rem); font-weight: 700; color: var(--ink-sumi); margin: 0.35rem 0 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(28, 26, 23, 0.15); }
  .active-thread-prose { font-family: 'EB Garamond', Georgia, serif; font-size: 1.15rem; line-height: 1.8; color: var(--ink-sumi); }
  .active-thread-prose p { margin: 0 0 1.1rem; }

  .replies-section { margin-bottom: 2.25rem; }
  .replies-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid rgba(110, 43, 37, 0.35); }
  .replies-heading { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.5rem; font-weight: 700; text-transform: uppercase; color: var(--ink-sumi); margin: 0; }
  .replies-badge { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--accent-crimson); font-weight: 600; }
  .replies-list { display: flex; flex-direction: column; gap: 1rem; }
  .reply-card { border: 1px solid rgba(28, 26, 23, 0.18); background-color: rgba(230, 223, 207, 0.75); padding: 1.25rem 1.4rem; }
  .reply-card-meta { display: flex; justify-content: space-between; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--ink-muted); margin-bottom: 0.65rem; padding-bottom: 0.45rem; border-bottom: 1px dashed rgba(28, 26, 23, 0.15); }
  .reply-card-body { font-family: 'EB Garamond', Georgia, serif; font-size: 1.08rem; line-height: 1.7; color: var(--ink-sumi); }
  .empty-replies-box { border: 1px dashed rgba(28, 26, 23, 0.25); padding: 1.5rem; text-align: center; font-family: 'EB Garamond', Georgia, serif; font-style: italic; color: var(--ink-muted); }

  /* Feature 3: Admin Star Badges */
  .author-badge-admin { background-color: #6E2B25; color: #F4F1EA; padding: 0.1rem 0.45rem; border: 1px solid #D4AF37; font-weight: 700; border-radius: 2px; }
  .admin-seal-tag { color: #D4AF37; font-size: 0.6rem; margin-left: 0.3rem; }
  .author-badge-verified { color: var(--ink-sumi); font-weight: 600; }
  .verified-check { color: #8C3B33; font-weight: bold; margin-left: 0.1rem; }
  .author-badge-guest { color: var(--ink-muted); }
  .is-admin-reply { border-left: 3px solid #6E2B25; background-color: rgba(216, 206, 184, 0.45); }
  
  /* 3-Step Setup */
  .supabase-setup-box { border: 2px solid var(--accent-crimson); background-color: var(--washi-dark); padding: 1.75rem; margin-top: 1rem; }
  .supabase-setup-header { display: flex; justify-content: space-between; padding-bottom: 0.75rem; margin-bottom: 1rem; border-bottom: 1px solid rgba(110, 43, 37, 0.35); font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; }
  .supabase-setup-eyebrow { color: var(--accent-crimson); font-weight: 700; }
  .supabase-setup-badge { background-color: var(--accent-crimson); color: #F4F1EA; padding: 0.15rem 0.5rem; font-size: 0.65rem; }
  .supabase-setup-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.75rem; font-weight: 700; color: var(--ink-sumi); margin: 0 0 0.65rem; }
  .supabase-steps-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .supabase-step-card { border: 1px solid rgba(28, 26, 23, 0.2); background-color: var(--washi-bg); padding: 1rem 1.2rem; }
  .supabase-step-num { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; font-weight: 700; color: var(--accent-crimson); margin-bottom: 0.4rem; }
</style>

<script is:inline>
  (function () {
    const rootEl = document.getElementById('forum-root');
    if (!rootEl) return;

    const rawUrl = (rootEl.getAttribute('data-supabase-url') || '').trim();
    const supabaseUrl = rawUrl.replace(/\/+$/, '');
    const supabaseAnonKey = (rootEl.getAttribute('data-supabase-key') || '').trim();
    const isLiveSupabase = Boolean(supabaseUrl && supabaseAnonKey);

    let allThreads = [];
    let currentCategory = 'All Topics';
    let activeThreadId = null;

    // Feature 2: LocalStorage Identity Memory
    const LOCAL_STORAGE_KEY = 'camino_henro_forum_identity';
    function saveIdentity(name, email, passcode) {
      localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify({ name, email, passcode }));
    }
    function loadIdentity(formIdPrefix) {
      try {
        const stored = localStorage.getItem(LOCAL_STORAGE_KEY);
        if (stored) {
          const { name, email, passcode } = JSON.parse(stored);
          const nameEl = document.getElementById(formIdPrefix + '-author');
          const emailEl = document.getElementById(formIdPrefix + '-email');
          const passEl = document.getElementById(formIdPrefix + '-passcode');
          if (nameEl && name) nameEl.value = name;
          if (emailEl && email) emailEl.value = email;
          if (passEl && passcode) passEl.value = passcode;
        }
      } catch (e) {}
    }

    // Feature 3: Badges Helper
    function escapeHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function renderAuthorBadge(authorName, authorRole) {
      const nameHtml = escapeHtml(authorName);
      if (authorRole === 'admin') {
        return `<span class="author-badge-admin">★ ${nameHtml} <span class="admin-seal-tag">PILGRIM ADMIN 印</span></span>`;
      } else if (authorRole === 'verified') {
        return `<span class="author-badge-verified">${nameHtml} <span class="verified-check" title="Protected Pilgrim Alias">✓</span></span>`;
      }
      return `<span class="author-badge-guest">${nameHtml}</span>`;
    }

    function formatDate(isoString) {
      if (!isoString) return '';
      const d = new Date(isoString);
      if (Number.isNaN(d.getTime())) return isoString;
      return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
    }
    function makeExcerpt(text, maxLen) {
      const clean = String(text || '').replace(/\s+/g, ' ').trim();
      if (clean.length <= maxLen) return clean;
      return clean.slice(0, maxLen).trim() + '…';
    }
    function renderParagraphs(text) {
      const paragraphs = String(text || '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
      return paragraphs.length === 0 ? '<p>' + escapeHtml(text) + '</p>' : paragraphs.map((p) => '<p>' + escapeHtml(p).replace(/\n/g, '<br />') + '</p>').join('');
    }

    // Drawer Toggles
    const toggleNewTopicBtn = document.getElementById('toggle-new-topic-btn');
    const closeNewTopicBtn = document.getElementById('close-new-topic-btn');
    const cancelNewTopicBtn = document.getElementById('cancel-new-topic-btn');
    const newTopicDrawer = document.getElementById('new-topic-drawer');

    function setNewTopicDrawerOpen(isOpen) {
      if (!newTopicDrawer) return;
      if (isOpen) {
        newTopicDrawer.classList.remove('hidden-view');
        loadIdentity('topic');
      } else {
        newTopicDrawer.classList.add('hidden-view');
      }
    }
    if (toggleNewTopicBtn) toggleNewTopicBtn.addEventListener('click', () => setNewTopicDrawerOpen(!newTopicDrawer.classList.contains('hidden-view')));
    if (closeNewTopicBtn) closeNewTopicBtn.addEventListener('click', () => setNewTopicDrawerOpen(false));
    if (cancelNewTopicBtn) cancelNewTopicBtn.addEventListener('click', () => setNewTopicDrawerOpen(false));

    // Fetch Threads (Include author_role)
    async function loadThreads() {
      if (!isLiveSupabase) return;
      try {
        const endpoint = `${supabaseUrl}/rest/v1/forum_threads?select=id,category,title,author_name,author_role,body,is_pinned,reply_count,created_at&order=is_pinned.desc,created_at.desc`;
        const res = await fetch(endpoint, { headers: { apikey: supabaseAnonKey, Authorization: `Bearer ${supabaseAnonKey}` } });
        if (res.ok) {
          const data = await res.json();
          allThreads = Array.isArray(data) ? data : [];
          renderThreadList();
        }
      } catch (err) { console.error('Error loading threads:', err); }
    }

    function renderThreadList() {
      const container = document.getElementById('threads-stream-container');
      if (!container) return;
      const filtered = currentCategory === 'All Topics' ? allThreads : allThreads.filter((t) => t.category === currentCategory);

      if (filtered.length === 0) {
        container.innerHTML = `<div class="stream-item"><h3 class="stream-title">No discussions here yet.</h3></div>`;
        return;
      }

      container.innerHTML = filtered.map(thread => {
        const pinnedBadge = thread.is_pinned ? '<span class="pinned-stamp">[PINNED 印]</span>' : '';
        const authorBadgeHtml = renderAuthorBadge(thread.author_name, thread.author_role);
        return `
          <article class="stream-item ${thread.is_pinned ? 'is-pinned-item' : ''}" data-thread-id="${escapeHtml(thread.id)}">
            <div class="stream-meta">
              ${pinnedBadge} <span class="category-tag">${escapeHtml(thread.category)}</span>
              <span>BY ${authorBadgeHtml}</span> <span>•</span>
              <time datetime="${escapeHtml(thread.created_at)}">${escapeHtml(formatDate(thread.created_at))}</time>
              <span class="reply-count-tag">💬 ${Number(thread.reply_count || 0)} Replies</span>
            </div>
            <h3 class="stream-title">${escapeHtml(thread.title)}</h3>
            <p class="stream-excerpt">${escapeHtml(makeExcerpt(thread.body, 180))}</p>
            <span class="stream-read-link">Unroll Discussion ➔</span>
          </article>
        `;
      }).join('');

      container.querySelectorAll('.stream-item').forEach(item => {
        item.addEventListener('click', () => openThreadView(item.getAttribute('data-thread-id')));
      });
    }

    // Category Tabs
    document.querySelectorAll('.category-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category');
        document.querySelectorAll('.category-filter-btn').forEach(b => b.classList.toggle('is-active', b === btn));
        if (activeThreadId) closeThreadView();
        renderThreadList();
      });
    });

    async function openThreadView(threadId) {
      const thread = allThreads.find(t => String(t.id) === String(threadId));
      if (!thread) return;
      activeThreadId = thread.id;

      const meta = document.getElementById('active-thread-meta');
      if (meta) {
        meta.innerHTML = `
          ${thread.is_pinned ? '<span class="pinned-stamp">[PINNED 印]</span>' : ''}
          <span class="category-tag">${escapeHtml(thread.category)}</span>
          <span>INSCRIBED BY ${renderAuthorBadge(thread.author_name, thread.author_role)}</span>
          <span>•</span> <time>${escapeHtml(formatDate(thread.created_at))}</time>
        `;
      }
      document.getElementById('active-thread-title').textContent = thread.title;
      document.getElementById('active-thread-body').innerHTML = renderParagraphs(thread.body);

      document.getElementById('forum-list-view').classList.add('hidden-view');
      document.getElementById('forum-thread-view').classList.remove('hidden-view');
      loadIdentity('reply');
      await loadRepliesForThread(thread.id);
    }

    function closeThreadView() {
      activeThreadId = null;
      document.getElementById('forum-thread-view').classList.add('hidden-view');
      document.getElementById('forum-list-view').classList.remove('hidden-view');
    }
    const backToListBtn = document.getElementById('back-to-list-btn');
    if (backToListBtn) backToListBtn.addEventListener('click', closeThreadView);

    // Fetch Replies (Include author_role)
    async function loadRepliesForThread(threadId) {
      const container = document.getElementById('replies-list-container');
      if (!isLiveSupabase || !container) return;
      try {
        const endpoint = `${supabaseUrl}/rest/v1/forum_replies?thread_id=eq.${encodeURIComponent(threadId)}&select=id,author_name,author_role,body,created_at&order=created_at.asc`;
        const res = await fetch(endpoint, { headers: { apikey: supabaseAnonKey, Authorization: `Bearer ${supabaseAnonKey}` } });
        if (res.ok) {
          const replies = await res.json();
          document.getElementById('active-thread-reply-count').textContent = `${replies.length} Replies`;
          container.innerHTML = replies.map(r => `
            <div class="reply-card ${r.author_role === 'admin' ? 'is-admin-reply' : ''}">
              <div class="reply-card-meta">
                <span class="reply-author-name">${renderAuthorBadge(r.author_name, r.author_role)}</span>
                <time>${escapeHtml(formatDate(r.created_at))}</time>
              </div>
              <div class="reply-card-body">${renderParagraphs(r.body)}</div>
            </div>
          `).join('');
        }
      } catch(err) { console.error('Error fetching replies:', err); }
    }

    // Submit Forms with Feature 2 Auth + Feature 1 Notifications
    async function handleSubmit(formType, e) {
      e.preventDefault();
      if (!isLiveSupabase) return;

      const hp = document.getElementById(`${formType}-website-url`);
      if (hp && hp.value.trim() !== '') return;

      const btn = document.getElementById(`submit-new-${formType}-btn`);
      const feedback = document.getElementById(`new-${formType}-feedback`);
      const payload = {
        author_name: document.getElementById(`${formType}-author`).value.trim(),
        author_passcode: document.getElementById(`${formType}-passcode`)?.value || null,
        author_email: document.getElementById(`${formType}-email`)?.value.trim() || null,
        notify_replies: document.getElementById(`${formType}-notify-replies`)?.checked || false,
        body: document.getElementById(`${formType}-body`).value.trim(),
      };

      if (formType === 'topic') {
        payload.category = document.getElementById('topic-category').value;
        payload.title = document.getElementById('topic-title').value.trim();
      } else {
        payload.thread_id = activeThreadId;
      }

      // Feature 2: Save to localStorage if checked
      if (document.getElementById(`${formType}-remember-identity`)?.checked) {
        saveIdentity(payload.author_name, payload.author_email || '', payload.author_passcode || '');
      }

      btn.disabled = true;
      btn.textContent = 'Inscribing...';
      feedback.textContent = '';
      feedback.className = 'form-feedback';

      try {
        const table = formType === 'topic' ? 'forum_threads' : 'forum_replies';
        const endpoint = `${supabaseUrl}/rest/v1/${table}`;
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { apikey: supabaseAnonKey, Authorization: `Bearer ${supabaseAnonKey}`, 'Content-Type': 'application/json', Prefer: 'return=representation' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const errText = await res.text();
          if (errText.includes('ALIAS_PROTECTED')) {
            const match = errText.match(/ALIAS_PROTECTED: (.*?)["\n]/);
            throw new Error(match ? match[1] : 'This pilgrim alias is protected. Please enter the correct passcode.');
          }
          throw new Error('Could not inscribe. HTTP ' + res.status);
        }

        document.getElementById(`new-${formType}-form`).reset();
        loadIdentity(formType); // Restore memory immediately if they just cleared the form
        
        if (formType === 'topic') {
          setNewTopicDrawerOpen(false);
          await loadThreads();
        } else {
          await loadRepliesForThread(activeThreadId);
          feedback.textContent = '✓ Reply inscribed.';
          feedback.className = 'form-feedback is-success';
        }
      } catch (err) {
        feedback.textContent = err.message;
        feedback.className = 'form-feedback is-error';
      } finally {
        btn.disabled = false;
        btn.textContent = formType === 'topic' ? 'Inscribe Topic into Scroll 印' : 'Inscribe Reply 印';
      }
    }

    const tForm = document.getElementById('new-topic-form');
    const rForm = document.getElementById('new-reply-form');
    if (tForm) tForm.addEventListener('submit', (e) => handleSubmit('topic', e));
    if (rForm) rForm.addEventListener('submit', (e) => handleSubmit('reply', e));

    loadThreads();
  })();
</script>
