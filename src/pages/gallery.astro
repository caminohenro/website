</style>

<script>
  const appEl = document.getElementById('gallery-app');
  const supabaseUrl = (appEl?.dataset.supabaseUrl || '').replace(/\/+$/, '');
  const supabaseKey = appEl?.dataset.supabaseKey || '';

  // Create clean vintage sepia postcard SVG illustrations for immediate local demo fallback
  function createSepiaPostcardDataUri(title, place, kanji, motifType) {
    let motifSvg = '';
    if (motifType === 'lighthouse') {
      motifSvg = `
        <path d="M90 610 Q280 575 490 605 T900 590 L900 760 L0 760 L0 620 Z" fill="#3a2e25" opacity="0.88"/>
        <rect x="418" y="340" width="54" height="255" fill="#2c221b"/>
        <polygon points="410,340 480,340 465,295 425,295" fill="#6E2B25"/>
        <circle cx="445" cy="316" r="14" fill="#F3E5AB"/>
        <path d="M445 316 L120 210 L120 285 Z" fill="url(#beamGrad)" opacity="0.42"/>
        <path d="M445 316 L820 215 L820 290 Z" fill="url(#beamGrad)" opacity="0.42"/>
        <g transform="translate(275, 515)">
          <polygon points="0,0 38,-22 76,0" fill="#1C1A17"/>
          <line x1="38" y1="0" x2="38" y2="75" stroke="#1C1A17" stroke-width="11" stroke-linecap="round"/>
          <line x1="64" y1="-8" x2="58" y2="78" stroke="#1C1A17" stroke-width="4.5"/>
        </g>
      `;
    } else if (motifType === 'harbor') {
      motifSvg = `
        <path d="M0 520 Q260 485 540 525 T900 500 L900 760 L0 760 Z" fill="#47392e" opacity="0.72"/>
        <path d="M0 610 Q320 590 640 620 T900 605 L900 760 L0 760 Z" fill="#2b221b" opacity="0.92"/>
        <g transform="translate(470, 470)">
          <polygon points="0,0 44,-26 88,0" fill="#1C1A17"/>
          <rect x="28" y="2" width="32" height="58" rx="6" fill="#1C1A17"/>
          <line x1="44" y1="60" x2="36" y2="122" stroke="#1C1A17" stroke-width="8"/>
          <line x1="48" y1="60" x2="58" y2="122" stroke="#1C1A17" stroke-width="8"/>
          <line x1="78" y1="-10" x2="72" y2="124" stroke="#1C1A17" stroke-width="5"/>
        </g>
      `;
    } else {
      motifSvg = `
        <path d="M0 595 L900 595 L900 760 L0 760 Z" fill="#2c231c"/>
        <polygon points="290,595 345,270 400,595" fill="#3d3027"/>
        <polygon points="500,595 555,270 610,595" fill="#3d3027"/>
        <polygon points="390,595 450,330 510,595" fill="#4b3c31"/>
        <g transform="translate(415, 480)">
          <polygon points="0,0 36,-21 72,0" fill="#1C1A17"/>
          <line x1="36" y1="0" x2="36" y2="95" stroke="#1C1A17" stroke-width="12"/>
          <line x1="62" y1="-6" x2="58" y2="96" stroke="#1C1A17" stroke-width="4.5"/>
        </g>
      `;
    }

    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 760" width="900" height="760">
      <defs>
        <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#DFD3BD"/>
          <stop offset="60%" stop-color="#C9B79C"/>
          <stop offset="100%" stop-color="#9F886C"/>
        </linearGradient>
        <linearGradient id="beamGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#F6E8B1" stop-opacity="0.8"/>
          <stop offset="100%" stop-color="#F6E8B1" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <rect width="900" height="760" fill="url(#skyGrad)"/>
      <rect x="28" y="28" width="844" height="704" fill="none" stroke="#5A3E2B" stroke-width="2" opacity="0.55"/>
      <rect x="38" y="38" width="824" height="684" fill="none" stroke="#6E2B25" stroke-width="1" opacity="0.4"/>
      <circle cx="670" cy="210" r="78" fill="#8B261D" opacity="0.72"/>
      ${motifSvg}
      <text x="76" y="118" font-family="Georgia, serif" font-size="56" fill="#6E2B25" opacity="0.32">${kanji}</text>
      <text x="76" y="672" font-family="monospace" font-size="20" letter-spacing="4" fill="#F4EFE6">${place}</text>
      <text x="76" y="702" font-family="Georgia, serif" font-style="italic" font-size="22" fill="#DFD3BD">${title}</text>
    </svg>`;

    return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
  }

  const SAMPLE_DEMO_SIGHTINGS = [
    {
      id: 'demo-finisterra-001',
      photographer_name: 'Elena & Marco (Walkers from Milan)',
      location: 'Cabo Finisterre, Galicia, Spain',
      date_taken: '2025-05-04',
      caption: 'We reached the lighthouse just as the Atlantic fog parted at dusk. A quiet pilgrim in a traditional woven sugegasa hat and white oi-zuru vest stood beside the 0.00 km stone marker looking east toward Eurasia. We shared almonds and hot tea before he began his first steps inland.',
      image_data: createSepiaPostcardDataUri(
        'Dusk at the Zero Kilometre Stone',
        'CABO FINISTERRE • GALICIA',
        '岬',
        'lighthouse'
      ),
      status: 'approved',
      created_at: '2025-05-04T19:30:00Z'
    },
    {
      id: 'demo-cee-002',
      photographer_name: 'Mateo Varela (Hospitalero)',
      location: 'Cee, Galicia, Spain',
      date_taken: '2025-05-05',
      caption: 'Spotted Henro crossing the stone waterfront in Cee early in the morning rain. Most pilgrims walk toward the ocean, so seeing his bamboo staff and sedge hat moving steadily in the opposite direction stopped half the café in its tracks. He stamped his scroll and left a handwritten haiku.',
      image_data: createSepiaPostcardDataUri(
        'Walking East Against the Tide',
        'CEE ESTUARY • GALICIA',
        '湊',
        'harbor'
      ),
      status: 'approved',
      created_at: '2025-05-05T09:15:00Z'
    },
    {
      id: 'demo-santiago-003',
      photographer_name: 'Sora Takahashi',
      location: 'Praza do Obradoiro, Santiago de Compostela',
      date_taken: '2025-05-09',
      caption: 'At sunrise beneath the spires of the Cathedral in Santiago, I noticed the unmistakable silhouette of a Shikoku Henro pilgrim bowing quietly before continuing east toward the Pyrenees. Never imagined I would hear the soft ring of a kongozue staff on Galician cobblestones.',
      image_data: createSepiaPostcardDataUri(
        'Dawn Bow Before the Eastward Road',
        'SANTIAGO DE COMPOSTELA • SPAIN',
        '堂',
        'cathedral'
      ),
      status: 'approved',
      created_at: '2025-05-09T07:45:00Z'
    }
  ];

  // State
  let currentPhotos = [];
  let activeLightboxIndex = 0;
  let compressedDataUrl = '';
  const LOCAL_PENDING_KEY = 'camino_henro_local_pending_photos_v1';
  const LOCAL_APPROVED_KEY = 'camino_henro_local_approved_photos_v1';

  // DOM Elements
  const gridEl = document.getElementById('gallery-grid');
  const emptyStateEl = document.getElementById('gallery-empty-state');
  const countLabelEl = document.getElementById('sightings-count-label');
  const modePillEl = document.getElementById('gallery-mode-pill');

  // Drawer DOM
  const toggleSubmitBtn = document.getElementById('toggle-submit-drawer-btn');
  const closeSubmitBtn = document.getElementById('close-submit-drawer-btn');
  const cancelSubmitBtn = document.getElementById('cancel-submit-btn');
  const submissionDrawer = document.getElementById('photo-submission-drawer');
  const submissionForm = document.getElementById('gallery-submission-form');
  const dateTakenInput = document.getElementById('date_taken');
  const fileInput = document.getElementById('photo_file');
  const compressionStatusEl = document.getElementById('compression-status');
  const previewBoxEl = document.getElementById('photo-preview-box');
  const previewImgEl = document.getElementById('photo-preview-img');
  const feedbackEl = document.getElementById('submission-feedback');
  const submitPhotoBtn = document.getElementById('submit-photo-btn');
  const confirmationBanner = document.getElementById('submission-confirmation-banner');
  const dismissConfirmationBtn = document.getElementById('dismiss-confirmation-btn');

  // Lightbox DOM
  const lightboxEl = document.getElementById('gallery-lightbox');
  if (lightboxEl && lightboxEl.parentElement !== document.body) {
    document.body.appendChild(lightboxEl);
  }
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxLocDate = document.getElementById('lightbox-location-date');
  const lightboxPhotographer = document.getElementById('lightbox-photographer');
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const lightboxPrevBtn = document.getElementById('lightbox-prev-btn');
  const lightboxNextBtn = document.getElementById('lightbox-next-btn');
  const lightboxCloseBtn = document.getElementById('lightbox-close-btn');

  // Admin DOM
  const toggleAdminBtn = document.getElementById('toggle-admin-drawer-btn');
  const closeAdminBtn = document.getElementById('close-admin-drawer-btn');
  const adminDrawer = document.getElementById('admin-moderation-drawer');
  const adminUnlockForm = document.getElementById('admin-unlock-form');
  const adminPasscodeInput = document.getElementById('admin-passcode-input');
  const adminStatusMsg = document.getElementById('admin-status-msg');
  const adminPendingList = document.getElementById('admin-pending-list');

  // Set default date_taken to today
  if (dateTakenInput && !dateTakenInput.value) {
    dateTakenInput.value = new Date().toISOString().split('T')[0];
  }

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatDisplayDate(dateStr) {
    if (!dateStr) return 'Along the Way';
    const parsed = new Date(dateStr + 'T00:00:00');
    if (Number.isNaN(parsed.getTime())) return dateStr;
    return parsed.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  }

  function getLocalApprovedPhotos() {
    try {
      return JSON.parse(localStorage.getItem(LOCAL_APPROVED_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function getLocalPendingPhotos() {
    try {
      return JSON.parse(localStorage.getItem(LOCAL_PENDING_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function saveLocalPendingPhotos(list) {
    try {
      localStorage.setItem(LOCAL_PENDING_KEY, JSON.stringify(list));
    } catch (e) {
      console.warn('Could not save pending photo in localStorage:', e);
    }
  }

  function saveLocalApprovedPhotos(list) {
    try {
      localStorage.setItem(LOCAL_APPROVED_KEY, JSON.stringify(list));
    } catch (e) {
      console.warn('Could not save approved photo in localStorage:', e);
    }
  }

  // ==========================================================================
  // FETCH & RENDER GALLERY GRID
  // ==========================================================================
  async function loadGalleryPhotos() {
    let livePhotos = null;

    if (supabaseUrl && supabaseKey) {
      try {
        const queryUrl =
          `${supabaseUrl}/rest/v1/gallery_submissions?select=id,photographer_name,location,date_taken,caption,image_data,status,created_at&status=eq.approved&order=date_taken.desc,created_at.desc`;
        const res = await fetch(queryUrl, {
          headers: {
            apikey: supabaseKey,
            Authorization: `Bearer ${supabaseKey}`
          }
        });

        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data) && data.length > 0) {
            livePhotos = data;
          }
        }
      } catch (err) {
        console.warn('Supabase gallery fetch fallback triggered:', err);
      }
    }

    if (livePhotos && livePhotos.length > 0) {
      currentPhotos = livePhotos;
      if (modePillEl) modePillEl.hidden = true;
    } else {
      const localApproved = getLocalApprovedPhotos();
      currentPhotos = [...localApproved, ...SAMPLE_DEMO_SIGHTINGS];
      if (modePillEl) modePillEl.hidden = false;
    }

    renderGalleryGrid();
  }

  function renderGalleryGrid() {
    if (!gridEl) return;

    const total = currentPhotos.length;
    if (countLabelEl) {
      countLabelEl.textContent = `${total} ${total === 1 ? 'Sighting' : 'Sightings'} Recorded`;
    }

    if (total === 0) {
      gridEl.innerHTML = '';
      if (emptyStateEl) emptyStateEl.hidden = false;
      return;
    }

    if (emptyStateEl) emptyStateEl.hidden = true;

    gridEl.innerHTML = currentPhotos
      .map((item, idx) => {
        const safeLoc = escapeHtml(item.location);
        const safeName = escapeHtml(item.photographer_name);
        const safeSrc = escapeHtml(item.image_data);
        return `
          <button
            type="button"
            class="gallery-tile"
            data-index="${idx}"
            aria-label="View sighting from ${safeLoc} captured by ${safeName}"
          >
            <img
              src="${safeSrc}"
              alt="Sighting of Henro in ${safeLoc} by ${safeName}"
              loading="lazy"
            />
            <div class="gallery-tile-overlay">
              <div class="tile-location">${safeLoc}</div>
              <div class="tile-photographer">by ${safeName}</div>
            </div>
          </button>
        `;
      })
      .join('');

    gridEl.querySelectorAll('.gallery-tile').forEach((tile) => {
      tile.addEventListener('click', () => {
        const idx = Number(tile.getAttribute('data-index') || '0');
        openLightbox(idx);
      });
    });
  }

  // ==========================================================================
  // LIGHTBOX MODAL WITH SMOOTH ENLARGEMENT ANIMATION
  // ==========================================================================
  function updateLightboxContent() {
    const item = currentPhotos[activeLightboxIndex];
    if (!item || !lightboxEl) return;

    if (lightboxImg) {
      lightboxImg.src = item.image_data;
      lightboxImg.alt = `Sighting of Henro in ${item.location} captured by ${item.photographer_name}`;
    }
    if (lightboxLocDate) {
      lightboxLocDate.textContent = `${item.location} • ${formatDisplayDate(item.date_taken)}`;
    }
    if (lightboxPhotographer) {
      lightboxPhotographer.textContent = `Captured by ${item.photographer_name}`;
    }
    if (lightboxCaption) {
      lightboxCaption.textContent = item.caption || 'Recorded along the Camino Henro trail.';
    }
    if (lightboxCounter) {
      lightboxCounter.textContent = `${activeLightboxIndex + 1} / ${currentPhotos.length}`;
    }
  }

  function openLightbox(index) {
    if (!lightboxEl || currentPhotos.length === 0) return;
    activeLightboxIndex = (index + currentPhotos.length) % currentPhotos.length;
    updateLightboxContent();

    lightboxEl.hidden = false;
    document.body.style.overflow = 'hidden';

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        lightboxEl.classList.add('is-open');
      });
    });
  }

  function closeLightbox() {
    if (!lightboxEl || lightboxEl.hidden) return;
    lightboxEl.classList.remove('is-open');
    document.body.style.overflow = '';

    setTimeout(() => {
      lightboxEl.hidden = true;
    }, 280);
  }

  function stepLightbox(delta) {
    if (currentPhotos.length === 0) return;
    activeLightboxIndex = (activeLightboxIndex + delta + currentPhotos.length) % currentPhotos.length;
    updateLightboxContent();
  }

  lightboxPrevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    stepLightbox(-1);
  });

  lightboxNextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    stepLightbox(1);
  });

  lightboxCloseBtn?.addEventListener('click', closeLightbox);

  lightboxEl?.addEventListener('click', (e) => {
    if (e.target === lightboxEl) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (!lightboxEl || lightboxEl.hidden) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') stepLightbox(-1);
    if (e.key === 'ArrowRight') stepLightbox(1);
  });

  // ==========================================================================
  // CLIENT-SIDE HTML5 CANVAS AUTO-COMPRESSOR (~120KB JPEG)
  // ==========================================================================
  function compressImageFileToDataUrl(file, maxDimension = 1280, quality = 0.80) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onerror = () => reject(new Error('Could not read the selected image file.'));
      reader.onload = (event) => {
        const img = new Image();
        img.onerror = () => reject(new Error('Selected file is not a valid photograph.'));
        img.onload = () => {
          let width = img.naturalWidth || img.width;
          let height = img.naturalHeight || img.height;

          if (width > maxDimension || height > maxDimension) {
            if (width >= height) {
              height = Math.round((height * maxDimension) / width);
              width = maxDimension;
            } else {
              width = Math.round((width * maxDimension) / height);
              height = maxDimension;
            }
          }

          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            reject(new Error('Browser canvas context unavailable.'));
            return;
          }

          ctx.fillStyle = '#E6DFCF';
          ctx.fillRect(0, 0, width, height);
          ctx.drawImage(img, 0, 0, width, height);

          const dataUrl = canvas.toDataURL('image/jpeg', quality);
          const approxKb = Math.round((dataUrl.length * 3) / 4 / 1024);
          resolve({ dataUrl, width, height, approxKb });
        };
        img.src = String(event.target?.result || '');
      };
      reader.readAsDataURL(file);
    });
  }

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) {
      compressedDataUrl = '';
      if (previewBoxEl) previewBoxEl.hidden = true;
      return;
    }

    if (compressionStatusEl) {
      compressionStatusEl.textContent = 'Preparing & compressing photograph on canvas...';
    }

    try {
      const result = await compressImageFileToDataUrl(file, 1280, 0.80);
      compressedDataUrl = result.dataUrl;

      if (previewImgEl) {
        previewImgEl.src = compressedDataUrl;
      }
      if (previewBoxEl) {
        previewBoxEl.hidden = false;
      }
      if (compressionStatusEl) {
        compressionStatusEl.textContent =
          `Ready to upload: ${result.width}×${result.height}px compressed JPEG (~${result.approxKb} KB).`;
      }
    } catch (err) {
      compressedDataUrl = '';
      if (previewBoxEl) previewBoxEl.hidden = true;
      if (compressionStatusEl) {
        compressionStatusEl.textContent = err.message || 'Could not process selected photo.';
      }
    }
  });

  // ==========================================================================
  // SUBMISSION DRAWER TOGGLE & FORM POST
  // ==========================================================================
  function setSubmissionDrawerOpen(isOpen) {
    if (!submissionDrawer || !toggleSubmitBtn) return;
    submissionDrawer.hidden = !isOpen;
    toggleSubmitBtn.setAttribute('aria-expanded', String(isOpen));
  }

  toggleSubmitBtn?.addEventListener('click', () => {
    const isCurrentlyHidden = submissionDrawer?.hidden;
    setSubmissionDrawerOpen(Boolean(isCurrentlyHidden));
  });

  closeSubmitBtn?.addEventListener('click', () => setSubmissionDrawerOpen(false));
  cancelSubmitBtn?.addEventListener('click', () => setSubmissionDrawerOpen(false));

  dismissConfirmationBtn?.addEventListener('click', () => {
    if (confirmationBanner) confirmationBanner.hidden = true;
  });

  function showFormFeedback(message) {
    if (!feedbackEl) return;
    feedbackEl.textContent = message;
    feedbackEl.hidden = !message;
  }

  submissionForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    showFormFeedback('');

    const formData = new FormData(submissionForm);
    const honeypot = String(formData.get('website_url') || '').trim();
    if (honeypot) return;

    const photographer_name = String(formData.get('photographer_name') || '').trim();
    const photographer_email = String(formData.get('photographer_email') || '').trim();
    const location = String(formData.get('location') || '').trim();
    const date_taken = String(formData.get('date_taken') || '').trim() || new Date().toISOString().split('T')[0];
    const caption = String(formData.get('caption') || '').trim();

    if (!photographer_name) {
      showFormFeedback('Please enter your name or trail alias.');
      return;
    }
    if (location.length < 2) {
      showFormFeedback('Please enter the location where you crossed paths with Henro.');
      return;
    }
    if (!compressedDataUrl) {
      showFormFeedback('Please select a photograph of Henro to upload.');
      return;
    }

    if (submitPhotoBtn) submitPhotoBtn.disabled = true;

    const payload = {
      photographer_name,
      photographer_email: photographer_email || null,
      location,
      date_taken,
      caption: caption || null,
      image_data: compressedDataUrl,
      status: 'pending'
    };

    try {
      let savedRemotely = false;

      if (supabaseUrl && supabaseKey) {
        const res = await fetch(`${supabaseUrl}/rest/v1/gallery_submissions`, {
          method: 'POST',
          headers: {
            apikey: supabaseKey,
            Authorization: `Bearer ${supabaseKey}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal'
          },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          savedRemotely = true;
        } else {
          const errText = await res.text();
          console.warn('Supabase POST returned non-OK, storing in local waiting ledger:', errText);
        }
      }

      if (!savedRemotely) {
        const localPending = getLocalPendingPhotos();
        localPending.unshift({
          id: 'local-' + Date.now(),
          ...payload,
          created_at: new Date().toISOString()
        });
        saveLocalPendingPhotos(localPending);
      }

      submissionForm.reset();
      if (dateTakenInput) {
        dateTakenInput.value = new Date().toISOString().split('T')[0];
      }
      compressedDataUrl = '';
      if (previewBoxEl) previewBoxEl.hidden = true;
      if (compressionStatusEl) {
        compressionStatusEl.textContent =
          'Select any photo from your phone or camera. It will be automatically resized to 1280px JPEG (~120KB) for reliable trail-side upload.';
      }

      setSubmissionDrawerOpen(false);
      if (confirmationBanner) {
        confirmationBanner.hidden = false;
        confirmationBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch (err) {
      showFormFeedback(err.message || 'An error occurred while submitting your photograph.');
    } finally {
      if (submitPhotoBtn) submitPhotoBtn.disabled = false;
    }
  });

  // ==========================================================================
  // INLINE PILGRIM ADMIN MODERATION DRAWER
  // ==========================================================================
  toggleAdminBtn?.addEventListener('click', () => {
    if (!adminDrawer) return;
    adminDrawer.hidden = !adminDrawer.hidden;
  });

  closeAdminBtn?.addEventListener('click', () => {
    if (adminDrawer) adminDrawer.hidden = true;
  });

  function setAdminStatus(msg) {
    if (!adminStatusMsg) return;
    adminStatusMsg.textContent = msg;
    adminStatusMsg.hidden = !msg;
  }

  async function fetchAndRenderPendingSubmissions(passcode) {
    if (!adminPendingList) return;
    setAdminStatus('Checking waiting ledger...');
    adminPendingList.innerHTML = '';

    let pendingItems = [];
    let usedSupabaseRpc = false;

    if (supabaseUrl && supabaseKey) {
      try {
        const res = await fetch(`${supabaseUrl}/rest/v1/rpc/admin_list_pending_photos`, {
          method: 'POST',
          headers: {
            apikey: supabaseKey,
            Authorization: `Bearer ${supabaseKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ p_admin_passcode: passcode })
        });

        if (res.ok) {
          pendingItems = await res.json();
          usedSupabaseRpc = true;
        } else {
          const errJson = await res.json().catch(() => ({}));
          if (errJson?.message?.toLowerCase().includes('passcode')) {
            setAdminStatus('Invalid Admin Passcode.');
            return;
          }
        }
      } catch (err) {
        console.warn('Admin RPC fallback to local waiting ledger:', err);
      }
    }

    if (!usedSupabaseRpc) {
      if (passcode !== 'henro') {
        setAdminStatus('Invalid Admin Passcode (use "henro" in local demo mode).');
        return;
      }
      pendingItems = getLocalPendingPhotos();
    }

    if (!Array.isArray(pendingItems) || pendingItems.length === 0) {
      setAdminStatus('No pending photo submissions waiting for review.');
      return;
    }

    setAdminStatus(`Found ${pendingItems.length} pending ${pendingItems.length === 1 ? 'submission' : 'submissions'} awaiting moderation.`);

    adminPendingList.innerHTML = pendingItems
      .map((item) => {
        const safeId = escapeHtml(item.id);
        const safeLoc = escapeHtml(item.location);
        const safeName = escapeHtml(item.photographer_name);
        const safeEmail = item.photographer_email ? ` • ${escapeHtml(item.photographer_email)}` : '';
        const safeDate = escapeHtml(formatDisplayDate(item.date_taken));
        const safeCaption = escapeHtml(item.caption || 'No story attached.');
        const safeSrc = escapeHtml(item.image_data);

        return `
          <div class="pending-card" data-photo-id="${safeId}">
            <img class="pending-thumb" src="${safeSrc}" alt="Pending submission from ${safeLoc}" />
            <div class="pending-meta">
              <h4>${safeLoc}</h4>
              <div class="pending-sub">By ${safeName}${safeEmail} • ${safeDate}</div>
              <p class="pending-caption">${safeCaption}</p>
            </div>
            <div class="pending-actions">
              <button type="button" class="approve-btn" data-action="approved" data-id="${safeId}">
                [Approve &amp; Publish 印]
              </button>
              <button type="button" class="delete-btn" data-action="delete" data-id="${safeId}">
                [Delete ✕]
              </button>
            </div>
          </div>
        `;
      })
      .join('');

    adminPendingList.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const photoId = btn.getAttribute('data-id') || '';
        const action = btn.getAttribute('data-action') || '';
        await moderatePhotoSubmission(passcode, photoId, action, usedSupabaseRpc);
      });
    });
  }

  async function moderatePhotoSubmission(passcode, photoId, newStatus, useRemoteRpc) {
    setAdminStatus(`Processing ${newStatus === 'approved' ? 'approval' : 'deletion'}...`);

    if (useRemoteRpc && supabaseUrl && supabaseKey) {
      try {
        const res = await fetch(`${supabaseUrl}/rest/v1/rpc/admin_moderate_photo`, {
          method: 'POST',
          headers: {
            apikey: supabaseKey,
            Authorization: `Bearer ${supabaseKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            p_admin_passcode: passcode,
            p_photo_id: photoId,
            p_new_status: newStatus
          })
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          setAdminStatus(errData.message || 'Moderation action failed.');
          return;
        }
      } catch (err) {
        setAdminStatus(err.message || 'Network error during moderation.');
        return;
      }
    } else {
      const pending = getLocalPendingPhotos();
      const target = pending.find((p) => String(p.id) === String(photoId));
      const remaining = pending.filter((p) => String(p.id) !== String(photoId));
      saveLocalPendingPhotos(remaining);

      if (newStatus === 'approved' && target) {
        const approved = getLocalApprovedPhotos();
        approved.unshift({ ...target, status: 'approved' });
        saveLocalApprovedPhotos(approved);
      }
    }

    await fetchAndRenderPendingSubmissions(passcode);
    await loadGalleryPhotos();
  }

  adminUnlockForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const passcode = String(adminPasscodeInput?.value || '').trim();
    if (!passcode) {
      setAdminStatus('Please enter your Admin Passcode.');
      return;
    }
    await fetchAndRenderPendingSubmissions(passcode);
  });

  // Initial load
  loadGalleryPhotos();
</script>
